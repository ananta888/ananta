{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/performance_comparison_artifact.v1.schema.json",
  "title": "PerformanceComparisonArtifact v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "comparison_id",
    "baseline_run_id",
    "candidate_run_id",
    "metric_deltas",
    "confidence",
    "noise_estimate",
    "pass_fail",
    "reason_code",
    "caveats"
  ],
  "properties": {
    "schema": { "const": "performance_comparison_artifact.v1" },
    "comparison_id": { "type": "string", "minLength": 1 },
    "baseline_run_id": { "type": "string", "minLength": 1 },
    "candidate_run_id": { "type": "string", "minLength": 1 },
    "metric_deltas": { "type": "object" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "noise_estimate": { "type": "object" },
    "pass_fail": { "enum": ["passed", "rejected", "inconclusive", "blocked", "failed"] },
    "reason_code": { "type": "string", "minLength": 1 },
    "code_delta": { "type": "object" },
    "config_delta": { "type": "object" },
    "data_delta": { "type": "object" },
    "hardware_delta": { "type": "object" },
    "caveats": { "type": "array", "items": { "type": "string" } }
  }
}
