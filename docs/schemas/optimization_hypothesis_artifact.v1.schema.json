{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/optimization_hypothesis_artifact.v1.schema.json",
  "title": "OptimizationHypothesisArtifact v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "hypothesis_id",
    "hotspot_refs",
    "suspected_bottleneck",
    "expected_effect",
    "affected_files",
    "risk",
    "required_measurements",
    "falsification_criteria"
  ],
  "properties": {
    "schema": { "const": "optimization_hypothesis_artifact.v1" },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "hotspot_refs": { "type": "array", "minItems": 1 },
    "suspected_bottleneck": {
      "enum": ["compute_bound", "memory_bound", "io_bound", "bus_bound", "allocation_bound", "algorithmic", "concurrency", "config_only", "unknown"]
    },
    "expected_effect": { "type": "string", "minLength": 1 },
    "affected_files": { "type": "array" },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "required_measurements": { "type": "array", "minItems": 1 },
    "falsification_criteria": { "type": "array", "minItems": 1 }
  }
}
