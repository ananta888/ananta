{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/contracts/unsloth-storage-cleanup-task.v1.schema.json",
  "title": "Ananta Unsloth Storage Cleanup Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "tenant_scope_digest",
    "catalog_revision",
    "plan_sha256",
    "reason_sha256",
    "artifacts"
  ],
  "properties": {
    "contract_version": {
      "const": "ananta.unsloth-storage-cleanup-task.v1"
    },
    "task_id": {"$ref": "#/$defs/identifier"},
    "tenant_scope_digest": {"$ref": "#/$defs/sha256"},
    "catalog_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "reason_sha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\\\\\u0000]+$",
      "not": {
        "anyOf": [
          {"pattern": "^/"},
          {"pattern": "(^|/)\\.\\.(/|$)"},
          {"pattern": "(^|/)\\.(/|$)"},
          {"pattern": "//"}
        ]
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "relative_ref",
        "job_id",
        "attempt_id",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["workspace", "checkpoint", "export"]},
        "relative_ref": {"$ref": "#/$defs/relativeRef"},
        "job_id": {"$ref": "#/$defs/identifier"},
        "attempt_id": {"$ref": "#/$defs/identifier"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    }
  }
}
