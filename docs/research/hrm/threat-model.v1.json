{
  "schema": "ananta.hrm-threat-model.v1",
  "default_disposition": "deny",
  "trust_boundaries": [
    "user_or_hub_client_to_hub_api",
    "hub_policy_and_queue_to_worker_assignment",
    "worker_transport_to_hrm_worker_container",
    "container_to_process_group_and_gpu",
    "worker_to_dataset_checkpoint_and_result_storage",
    "hub_approved_egress_to_external_destination",
    "hub_api_to_angular_visual_process_tui_and_cli"
  ],
  "forbidden_control_paths": [
    "worker_to_worker_orchestration",
    "worker_owned_queue_or_routing",
    "hub_local_untrusted_ml_process",
    "client_supplied_worker_url_or_server_path",
    "manifest_selected_python_entry_point"
  ],
  "risks": [
    {
      "id": "HRM-THREAT-001",
      "scenario": "checkpoint_rce_or_unsafe_deserialization",
      "asset": "hub, worker and tenant data",
      "actor": "malicious artifact publisher",
      "entry_point": "checkpoint import or evaluation",
      "prerequisites": "untrusted checkpoint reaches a permissive loader",
      "impact": "code execution and data compromise",
      "likelihood": "high",
      "severity": "critical",
      "control_owner": "hub artifact admission",
      "control": "safetensors-only allowlist, pre-parse digest and header checks, bounded tensor metadata; reject torch.load and custom classes",
      "verification_gate": "HRM-GATE-SEC-CHECKPOINT",
      "disposition": "deny"
    },
    {
      "id": "HRM-THREAT-002",
      "scenario": "dataset_or_plugin_code_execution",
      "asset": "worker runtime and supply chain",
      "actor": "malicious dataset author",
      "entry_point": "manifest plugin identifiers",
      "prerequisites": "dynamic import or entry point selected from data",
      "impact": "arbitrary code execution",
      "likelihood": "medium",
      "severity": "critical",
      "control_owner": "hub plugin registry",
      "control": "build-time signed plugin registry; manifests cannot name modules, commands or entry points",
      "verification_gate": "HRM-GATE-SEC-PLUGIN",
      "disposition": "deny"
    },
    {
      "id": "HRM-THREAT-003",
      "scenario": "ssrf_redirect_or_dns_rebinding",
      "asset": "private services and metadata endpoints",
      "actor": "authorized importer with hostile URL",
      "entry_point": "dataset, model or checkpoint fetch",
      "prerequisites": "network-enabled import",
      "impact": "internal data access or credential theft",
      "likelihood": "high",
      "severity": "critical",
      "control_owner": "hub egress gateway",
      "control": "default-deny HTTPS destinations, per-hop validation, connect-time IP pinning, proxy bypass disabled and bounded streaming",
      "verification_gate": "HRM-GATE-SEC-SSRF",
      "disposition": "mitigate"
    },
    {
      "id": "HRM-THREAT-004",
      "scenario": "archive_bomb_traversal_or_link_escape",
      "asset": "worker filesystem and storage quota",
      "actor": "malicious artifact publisher",
      "entry_point": "archive import",
      "prerequisites": "archive extraction",
      "impact": "overwrite, exhaustion or host escape",
      "likelihood": "high",
      "severity": "high",
      "control_owner": "artifact security service",
      "control": "file, byte, ratio, depth and path bounds; reject links, devices, duplicates, sparse and encrypted entries",
      "verification_gate": "HRM-GATE-SEC-ARCHIVE",
      "disposition": "mitigate"
    },
    {
      "id": "HRM-THREAT-005",
      "scenario": "tenant_or_path_escape",
      "asset": "cross-tenant datasets, checkpoints and reports",
      "actor": "tenant user or compromised worker",
      "entry_point": "object identifier or storage reference",
      "prerequisites": "missing authoritative scope check",
      "impact": "cross-tenant disclosure or mutation",
      "likelihood": "medium",
      "severity": "critical",
      "control_owner": "hub authorization and storage ports",
      "control": "hub-resolved tenant/project scope, realpath containment, no-follow writes, immutable content addresses and reference-aware deletion",
      "verification_gate": "HRM-GATE-SEC-TENANT",
      "disposition": "mitigate"
    },
    {
      "id": "HRM-THREAT-006",
      "scenario": "idor_or_existence_leak",
      "asset": "object metadata and event history",
      "actor": "authenticated foreign tenant",
      "entry_point": "list, detail, cursor or export API",
      "prerequisites": "identifier accepted before scope resolution",
      "impact": "data or existence disclosure",
      "likelihood": "medium",
      "severity": "high",
      "control_owner": "hub API",
      "control": "scope-first lookup with indistinguishable not-found behavior and no side effects",
      "verification_gate": "HRM-GATE-SEC-IDOR",
      "disposition": "mitigate"
    },
    {
      "id": "HRM-THREAT-007",
      "scenario": "cancel_result_retry_race",
      "asset": "authoritative run state and capacity",
      "actor": "stale or duplicated worker",
      "entry_point": "result, event, checkpoint or cancel ingress",
      "prerequisites": "concurrent terminal transitions",
      "impact": "stale result promotion or leaked capacity",
      "likelihood": "high",
      "severity": "critical",
      "control_owner": "hub transaction and reconciler",
      "control": "assignment, lease, attempt and epoch fencing; digest-idempotent retry; one atomic terminal winner",
      "verification_gate": "HRM-GATE-RACE",
      "disposition": "mitigate"
    },
    {
      "id": "HRM-THREAT-008",
      "scenario": "stale_ingress_after_revocation",
      "asset": "events, logs, artifacts and checkpoints",
      "actor": "expired worker assignment",
      "entry_point": "worker callback",
      "prerequisites": "revoked or expired lease",
      "impact": "post-revocation writes",
      "likelihood": "medium",
      "severity": "high",
      "control_owner": "hub result admission",
      "control": "re-read current authority and reject stale epoch before persistence",
      "verification_gate": "HRM-GATE-STALE-INGRESS",
      "disposition": "mitigate"
    },
    {
      "id": "HRM-THREAT-009",
      "scenario": "secret_or_data_egress_leak",
      "asset": "credentials and private samples",
      "actor": "telemetry, provider or log consumer",
      "entry_point": "W&B, remote LLM, logs or crash output",
      "prerequisites": "unbounded payload or inherited environment",
      "impact": "credential and tenant data disclosure",
      "likelihood": "high",
      "severity": "critical",
      "control_owner": "hub egress and worker redaction",
      "control": "secret handles, field-level allowlists, consent binding, bounded redaction and default-disabled telemetry",
      "verification_gate": "HRM-GATE-SEC-EGRESS",
      "disposition": "deny"
    },
    {
      "id": "HRM-THREAT-010",
      "scenario": "supply_chain_tampering",
      "asset": "worker image and model behavior",
      "actor": "compromised registry or dependency",
      "entry_point": "build dependency, base image or gitlink",
      "prerequisites": "mutable or unsigned input",
      "impact": "runtime compromise",
      "likelihood": "medium",
      "severity": "critical",
      "control_owner": "build and release pipeline",
      "control": "digest locks, offline build, SBOM, signature, provenance attestation, vulnerability and license gates",
      "verification_gate": "HRM-GATE-SUPPLY-CHAIN",
      "disposition": "deny"
    },
    {
      "id": "HRM-THREAT-011",
      "scenario": "resource_exhaustion",
      "asset": "tenant fairness and hub availability",
      "actor": "malicious or defective run",
      "entry_point": "run request, output, events or download",
      "prerequisites": "soft or user-controlled limits",
      "impact": "denial of service",
      "likelihood": "high",
      "severity": "high",
      "control_owner": "hub admission and worker cgroup",
      "control": "server maxima, atomic reservations, cgroup/process limits, bounded artifacts and retry budgets",
      "verification_gate": "HRM-GATE-RESOURCE",
      "disposition": "mitigate"
    },
    {
      "id": "HRM-THREAT-012",
      "scenario": "unenforced_gpu_isolation",
      "asset": "GPU capacity and co-tenant confidentiality",
      "actor": "misconfigured or hostile run",
      "entry_point": "device assignment",
      "prerequisites": "shared device without enforceable reservation",
      "impact": "cross-run interference or exhaustion",
      "likelihood": "medium",
      "severity": "high",
      "control_owner": "hub scheduler and container runtime",
      "control": "exclusive device reservation or stable admission deny; no best-effort VRAM promise",
      "verification_gate": "HRM-GATE-GPU-ISOLATION",
      "disposition": "conditional"
    }
  ]
}
