{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/knowledge_hygiene/knowledge_claim.v1.json",
  "title": "KnowledgeClaim v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "project_id",
    "revision",
    "subject",
    "predicate",
    "value",
    "source_id",
    "source_revision",
    "source_locator",
    "source_content_sha256",
    "extraction_run_id",
    "scope",
    "assertion_kind",
    "confidence",
    "coverage",
    "created_at",
    "supersedes_claim_refs"
  ],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^KCL_[0-9a-f]{24}$"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "revision": {"type": "integer", "minimum": 1},
    "subject": {"type": "string", "minLength": 1, "maxLength": 1000},
    "predicate": {"type": "string", "minLength": 1, "maxLength": 500},
    "value": {"type": ["string", "number", "integer", "boolean", "object", "array", "null"]},
    "source_id": {"type": "string", "pattern": "^(SRC|RUN)_[0-9]{4}$"},
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 500},
    "source_locator": {"type": "string", "minLength": 1, "maxLength": 4096},
    "source_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extraction_run_id": {"type": "string", "pattern": "^RUN_[0-9]{4}$"},
    "scope": {"type": "string", "minLength": 1, "maxLength": 500},
    "unit": {"type": ["string", "null"], "maxLength": 100},
    "status": {"type": ["string", "null"], "maxLength": 100},
    "assertion_kind": {"enum": ["actual", "target", "estimate", "hypothesis"]},
    "effective_from": {"type": ["string", "null"], "maxLength": 100},
    "effective_to": {"type": ["string", "null"], "maxLength": 100},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "coverage": {"enum": ["complete", "partial", "unknown"]},
    "created_at": {"type": "number", "minimum": 0},
    "supersedes_claim_refs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "minLength": 1, "maxLength": 200},
          {"type": "integer", "minimum": 1}
        ],
        "items": false
      }
    }
  }
}
