{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/knowledge_hygiene/knowledge_conflict_decision.v1.json",
  "title": "KnowledgeConflictDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "conflict_id",
    "project_id",
    "expected_conflict_version",
    "actor_id",
    "actor_kind",
    "decision",
    "rationale",
    "qualifiers",
    "basis_digest",
    "created_at",
    "writeback_requested",
    "second_approver_id"
  ],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "conflict_id": {"type": "string", "pattern": "^KHC_[0-9a-f]{24}$"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "expected_conflict_version": {"type": "integer", "minimum": 1},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "actor_kind": {"const": "human"},
    "decision": {"enum": ["keep_left", "keep_right", "keep_both", "request_correction", "dismiss_not_conflict"]},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 5000},
    "qualifiers": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 500}},
    "basis_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "number", "minimum": 0},
    "writeback_requested": {"type": "boolean"},
    "second_approver_id": {"type": ["string", "null"], "maxLength": 200}
  }
}
