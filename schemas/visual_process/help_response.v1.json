{
  "$defs": {
    "AssistantClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Evidence Refs",
          "type": "array"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "verification_status": {
          "$ref": "#/$defs/VerificationStatus"
        }
      },
      "required": [
        "claim_id",
        "text",
        "verification_status"
      ],
      "title": "AssistantClaim",
      "type": "object"
    },
    "AssistantLocation": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "field_path": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        },
        "graph_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "target_kind": {
          "enum": [
            "node",
            "field",
            "edge",
            "canvas",
            "validation",
            "runtime",
            "palette_item"
          ],
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "target_kind",
        "graph_id"
      ],
      "title": "AssistantLocation",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance Digest"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Reason Codes",
          "type": "array"
        },
        "scope": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "source_version": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        },
        "tenant_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Id"
        },
        "trust_level": {
          "$ref": "#/$defs/TrustLevel"
        },
        "verification_status": {
          "$ref": "#/$defs/VerificationStatus"
        }
      },
      "required": [
        "evidence_id",
        "trust_level",
        "verification_status"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "TrustLevel": {
      "enum": [
        "extracted",
        "declared",
        "inferred",
        "manual"
      ],
      "title": "TrustLevel",
      "type": "string"
    },
    "VerificationStatus": {
      "enum": [
        "verified",
        "unverified",
        "failed"
      ],
      "title": "VerificationStatus",
      "type": "string"
    },
    "WorkflowPatch": {
      "additionalProperties": false,
      "properties": {
        "base_graph_hash": {
          "title": "Base Graph Hash",
          "type": "string"
        },
        "contract_version": {
          "const": "ananta.visual_process.workflow_patch.v1",
          "default": "ananta.visual_process.workflow_patch.v1",
          "title": "Contract Version",
          "type": "string"
        },
        "definition_revision": {
          "minimum": 0,
          "title": "Definition Revision",
          "type": "integer"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Refs",
          "type": "array"
        },
        "extensions": {
          "additionalProperties": true,
          "title": "Extensions",
          "type": "object"
        },
        "graph_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/WorkflowPatchOperation"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        }
      },
      "required": [
        "graph_id",
        "definition_revision",
        "base_graph_hash",
        "operations"
      ],
      "title": "WorkflowPatch",
      "type": "object"
    },
    "WorkflowPatchOperation": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "edge_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edge Id"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected_old_value": {
          "default": null,
          "title": "Expected Old Value"
        },
        "op": {
          "enum": [
            "add_step",
            "remove_step",
            "update_step_field",
            "add_edge",
            "remove_edge",
            "update_edge_condition"
          ],
          "title": "Op",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "step_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "temp_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temp Id"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "operation_id",
        "op"
      ],
      "title": "WorkflowPatchOperation",
      "type": "object"
    }
  },
  "$id": "https://ananta.local/schemas/visual_process/help_response.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/AssistantClaim"
      },
      "maxItems": 100,
      "title": "Claims",
      "type": "array"
    },
    "context_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Context Id",
      "type": "string"
    },
    "contract_version": {
      "const": "ananta.visual_process.help_response.v1",
      "default": "ananta.visual_process.help_response.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "maxItems": 100,
      "title": "Evidence",
      "type": "array"
    },
    "explanation": {
      "default": "",
      "maxLength": 20000,
      "title": "Explanation",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "location": {
      "$ref": "#/$defs/AssistantLocation"
    },
    "next_actions": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Next Actions",
      "type": "array"
    },
    "options": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 20,
      "title": "Options",
      "type": "array"
    },
    "prompt_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "summary": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Warnings",
      "type": "array"
    },
    "workflow_patch": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowPatch"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "context_id",
    "prompt_version",
    "summary",
    "location"
  ],
  "title": "HelpResponse",
  "type": "object"
}
