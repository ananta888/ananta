{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/testing/sfu_all_turn_scenario_profile.v1.json",
  "title": "SFU all-TURN worst-case capacity profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "activation_status",
    "topology",
    "relay_enforcement",
    "scenario_matrix",
    "run_policy",
    "required_metrics",
    "gate_policy",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "sfu_all_turn_scenario_profile.v1"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "activation_status": {"enum": ["no_go", "candidate", "approved"]},
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publishers", "receiver_sweep", "media"],
      "properties": {
        "publishers": {"const": 1},
        "receiver_sweep": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "integer", "minimum": 1, "maximum": 100000},
          "uniqueItems": true
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audio", "video_layers", "simulcast"],
          "properties": {
            "audio": {"type": "boolean"},
            "video_layers": {"type": "integer", "minimum": 1, "maximum": 4},
            "simulcast": {"type": "boolean"}
          }
        }
      }
    },
    "relay_enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "receivers", "allowed_candidate_types", "transports"],
      "properties": {
        "publisher": {"const": "turn_only"},
        "receivers": {"const": "turn_only"},
        "allowed_candidate_types": {"const": ["relay"]},
        "transports": {
          "type": "array",
          "items": {"enum": ["udp", "tcp", "tls"]},
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        }
      }
    },
    "scenario_matrix": {
      "type": "array",
      "minItems": 8,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "nat", "transport", "loss_percent", "jitter_ms", "bandwidth_kbps", "lifecycle_event"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "nat": {"enum": ["full_cone", "restricted", "port_restricted", "symmetric", "cgnat"]},
          "transport": {"enum": ["udp", "tcp", "tls"]},
          "loss_percent": {"type": "number", "minimum": 0, "maximum": 30},
          "jitter_ms": {"type": "integer", "minimum": 0, "maximum": 1000},
          "bandwidth_kbps": {"type": "integer", "minimum": 64, "maximum": 1000000},
          "lifecycle_event": {"enum": ["steady", "allocation_expiry", "permission_expiry", "channel_expiry", "turn_restart", "pool_failover"]}
        }
      }
    },
    "run_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_seconds", "duration_seconds", "repeats", "confidence", "max_coefficient_of_variation", "random_seed", "cleanup_timeout_seconds"],
      "properties": {
        "warmup_seconds": {"type": "integer", "minimum": 30, "maximum": 3600},
        "duration_seconds": {"type": "integer", "minimum": 300, "maximum": 86400},
        "repeats": {"type": "integer", "minimum": 3, "maximum": 30},
        "confidence": {"type": "number", "minimum": 0.9, "maximum": 0.999},
        "max_coefficient_of_variation": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.25},
        "random_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "cleanup_timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 3600}
      }
    },
    "required_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["relay_bytes", "relay_packets", "allocations", "permissions", "channels", "turn_cpu", "turn_memory", "turn_bandwidth_utilization", "sfu_cpu", "sfu_memory", "packet_loss", "jitter", "rtt", "join_success", "disconnects"]}
    },
    "gate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reserve_fraction", "minimum_success_ratio", "maximum_packet_loss_percent", "maximum_p95_jitter_ms", "maximum_turn_cpu_percent", "maximum_turn_memory_percent", "maximum_turn_bandwidth_utilization_percent", "maximum_sfu_cpu_percent", "maximum_sfu_memory_percent", "require_zero_nonrelay_candidates", "require_relay_bytes_each_leg"],
      "properties": {
        "reserve_fraction": {"type": "number", "minimum": 0.1, "maximum": 0.75},
        "minimum_success_ratio": {"type": "number", "minimum": 0.9, "maximum": 1},
        "maximum_packet_loss_percent": {"type": "number", "minimum": 0, "maximum": 10},
        "maximum_p95_jitter_ms": {"type": "integer", "minimum": 1, "maximum": 500},
        "maximum_turn_cpu_percent": {"type": "number", "minimum": 1, "maximum": 95},
        "maximum_turn_memory_percent": {"type": "number", "minimum": 1, "maximum": 95},
        "maximum_turn_bandwidth_utilization_percent": {"type": "number", "minimum": 1, "maximum": 95},
        "maximum_sfu_cpu_percent": {"type": "number", "minimum": 1, "maximum": 95},
        "maximum_sfu_memory_percent": {"type": "number", "minimum": 1, "maximum": 95},
        "require_zero_nonrelay_candidates": {"const": true},
        "require_relay_bytes_each_leg": {"const": true}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "run_refs", "artifact_sha256"],
      "properties": {
        "source_refs": {"type": "array", "items": {"type": "string", "pattern": "^SRC_[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}, "uniqueItems": true},
        "run_refs": {"type": "array", "items": {"type": "string", "pattern": "^RUN_[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}, "uniqueItems": true},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
