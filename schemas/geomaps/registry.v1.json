{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/geomaps/registry.v1.json",
  "title": "Ananta GeoMap registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "maps"],
  "properties": {
    "schema": {"const": "ananta.geomap-registry.v1"},
    "version": {"type": "integer", "const": 1},
    "maps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/map"}
    }
  },
  "$defs": {
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "label", "level", "format", "source", "featureIdPath",
        "dataJoinKey", "supportedRenderers", "bounds", "license",
        "licenseUrl", "attribution", "sha256", "featureCount", "maxBytes"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "label": {"type": "string", "minLength": 1},
        "level": {"enum": ["country", "continent", "subdivision", "nuts", "custom"]},
        "format": {"enum": ["geojson", "svg"]},
        "source": {"type": "string", "pattern": "^assets/geomaps/[A-Za-z0-9._-]+$"},
        "featureIdPath": {"const": "properties.id"},
        "dataJoinKey": {"enum": ["iso-3166-1-alpha-3", "iso-3166-2", "continent", "nuts", "custom"]},
        "supportedRenderers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["echarts", "plotly"]}
        },
        "bounds": {
          "type": "array",
          "prefixItems": [
            {"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "license": {"type": "string", "minLength": 1},
        "licenseUrl": {"type": "string", "format": "uri"},
        "attribution": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "featureCount": {"type": "integer", "minimum": 1},
        "maxBytes": {"type": "integer", "minimum": 1},
        "minimumMatchRatio": {"type": "number", "minimum": 0, "maximum": 1},
        "aliases": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"format": {"const": "svg"}}},
          "then": {
            "properties": {
              "supportedRenderers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {"const": "echarts"}
              }
            }
          }
        }
      ]
    }
  }
}
