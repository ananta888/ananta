{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/spreadsheet-studio/workbook-snapshot.v1.json",
  "title": "WorkbookSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "snapshot_id", "document_version_id", "sheets"],
  "properties": {
    "schema": {"const": "ananta.spreadsheet-workbook-snapshot.v1"},
    "snapshot_id": {"type": "string"},
    "document_version_id": {"type": "string"},
    "sheets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sheet_id", "name", "hidden", "cells"],
        "properties": {
          "sheet_id": {"type": "string"},
          "name": {"type": "string"},
          "hidden": {"type": "boolean"},
          "cells": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["address", "value", "formula", "style_ref"],
              "properties": {
                "address": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"},
                "value": {},
                "formula": {"type": ["object", "null"]},
                "style_ref": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
