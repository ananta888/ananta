{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/spreadsheet-studio/training-profile.v1.json",
  "title": "SpreadsheetTrainingProfileV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "profile_version",
    "base_model",
    "model_digest",
    "backend",
    "method",
    "quantization",
    "lora_rank",
    "lora_alpha",
    "lora_dropout",
    "target_modules",
    "max_sequence_length",
    "max_cells_per_example",
    "seed",
    "max_steps",
    "num_train_epochs",
    "learning_rate",
    "batch_size",
    "gradient_accumulation_steps",
    "evaluation_steps",
    "early_stopping_patience",
    "checkpoint_interval_steps",
    "resume_allowed",
    "gpu_profile",
    "resource_profile_digest",
    "dataset_recipe_digest",
    "split_lock_digest",
    "action_schema_digest",
    "serializer_digest",
    "policy_digest",
    "profile_digest"
  ],
  "properties": {
    "schema": {"const": "ananta.spreadsheet-training-profile.v1"},
    "profile_id": {"$ref": "#/$defs/id"},
    "profile_version": {"const": "spreadsheet-lora-profile.v1"},
    "base_model": {"type": "string", "minLength": 1, "maxLength": 512},
    "model_digest": {"$ref": "#/$defs/digest"},
    "backend": {"enum": ["mock", "peft_trl", "unsloth"]},
    "method": {"enum": ["lora", "qlora"]},
    "quantization": {"enum": ["none", "4bit"]},
    "lora_rank": {"type": "integer", "minimum": 1, "maximum": 256},
    "lora_alpha": {"type": "integer", "minimum": 1, "maximum": 512},
    "lora_dropout": {"type": "number", "minimum": 0, "maximum": 0.9},
    "target_modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "max_sequence_length": {"type": "integer", "minimum": 128, "maximum": 32768},
    "max_cells_per_example": {"type": "integer", "minimum": 1, "maximum": 100000},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "num_train_epochs": {"type": "number", "minimum": 0.01, "maximum": 1000},
    "learning_rate": {"type": "number", "minimum": 0.0000001, "maximum": 1},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 128},
    "gradient_accumulation_steps": {"type": "integer", "minimum": 1, "maximum": 1024},
    "evaluation_steps": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "early_stopping_patience": {"type": "integer", "minimum": 0, "maximum": 1000},
    "checkpoint_interval_steps": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "resume_allowed": {"type": "boolean"},
    "gpu_profile": {"enum": ["none", "generic-safe", "rtx3080-safe"]},
    "resource_profile_digest": {"$ref": "#/$defs/digest"},
    "dataset_recipe_digest": {"$ref": "#/$defs/digest"},
    "split_lock_digest": {"$ref": "#/$defs/digest"},
    "action_schema_digest": {"$ref": "#/$defs/digest"},
    "serializer_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "profile_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"method": {"const": "qlora"}}, "required": ["method"]},
      "then": {"properties": {"quantization": {"const": "4bit"}}},
      "else": {"properties": {"quantization": {"const": "none"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
