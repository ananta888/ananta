{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.invalid/schemas/spreadsheet-studio/release-result.v1.json",
  "title": "Spreadsheet Studio release result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "git_sha", "input_digests", "gates", "status", "human_intervention_required"],
  "properties": {
    "schema": {"const": "ananta.spreadsheet-studio-release-result.v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "input_digests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "environment", "required", "status", "reason_code", "commands"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "environment": {"enum": ["cpu", "libreoffice", "docker", "browser", "optional_nvidia"]},
          "required": {"type": "boolean"},
          "status": {"enum": ["passed", "failed", "not_run"]},
          "reason_code": {"type": "string", "minLength": 1},
          "commands": {"type": "array", "items": {"$ref": "#/$defs/command-result"}}
        }
      }
    },
    "status": {"enum": ["passed", "failed"]},
    "human_intervention_required": {"const": false}
  },
  "$defs": {
    "command-result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "evidence_kind", "returncode"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_kind": {"enum": ["exit_code", "junit", "playwright_json", "json_status"]},
        "returncode": {"type": "integer"},
        "stdout_tail": {"type": "string", "maxLength": 4000},
        "stderr_tail": {"type": "string", "maxLength": 4000},
        "evidence_valid": {"type": "boolean"},
        "reason_code": {"type": "string", "minLength": 1},
        "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tests": {"type": "integer", "minimum": 0},
            "failures": {"type": "integer", "minimum": 0},
            "errors": {"type": "integer", "minimum": 0},
            "skipped": {"type": "integer", "minimum": 0},
            "expected": {"type": "integer", "minimum": 0},
            "unexpected": {"type": "integer", "minimum": 0},
            "flaky": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
