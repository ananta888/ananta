{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/spreadsheet-studio/validator.v2.json",
  "title": "SpreadsheetValidatorV2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "validator_id": {"$ref": "#/$defs/id"},
    "kind": {"enum": ["equals", "number_range", "formula_present", "cell_empty", "number_tolerance", "formula_pattern", "invariant", "sum_range", "range_rule", "reference_range", "change_scope"]},
    "sheet_id": {"$ref": "#/$defs/id"},
    "cell": {"$ref": "#/$defs/cell"},
    "expected": {"$ref": "#/$defs/scalar"},
    "minimum": {"type": ["number", "null"]},
    "maximum": {"type": ["number", "null"]},
    "absolute_tolerance": {"type": "number", "minimum": 0},
    "relative_tolerance": {"type": "number", "minimum": 0, "maximum": 1},
    "rounding_digits": {"type": "integer", "minimum": 0, "maximum": 15},
    "expected_formula": {"$ref": "#/$defs/formula"},
    "expected_origin": {"$ref": "#/$defs/cell"},
    "allow_relative_references": {"type": "boolean"},
    "start": {"$ref": "#/$defs/cell"},
    "end": {"$ref": "#/$defs/cell"},
    "rule": {"enum": ["non_empty", "non_negative", "unique", "no_errors"]},
    "value_type": {"enum": ["any", "number", "string", "boolean"]},
    "allow_empty": {"type": "boolean"},
    "reference_id": {"$ref": "#/$defs/id"},
    "reference_sheet_id": {"$ref": "#/$defs/id"},
    "reference_start": {"$ref": "#/$defs/cell"},
    "reference_end": {"$ref": "#/$defs/cell"},
    "compare_formulas": {"type": "boolean"},
    "expectation": {"enum": ["unchanged", "changed"]}
  },
  "oneOf": [
    {"$ref": "#/$defs/legacy"},
    {"$ref": "#/$defs/numberTolerance"},
    {"$ref": "#/$defs/formulaPattern"},
    {"$ref": "#/$defs/invariant"},
    {"$ref": "#/$defs/sumRange"},
    {"$ref": "#/$defs/rangeRule"},
    {"$ref": "#/$defs/referenceRange"},
    {"$ref": "#/$defs/changeScope"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "cell": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"},
    "scalar": {"type": ["string", "number", "boolean", "null"]},
    "legacy": {
      "type": "object", "additionalProperties": false,
      "required": ["validator_id", "kind", "sheet_id", "cell", "expected", "minimum", "maximum"],
      "properties": {
        "validator_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["equals", "number_range", "formula_present", "cell_empty"]},
        "sheet_id": {"$ref": "#/$defs/id"}, "cell": {"$ref": "#/$defs/cell"}, "expected": {"$ref": "#/$defs/scalar"},
        "minimum": {"type": ["number", "null"]}, "maximum": {"type": ["number", "null"]}
      }
    },
    "numberTolerance": {
      "type": "object", "additionalProperties": false,
      "required": ["validator_id", "kind", "sheet_id", "cell", "expected", "absolute_tolerance", "relative_tolerance", "rounding_digits"],
      "properties": {
        "validator_id": {"$ref": "#/$defs/id"}, "kind": {"const": "number_tolerance"}, "sheet_id": {"$ref": "#/$defs/id"},
        "cell": {"$ref": "#/$defs/cell"}, "expected": {"type": "number"}, "absolute_tolerance": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0, "maximum": 1}, "rounding_digits": {"type": "integer", "minimum": 0, "maximum": 15}
      }
    },
    "formulaPattern": {
      "type": "object", "additionalProperties": false,
      "required": ["validator_id", "kind", "sheet_id", "cell", "expected_formula", "expected_origin", "allow_relative_references"],
      "properties": {
        "validator_id": {"$ref": "#/$defs/id"}, "kind": {"const": "formula_pattern"}, "sheet_id": {"$ref": "#/$defs/id"},
        "cell": {"$ref": "#/$defs/cell"}, "expected_formula": {"$ref": "#/$defs/formula"}, "expected_origin": {"$ref": "#/$defs/cell"},
        "allow_relative_references": {"type": "boolean"}
      }
    },
    "invariant": {
      "type": "object", "additionalProperties": false,
      "required": ["validator_id", "kind", "sheet_id", "start", "end", "rule"],
      "properties": {
        "validator_id": {"$ref": "#/$defs/id"}, "kind": {"const": "invariant"}, "sheet_id": {"$ref": "#/$defs/id"},
        "start": {"$ref": "#/$defs/cell"}, "end": {"$ref": "#/$defs/cell"}, "rule": {"enum": ["non_empty", "non_negative", "unique", "no_errors"]}
      }
    },
    "sumRange": {
      "type": "object", "additionalProperties": false,
      "required": ["validator_id", "kind", "sheet_id", "start", "end", "expected", "absolute_tolerance", "relative_tolerance", "rounding_digits"],
      "properties": {
        "validator_id": {"$ref": "#/$defs/id"}, "kind": {"const": "sum_range"}, "sheet_id": {"$ref": "#/$defs/id"},
        "start": {"$ref": "#/$defs/cell"}, "end": {"$ref": "#/$defs/cell"}, "expected": {"type": "number"},
        "absolute_tolerance": {"type": "number", "minimum": 0}, "relative_tolerance": {"type": "number", "minimum": 0, "maximum": 1},
        "rounding_digits": {"type": "integer", "minimum": 0, "maximum": 15}
      }
    },
    "rangeRule": {
      "type": "object", "additionalProperties": false,
      "required": ["validator_id", "kind", "sheet_id", "start", "end", "value_type", "allow_empty", "minimum", "maximum"],
      "properties": {
        "validator_id": {"$ref": "#/$defs/id"}, "kind": {"const": "range_rule"}, "sheet_id": {"$ref": "#/$defs/id"},
        "start": {"$ref": "#/$defs/cell"}, "end": {"$ref": "#/$defs/cell"}, "value_type": {"enum": ["any", "number", "string", "boolean"]},
        "allow_empty": {"type": "boolean"}, "minimum": {"type": ["number", "null"]}, "maximum": {"type": ["number", "null"]}
      }
    },
    "referenceRange": {
      "type": "object", "additionalProperties": false,
      "required": ["validator_id", "kind", "reference_id", "reference_sheet_id", "reference_start", "reference_end", "sheet_id", "start", "end", "absolute_tolerance", "relative_tolerance", "compare_formulas"],
      "properties": {
        "validator_id": {"$ref": "#/$defs/id"}, "kind": {"const": "reference_range"}, "reference_id": {"$ref": "#/$defs/id"},
        "reference_sheet_id": {"$ref": "#/$defs/id"}, "reference_start": {"$ref": "#/$defs/cell"}, "reference_end": {"$ref": "#/$defs/cell"},
        "sheet_id": {"$ref": "#/$defs/id"}, "start": {"$ref": "#/$defs/cell"}, "end": {"$ref": "#/$defs/cell"},
        "absolute_tolerance": {"type": "number", "minimum": 0}, "relative_tolerance": {"type": "number", "minimum": 0, "maximum": 1},
        "compare_formulas": {"type": "boolean"}
      }
    },
    "changeScope": {
      "type": "object", "additionalProperties": false,
      "required": ["validator_id", "kind", "sheet_id", "start", "end", "expectation"],
      "properties": {
        "validator_id": {"$ref": "#/$defs/id"}, "kind": {"const": "change_scope"}, "sheet_id": {"$ref": "#/$defs/id"},
        "start": {"$ref": "#/$defs/cell"}, "end": {"$ref": "#/$defs/cell"}, "expectation": {"enum": ["unchanged", "changed"]}
      }
    },
    "formula": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["op", "value"], "properties": {"op": {"const": "literal"}, "value": {"$ref": "#/$defs/scalar"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "sheet_id", "cell"], "properties": {"op": {"const": "cell"}, "sheet_id": {"$ref": "#/$defs/id"}, "cell": {"$ref": "#/$defs/cell"}}},
        {"$ref": "#/$defs/rangeFormula"},
        {"$ref": "#/$defs/unaryFormula"},
        {"$ref": "#/$defs/ifFormula"},
        {"$ref": "#/$defs/binaryFormula"}
      ]
    },
    "rangeFormula": {"type": "object", "additionalProperties": false, "required": ["op", "sheet_id", "start", "end"], "properties": {"op": {"enum": ["sum_range", "average_range", "min_range", "max_range"]}, "sheet_id": {"$ref": "#/$defs/id"}, "start": {"$ref": "#/$defs/cell"}, "end": {"$ref": "#/$defs/cell"}}},
    "unaryFormula": {"type": "object", "additionalProperties": false, "required": ["op", "expression"], "properties": {"op": {"const": "negate"}, "expression": {"$ref": "#/$defs/formula"}}},
    "ifFormula": {"type": "object", "additionalProperties": false, "required": ["op", "condition", "then", "else"], "properties": {"op": {"const": "if"}, "condition": {"$ref": "#/$defs/formula"}, "then": {"$ref": "#/$defs/formula"}, "else": {"$ref": "#/$defs/formula"}}},
    "binaryFormula": {"type": "object", "additionalProperties": false, "required": ["op", "left", "right"], "properties": {"op": {"enum": ["add", "subtract", "multiply", "divide", "equal", "not_equal", "less_than", "less_equal", "greater_than", "greater_equal"]}, "left": {"$ref": "#/$defs/formula"}, "right": {"$ref": "#/$defs/formula"}}}
  }
}
