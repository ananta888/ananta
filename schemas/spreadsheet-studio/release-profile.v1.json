{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.invalid/schemas/spreadsheet-studio/release-profile.v1.json",
  "title": "Spreadsheet Studio release profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "test_matrix", "input_paths", "gates"],
  "properties": {
    "schema": {"const": "ananta.spreadsheet-studio-release-profile.v1"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
    "test_matrix": {"type": "string", "minLength": 1},
    "input_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "gates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "environment", "required", "timeout_seconds", "commands"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
        "environment": {"enum": ["cpu", "libreoffice", "docker", "browser", "optional_nvidia"]},
        "required": {"type": "boolean"},
        "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 7200},
        "required_environment": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$"}
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/command"}
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cwd", "argv", "evidence_kind"],
      "properties": {
        "cwd": {"type": "string", "minLength": 1},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "environment": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "evidence_kind": {"enum": ["exit_code", "junit", "playwright_json", "json_status"]}
      }
    }
  }
}
