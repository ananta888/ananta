{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/spreadsheet-studio/proposal.v1.json",
  "title": "SpreadsheetProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "proposal_id", "document_id", "expected_version", "base_snapshot_digest", "actions", "validators", "automatic_promotion"],
  "properties": {
    "schema": {"const": "ananta.spreadsheet-proposal.v1"},
    "proposal_id": {"type": "string"},
    "document_id": {"type": "string"},
    "expected_version": {"type": "integer", "minimum": 1},
    "base_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actions": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["action_id", "kind", "sheet_id", "cell", "value", "formula"], "properties": {"action_id": {"type": "string"}, "kind": {"enum": ["set_value", "clear_cell", "set_formula"]}, "sheet_id": {"type": "string"}, "cell": {"type": "string"}, "value": {}, "formula": {"type": ["object", "null"]}}}},
    "validators": {"type": "array", "maxItems": 100},
    "automatic_promotion": {"type": "boolean"}
  }
}
