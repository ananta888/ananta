{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/spreadsheet-studio/proposal.v1.json",
  "title": "SpreadsheetProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "document_id",
    "expected_version",
    "base_snapshot_digest",
    "actions",
    "validators",
    "automatic_promotion"
  ],
  "properties": {
    "schema": { "const": "ananta.spreadsheet-proposal.v1" },
    "proposal_id": { "$ref": "#/$defs/id" },
    "document_id": { "$ref": "#/$defs/id" },
    "expected_version": { "type": "integer", "minimum": 1 },
    "base_snapshot_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/cell_action" },
          { "$ref": "#/$defs/clear_range_action" },
          { "$ref": "#/$defs/copy_range_action" },
          { "$ref": "#/$defs/format_range_action" },
          { "$ref": "#/$defs/row_action" },
          { "$ref": "#/$defs/column_action" }
        ]
      }
    },
    "validators": { "type": "array", "maxItems": 100 },
    "automatic_promotion": { "type": "boolean" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "cell": { "type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$" },
    "cell_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "kind", "sheet_id", "cell", "value", "formula"],
      "properties": {
        "action_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["set_value", "set_formula", "clear_cell"] },
        "sheet_id": { "$ref": "#/$defs/id" },
        "cell": { "$ref": "#/$defs/cell" },
        "value": {},
        "formula": { "type": ["object", "null"] }
      }
    },
    "clear_range_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "kind", "sheet_id", "start", "end"],
      "properties": {
        "action_id": { "$ref": "#/$defs/id" },
        "kind": { "const": "clear_range" },
        "sheet_id": { "$ref": "#/$defs/id" },
        "start": { "$ref": "#/$defs/cell" },
        "end": { "$ref": "#/$defs/cell" }
      }
    },
    "copy_range_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "kind",
        "source_sheet_id",
        "source_start",
        "source_end",
        "target_sheet_id",
        "target_start"
      ],
      "properties": {
        "action_id": { "$ref": "#/$defs/id" },
        "kind": { "const": "copy_range" },
        "source_sheet_id": { "$ref": "#/$defs/id" },
        "source_start": { "$ref": "#/$defs/cell" },
        "source_end": { "$ref": "#/$defs/cell" },
        "target_sheet_id": { "$ref": "#/$defs/id" },
        "target_start": { "$ref": "#/$defs/cell" }
      }
    },
    "format_range_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "kind", "sheet_id", "start", "end", "style"],
      "properties": {
        "action_id": { "$ref": "#/$defs/id" },
        "kind": { "const": "format_range" },
        "sheet_id": { "$ref": "#/$defs/id" },
        "start": { "$ref": "#/$defs/cell" },
        "end": { "$ref": "#/$defs/cell" },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number_format", "bold", "italic", "fill_color"],
          "properties": {
            "number_format": { "type": ["string", "null"], "maxLength": 128 },
            "bold": { "type": ["boolean", "null"] },
            "italic": { "type": ["boolean", "null"] },
            "fill_color": { "type": ["string", "null"], "pattern": "^[0-9A-Fa-f]{6,8}$" }
          }
        }
      }
    },
    "row_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "kind", "sheet_id", "start_row", "count"],
      "properties": {
        "action_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["insert_rows", "delete_rows"] },
        "sheet_id": { "$ref": "#/$defs/id" },
        "start_row": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "count": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "column_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "kind", "sheet_id", "start_column", "count"],
      "properties": {
        "action_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["insert_columns", "delete_columns"] },
        "sheet_id": { "$ref": "#/$defs/id" },
        "start_column": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "count": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    }
  }
}
