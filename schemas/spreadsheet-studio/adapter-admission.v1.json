{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/spreadsheet-studio/adapter-admission.v1.json",
  "title": "SpreadsheetAdapterAdmissionV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapter_id", "adapter_version", "registry_version", "status", "evaluation_id", "evaluation_report_digest", "training_governance_digest", "promotion_evidence_digest", "replayed", "automatic_apply", "human_intervention_required", "admission_digest"],
  "properties": {
    "schema": {"const": "ananta.spreadsheet-adapter-admission.v1"},
    "adapter_id": {"$ref": "#/$defs/id"},
    "adapter_version": {"$ref": "#/$defs/id"},
    "registry_version": {"type": "integer", "minimum": 1},
    "status": {"const": "approved"},
    "evaluation_id": {"$ref": "#/$defs/id"},
    "evaluation_report_digest": {"$ref": "#/$defs/digest"},
    "training_governance_digest": {"$ref": "#/$defs/digest"},
    "promotion_evidence_digest": {"$ref": "#/$defs/digest"},
    "replayed": {"type": "boolean"},
    "automatic_apply": {"const": false},
    "human_intervention_required": {"const": false},
    "admission_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
