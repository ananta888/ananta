{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/dendritic-memory/config.v1.json",
  "title": "Dendritic memory experiment configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target_layers", "branch_count", "hidden_dimension", "top_k", "routing_enabled", "readout", "max_steps", "max_memory_bytes", "seed", "precision", "device_profile", "deterministic"],
  "properties": {
    "schema": {"const": "ananta.dendritic-memory-config.v1"},
    "target_layers": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]{0,191}$"}},
    "branch_count": {"type": "integer", "minimum": 2, "maximum": 64},
    "hidden_dimension": {"type": "integer", "minimum": 8, "maximum": 4096},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 64},
    "routing_enabled": {"type": "boolean"},
    "readout": {"enum": ["residual_sum", "gated_residual"]},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 100000},
    "max_memory_bytes": {"type": "integer", "minimum": 1048576, "maximum": 4294967296},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "precision": {"enum": ["float32", "bfloat16", "float16"]},
    "device_profile": {"enum": ["cpu-safe", "rtx3080-safe", "generic-safe"]},
    "deterministic": {"type": "boolean"}
  }
}
