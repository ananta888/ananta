{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ananta.dev/schemas/verification/report.v1.schema.json",
  "title":"Verification Report v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","assignment_digest","run_ref","repository_revision","profile_id","profile_digest","toolchain_digest","backend","target_symbols","status","reason_code","cases_executed","duration_ms","output_digest","counterexamples"],
  "properties":{
    "schema":{"const":"ananta.verification-report.v1"},
    "assignment_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "run_ref":{"type":"string","pattern":"^RUN_[A-Za-z0-9][A-Za-z0-9_.:-]{0,187}$"},
    "repository_revision":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "profile_id":{"type":"string","minLength":1,"maxLength":192},
    "profile_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "toolchain_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "backend":{"enum":["hypothesis","crosshair_check","crosshair_cover","crosshair_backend","crosshair_diff"]},
    "target_symbols":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"type":"string"}},
    "status":{"enum":["passed","passed_with_bounded_search","counterexample_found","failed_to_reproduce","inconclusive","unsupported","timed_out","policy_denied","tool_error"]},
    "reason_code":{"type":"string","minLength":1,"maxLength":192},
    "cases_executed":{"type":"integer","minimum":0},
    "duration_ms":{"type":"integer","minimum":0},
    "output_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "counterexamples":{"type":"array","items":{"$ref":"counterexample.v1.schema.json"}}
  },
  "allOf":[
    {"if":{"properties":{"status":{"const":"counterexample_found"}}},"then":{"properties":{"counterexamples":{"minItems":1}}}},
    {"if":{"not":{"properties":{"status":{"const":"counterexample_found"}}}},"then":{"properties":{"counterexamples":{"maxItems":0}}}}
  ]
}
