{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/worker/codecompass_output_manifest.v1.json",
  "title": "Ananta CodeCompass Output Manifest v1",
  "type": "object",
  "required": [
    "schema",
    "codecompass_version",
    "profile_name",
    "source_scope",
    "generated_at",
    "output_dir",
    "outputs"
  ],
  "properties": {
    "schema": { "type": "string", "const": "codecompass_output_manifest.v1" },
    "codecompass_version": { "type": "string", "minLength": 1 },
    "profile_name": { "type": "string", "minLength": 1 },
    "source_scope": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "manifest_hash": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string", "minLength": 1 },
    "file_type_registry": {
      "$ref": "#/$defs/fileTypeRegistry"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "file_type_capabilities": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/fileTypeCapability" }
    },
    "semantic_budget": {
      "$ref": "#/$defs/semanticBudget"
    },
    "outputs": {
      "type": "object",
      "required": ["index", "details", "context", "embedding", "relations", "graph_nodes", "graph_edges"],
      "properties": {
        "index": { "$ref": "#/$defs/outputFileOrNull" },
        "details": { "$ref": "#/$defs/outputFileOrNull" },
        "context": { "$ref": "#/$defs/outputFileOrNull" },
        "embedding": { "$ref": "#/$defs/outputFileOrNull" },
        "relations": { "$ref": "#/$defs/outputFileOrNull" },
        "graph_nodes": { "$ref": "#/$defs/outputFileOrNull" },
        "graph_edges": { "$ref": "#/$defs/outputFileOrNull" },
        "semantic_nodes": { "$ref": "#/$defs/outputFileOrNull" },
        "semantic_edges": { "$ref": "#/$defs/outputFileOrNull" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "fileTypeRegistry": {
      "type": "object",
      "required": ["schema_version", "registry_version", "snapshot_hash"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "registry_version": { "type": "string", "minLength": 1 },
        "snapshot_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["manifest_candidate_count", "indexed", "excluded", "unsupported", "failed"],
      "properties": {
        "manifest_candidate_count": { "type": "integer", "minimum": 0 },
        "indexed": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "diagnostic_counts": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "capabilityClaim": {
      "type": "object",
      "required": ["configured", "runtime_available", "verified", "effective"],
      "properties": {
        "configured": { "type": "boolean" },
        "runtime_available": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "effective": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "fileTypeCapability": {
      "type": "object",
      "required": ["detected_type", "pipeline", "indexed", "symbols", "relationships", "file_count"],
      "properties": {
        "detected_type": { "type": "string", "minLength": 1 },
        "pipeline": { "type": "string", "minLength": 1 },
        "indexed": {
          "allOf": [
            { "$ref": "#/$defs/capabilityClaim" },
            { "properties": { "effective": { "enum": ["none", "plain_text", "structured"] } } }
          ]
        },
        "symbols": {
          "allOf": [
            { "$ref": "#/$defs/capabilityClaim" },
            { "properties": { "effective": { "enum": ["none", "heuristic", "parser_backed"] } } }
          ]
        },
        "relationships": {
          "allOf": [
            { "$ref": "#/$defs/capabilityClaim" },
            { "properties": { "effective": { "enum": ["none", "structural", "referential", "semantic"] } } }
          ]
        },
        "parser_id": { "type": ["string", "null"] },
        "parser_version": { "type": ["string", "null"] },
        "fallback_reason": { "type": ["string", "null"] },
        "diagnostic_codes": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "file_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "semanticBudget": {
      "type": "object",
      "required": [
        "configured_max_records_per_partition",
        "max_records_per_partition",
        "max_bytes_per_partition",
        "configuration_clamped",
        "truncated",
        "truncated_node_count",
        "truncated_edge_count",
        "unresolved_edge_count",
        "semantic_node_bytes",
        "semantic_edge_bytes"
      ],
      "properties": {
        "configured_max_records_per_partition": { "type": "integer", "minimum": 1 },
        "max_records_per_partition": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "max_bytes_per_partition": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "configuration_clamped": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "truncated_node_count": { "type": "integer", "minimum": 0 },
        "truncated_edge_count": { "type": "integer", "minimum": 0 },
        "unresolved_edge_count": { "type": "integer", "minimum": 0 },
        "semantic_node_bytes": { "type": "integer", "minimum": 0 },
        "semantic_edge_bytes": { "type": "integer", "minimum": 0 },
        "candidate_edge_record_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "candidate_edge_byte_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "candidate_edge_count": { "type": "integer", "minimum": 0 },
        "candidate_edge_bytes": { "type": "integer", "minimum": 0 },
        "truncated_candidate_edge_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "required": ["candidate_edge_record_limit"] },
              { "required": ["candidate_edge_byte_limit"] },
              { "required": ["candidate_edge_count"] },
              { "required": ["candidate_edge_bytes"] },
              { "required": ["truncated_candidate_edge_count"] }
            ]
          },
          "then": {
            "required": [
              "candidate_edge_record_limit",
              "candidate_edge_byte_limit",
              "candidate_edge_count",
              "candidate_edge_bytes",
              "truncated_candidate_edge_count"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "outputFileOrNull": {
      "anyOf": [{ "$ref": "#/$defs/outputFile" }, { "type": "null" }]
    },
    "outputFile": {
      "type": "object",
      "required": ["path", "sha256", "mtime", "record_count"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 1 },
        "mtime": { "type": "number" },
        "record_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
