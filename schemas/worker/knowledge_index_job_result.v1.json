{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ananta.knowledge_index_job_result.v1",
  "title": "Knowledge index worker result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "job_id",
    "idempotency_fingerprint",
    "status",
    "reason_code",
    "knowledge_index",
    "run",
    "results",
    "artifact_refs",
    "error"
  ],
  "properties": {
    "schema": {"const": "ananta.knowledge_index_job_result.v1"},
    "job_id": {"type": "string", "pattern": "^knowledge-index-[a-f0-9]{32}$"},
    "idempotency_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["completed", "failed"]},
    "reason_code": {"type": ["string", "null"]},
    "knowledge_index": {"type": ["object", "null"]},
    "run": {"type": ["object", "null"]},
    "results": {"type": ["array", "null"], "items": {"type": "object"}},
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "sha256", "media_type"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "media_type": {"type": "string", "minLength": 1},
          "role": {"enum": ["manifest", "index", "details", "relations", "graph_index", "graph_visual_metrics"]},
          "filename": {"enum": ["manifest.json", "index.jsonl", "details.jsonl", "relations.jsonl", "cc_graph_index.json", "cc_graph_index.visual_metrics.json"]},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 134217728},
          "knowledge_index_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "artifact_schema": {"enum": ["codecompass_graph_index.v1", "graph_visual_metrics.v1"]},
          "graph_revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "graph_content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {"required": ["role"]},
                {"required": ["filename"]},
                {"required": ["size_bytes"]},
                {"required": ["knowledge_index_id"]},
                {"required": ["run_id"]}
              ]
            },
            "then": {
              "required": ["role", "filename", "size_bytes", "knowledge_index_id", "run_id"]
            }
          },
          {
            "if": {
              "properties": {"role": {"enum": ["graph_index", "graph_visual_metrics"]}},
              "required": ["role"]
            },
            "then": {
              "required": ["artifact_schema", "graph_revision", "graph_content_hash"],
              "properties": {
                "size_bytes": {"maximum": 33554432}
              }
            },
            "else": {
              "not": {
                "anyOf": [
                  {"required": ["artifact_schema"]},
                  {"required": ["graph_revision"]},
                  {"required": ["graph_content_hash"]}
                ]
              }
            }
          },
          {
            "if": {
              "properties": {"role": {"const": "graph_index"}},
              "required": ["role"]
            },
            "then": {
              "properties": {
                "filename": {"const": "cc_graph_index.json"},
                "artifact_schema": {"const": "codecompass_graph_index.v1"}
              }
            }
          },
          {
            "if": {
              "properties": {"role": {"const": "graph_visual_metrics"}},
              "required": ["role"]
            },
            "then": {
              "properties": {
                "filename": {"const": "cc_graph_index.visual_metrics.json"},
                "artifact_schema": {"const": "graph_visual_metrics.v1"}
              }
            }
          }
        ]
      }
    },
    "error": {"type": ["string", "null"]}
  }
}
