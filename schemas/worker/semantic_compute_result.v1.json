{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/worker/semantic_compute_result.v1.json",
  "title": "Semantic compute worker result v1",
  "type": "object",
  "required": [
    "schema", "task_id", "contract_id", "contract_digest", "lease_id", "fencing_token",
    "session_id", "epoch", "task_type", "audience", "status", "result_digest",
    "artifact_refs", "completed_at_ms", "execution_owner"
  ],
  "properties": {
    "schema": {"const": "ananta.semantic-compute-result.v1"},
    "task_id": {"type": "string", "maxLength": 192},
    "contract_id": {"type": "string", "maxLength": 192},
    "contract_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "lease_id": {"type": "string", "maxLength": 192},
    "fencing_token": {"type": "integer", "minimum": 1},
    "session_id": {"type": "string", "maxLength": 192},
    "epoch": {"type": "integer", "minimum": 1},
    "task_type": {"enum": ["visual_extract", "visual_validate", "speech_features", "speech_validate"]},
    "audience": {"type": "string", "maxLength": 192},
    "status": {"enum": ["completed", "failed", "cancelled"]},
    "reason_code": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,119}$"},
    "result_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_refs": {
      "type": "array", "maxItems": 8, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^artifact:[A-Za-z0-9_.:@-]{1,180}$"}
    },
    "metrics": {
      "type": "object", "maxProperties": 8,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1000000000}
    },
    "completed_at_ms": {"type": "integer", "minimum": 1},
    "execution_owner": {"const": "worker"}
  },
  "additionalProperties": false
}
