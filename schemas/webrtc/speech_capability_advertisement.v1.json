{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/webrtc/speech_capability_advertisement.v1.json",
  "title": "Ananta semantic speech capability advertisement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "session_id", "epoch", "sender_id", "audience_id", "consent_version", "expires_at_ms", "contract_digest", "modes", "live_partials", "segment_duration_ms", "max_frame_bytes"],
  "properties": {
    "version": {"const": "ananta.speech-capability.v1"},
    "session_id": {"$ref": "#/$defs/id"},
    "epoch": {"$ref": "#/$defs/positive"},
    "sender_id": {"$ref": "#/$defs/id"},
    "audience_id": {"$ref": "#/$defs/id"},
    "consent_version": {"$ref": "#/$defs/positive"},
    "expires_at_ms": {"$ref": "#/$defs/positive"},
    "contract_digest": {"$ref": "#/$defs/digest"},
    "modes": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["ordinary_audio", "transcript_live", "semantic_reconstruction", "delayed_correction", "segment_only"]}},
    "live_partials": {"type": "boolean"},
    "segment_duration_ms": {"type": "integer", "minimum": 1000, "maximum": 300000},
    "max_frame_bytes": {"type": "integer", "minimum": 1, "maximum": 16384}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "positive": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
