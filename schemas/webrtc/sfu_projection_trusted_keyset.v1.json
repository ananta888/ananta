{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/webrtc/sfu_projection_trusted_keyset.v1.json",
  "title": "Pinned SFU projection Ed25519 public keyset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "keysetVersion", "keys"],
  "properties": {
    "schema": {"const": "ananta.sfu-projection-trusted-keyset.v1"},
    "keysetVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/key"}
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "algorithm",
        "algorithmVersion",
        "keyVersion",
        "status",
        "format",
        "keyMaterialBase64Url"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,111}:v[1-9][0-9]{0,8}$"
        },
        "algorithm": {"const": "Ed25519"},
        "algorithmVersion": {"const": 1},
        "keyVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "status": {"enum": ["active", "overlap", "revoked"]},
        "format": {"const": "raw"},
        "keyMaterialBase64Url": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    }
  }
}
