{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/webrtc/audience_snapshot.v1.json",
  "title": "Immutable hub-owned WebRTC audience snapshot v1",
  "description": "An append-only Hub projection of individually authorized receivers. Hub-only authorization references MUST NOT cross the SFU projection boundary.",
  "$comment": "JSON Schema enforces shape and absolute hard caps. State-dependent scope, freshness, ordering, digest, lineage, byte-size and non-linkability rules in x-ananta-semantic-rules are mandatory parts of this contract and fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot_id",
    "projection_version",
    "immutable",
    "scope",
    "epochs",
    "created_at",
    "expires_at",
    "ttl_seconds",
    "lineage",
    "limits",
    "hub_audience",
    "member_digest",
    "sfu_projection"
  ],
  "properties": {
    "schema": {
      "const": "ananta.webrtc.audience-snapshot.v1"
    },
    "snapshot_id": {
      "$ref": "#/$defs/snapshot_id"
    },
    "projection_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "immutable": {
      "const": true
    },
    "scope": {
      "$ref": "#/$defs/snapshot_scope"
    },
    "epochs": {
      "$ref": "#/$defs/snapshot_epochs"
    },
    "created_at": {
      "$ref": "#/$defs/utc_second"
    },
    "expires_at": {
      "$ref": "#/$defs/utc_second"
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "lineage": {
      "oneOf": [
        {
          "$ref": "#/$defs/initial_lineage"
        },
        {
          "$ref": "#/$defs/successor_lineage"
        }
      ]
    },
    "limits": {
      "$ref": "#/$defs/effective_limits"
    },
    "hub_audience": {
      "$ref": "#/$defs/hub_audience"
    },
    "member_digest": {
      "$ref": "#/$defs/member_digest"
    },
    "sfu_projection": {
      "$ref": "#/$defs/sfu_projection"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "projection_version": {
            "const": 1
          }
        },
        "required": [
          "projection_version"
        ]
      },
      "then": {
        "properties": {
          "lineage": {
            "$ref": "#/$defs/initial_lineage"
          }
        }
      },
      "else": {
        "properties": {
          "lineage": {
            "$ref": "#/$defs/successor_lineage"
          }
        }
      }
    }
  ],
  "$defs": {
    "snapshot_id": {
      "title": "Unpredictable 128-bit snapshot identifier encoded as unpadded base64url",
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^aud_[A-Za-z0-9_-]{22}$"
    },
    "receiver_handle": {
      "title": "Snapshot-scoped opaque 128-bit SFU receiver handle",
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^rcv_[A-Za-z0-9_-]{22}$"
    },
    "digest_value": {
      "title": "SHA-256 output encoded as unpadded base64url",
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "utc_second": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "format": "date-time"
    },
    "snapshot_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_ref",
        "room_ref",
        "publication_ref",
        "policy"
      ],
      "properties": {
        "tenant_ref": {
          "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/tenant_ref"
        },
        "room_ref": {
          "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/room_ref"
        },
        "publication_ref": {
          "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/publication_ref"
        },
        "policy": {
          "$ref": "#/$defs/policy_binding"
        }
      }
    },
    "policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_ref",
        "version"
      ],
      "properties": {
        "policy_ref": {
          "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/canonical_id"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "snapshot_epochs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "membership_epoch",
        "consent_epoch",
        "key_epoch"
      ],
      "properties": {
        "membership_epoch": {
          "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/membership_epoch"
        },
        "consent_epoch": {
          "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/monotone_epoch"
        },
        "key_epoch": {
          "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/key_epoch"
        }
      }
    },
    "initial_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_kind",
        "predecessor_snapshot_id",
        "predecessor_projection_version"
      ],
      "properties": {
        "change_kind": {
          "const": "initial"
        },
        "predecessor_snapshot_id": {
          "type": "null"
        },
        "predecessor_projection_version": {
          "type": "null"
        }
      }
    },
    "successor_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_kind",
        "predecessor_snapshot_id",
        "predecessor_projection_version"
      ],
      "properties": {
        "change_kind": {
          "enum": [
            "join",
            "leave",
            "revoke",
            "grant_changed",
            "consent_changed",
            "membership_epoch_changed",
            "key_epoch_changed",
            "policy_changed"
          ]
        },
        "predecessor_snapshot_id": {
          "$ref": "#/$defs/snapshot_id"
        },
        "predecessor_projection_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        }
      }
    },
    "effective_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "members_max",
        "grant_refs_per_member_max",
        "snapshot_bytes_max",
        "ttl_seconds_max"
      ],
      "properties": {
        "members_max": {
          "description": "Effective Hub configuration, bounded by the schema hard cap of 8.",
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "grant_refs_per_member_max": {
          "description": "Effective Hub configuration, bounded by the schema hard cap of 8.",
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "snapshot_bytes_max": {
          "description": "Effective maximum canonical UTF-8 snapshot size, bounded by the schema hard cap of 32768 bytes.",
          "type": "integer",
          "minimum": 1024,
          "maximum": 32768
        },
        "ttl_seconds_max": {
          "description": "Effective Hub TTL configuration, bounded by the schema hard cap of 300 seconds.",
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    },
    "hub_audience": {
      "description": "Hub-confidential authorization projection. This object is never sent to an SFU or worker.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "members"
      ],
      "properties": {
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/member_binding"
          }
        }
      }
    },
    "member_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_ref",
        "membership_ref",
        "consent_ref",
        "receiver_handle",
        "grant_refs"
      ],
      "properties": {
        "member_ref": {
          "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/canonical_id"
        },
        "membership_ref": {
          "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/canonical_id"
        },
        "consent_ref": {
          "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/canonical_id"
        },
        "receiver_handle": {
          "$ref": "#/$defs/receiver_handle"
        },
        "grant_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/grant_binding"
          }
        }
      }
    },
    "grant_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_ref",
        "grant_version",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "grant_ref": {
          "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/canonical_id"
        },
        "grant_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "valid_from": {
          "$ref": "#/$defs/utc_second"
        },
        "valid_until": {
          "$ref": "#/$defs/utc_second"
        }
      }
    },
    "member_digest": {
      "description": "Hub-generated keyed commitment. key_ref and all authorization input remain Hub-only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "domain",
        "key_scope",
        "key_ref",
        "key_version",
        "encoding",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "hmac-sha-256"
        },
        "domain": {
          "const": "ananta.webrtc.audience-snapshot.member-digest.v1"
        },
        "key_scope": {
          "const": "hub-only-non-media"
        },
        "key_ref": {
          "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/canonical_id"
        },
        "key_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "encoding": {
          "const": "base64url-no-padding"
        },
        "value": {
          "$ref": "#/$defs/digest_value"
        }
      }
    },
    "sfu_projection": {
      "description": "The complete and only audience payload allowed to cross the SFU control boundary.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiver_handles",
        "audience_digest"
      ],
      "properties": {
        "receiver_handles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/receiver_handle"
          }
        },
        "audience_digest": {
          "$ref": "#/$defs/digest_value"
        }
      }
    }
  },
  "x-ananta-semantic-rules": {
    "authority": "Only the Hub resolves and authorizes member, membership, consent, grant, policy and key references. An SFU or worker cannot widen this set.",
    "immutability": [
      "The snapshot row and its member/grant children are append-only after creation.",
      "Every join, leave, revoke, grant, consent, membership-epoch, key-epoch or policy change creates a fresh unpredictable snapshot_id and a strictly greater projection_version.",
      "A successor references an existing predecessor in the identical tenant, room and publication scope; predecessor_snapshot_id differs from snapshot_id and predecessor_projection_version is lower than projection_version."
    ],
    "canonical_order": [
      "hub_audience.members is strictly ascending by member_ref using unsigned ASCII byte order.",
      "Each grant_refs array is strictly ascending by grant_ref using unsigned ASCII byte order.",
      "Member refs, membership refs, consent refs, grant refs and receiver handles are unique within the snapshot.",
      "sfu_projection.receiver_handles has exactly the handles from hub_audience.members in member order."
    ],
    "authorization": [
      "Every reference is resolved transactionally against canonical Hub state at created_at.",
      "Resolved tenant, room, publication, member, membership, consent, policy and epochs equal the snapshot bindings.",
      "grant_version equals the current canonical version; the grant is active for the complete [created_at, expires_at] interval.",
      "Missing, stale, revoked, cross-scope or unverifiable state fails closed."
    ],
    "time_and_limits": [
      "expires_at is strictly later than created_at and differs by exactly ttl_seconds.",
      "ttl_seconds is no greater than limits.ttl_seconds_max.",
      "Member and per-member grant counts are no greater than their effective limits.",
      "The canonical UTF-8 serialization of the complete snapshot is no greater than limits.snapshot_bytes_max.",
      "The schema hard caps are members=8, grants-per-member=8, canonical-bytes=32768 and ttl-seconds=300; configuration may only lower them."
    ],
    "digest": [
      "The digest is HMAC-SHA-256 with a random Hub-only key of at least 256 bits dedicated to this non-media domain.",
      "The digest input and canonical encoding are normative in docs/contracts/audience-snapshot.md.",
      "sfu_projection.audience_digest equals member_digest.value in constant time.",
      "Unkeyed hashes, media keys, signing keys, tenant-supplied keys and receiver-supplied digests are forbidden."
    ],
    "non_linkability": [
      "receiver_handle is unpredictable and unique to snapshot_id; it is never reused across room, publication, key epoch or successor boundaries.",
      "The digest binds tenant, room, publication, policy, epochs, snapshot identity/version, validity, lineage, limits and every Hub-only member/grant binding.",
      "Reuse of a receiver handle or digest across room, publication or key-epoch boundaries fails closed even before digest comparison."
    ],
    "sfu_boundary": [
      "Only sfu_projection.receiver_handles and sfu_projection.audience_digest may be copied into an SFU route command.",
      "The SFU projection cannot contain member, membership, consent, grant, role, policy or digest-key references."
    ]
  }
}
