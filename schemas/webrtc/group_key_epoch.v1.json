{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/webrtc/group_key_epoch.v1.json",
  "title": "Ananta WebRTC Group Key Epoch Authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "authorization_id", "tenant_id", "room_id", "publication_id",
    "epoch", "previous_epoch", "member_set_digest", "member_ids",
    "key_package_refs", "valid_from_ms", "expires_at_ms", "rekey_deadline_ms",
    "reason", "hub_key_id", "signature_b64"
  ],
  "properties": {
    "version": { "const": 1 },
    "authorization_id": { "$ref": "#/$defs/id" },
    "tenant_id": { "$ref": "#/$defs/id" },
    "room_id": { "$ref": "#/$defs/id" },
    "publication_id": { "$ref": "#/$defs/id" },
    "epoch": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "previous_epoch": { "type": "integer", "minimum": 0, "maximum": 2147483646 },
    "member_set_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "member_ids": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "key_package_refs": {
      "type": "object", "minProperties": 1, "maxProperties": 8,
      "additionalProperties": { "$ref": "#/$defs/id" }
    },
    "valid_from_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "expires_at_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "rekey_deadline_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "reason": { "enum": ["create", "join", "leave", "revoke", "hub_failover", "refresh"] },
    "hub_key_id": { "$ref": "#/$defs/id" },
    "membership_epoch": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "signature_b64": { "type": "string", "minLength": 86, "maxLength": 88 }
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
