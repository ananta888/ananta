{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.invalid/schemas/webrtc/sfu_broadcast_advanced_gate_profile.v1.json",
  "title": "SFU Broadcast Advanced Gate Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gate_id",
    "profile_id",
    "artifact_schema",
    "external_result_schema",
    "seed",
    "execution",
    "topology",
    "required_capabilities",
    "required_scenarios",
    "required_metrics",
    "required_assertions",
    "cleanup_requirements",
    "thresholds",
    "environment"
  ],
  "properties": {
    "schema": {"const": "ananta.sfu-broadcast-advanced-gate-profile.v1"},
    "gate_id": {"enum": ["SFB-GATE-005", "SFB-GATE-006", "SFB-GATE-007", "SFB-GATE-008", "SFB-GATE-010"]},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "artifact_schema": {"type": "string", "pattern": "^ananta\\."},
    "external_result_schema": {"type": "string", "pattern": "^ananta\\."},
    "seed": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_seconds", "measurement_seconds", "repetitions", "timeout_seconds", "cleanup_timeout_seconds", "artifact_bytes_max"],
      "properties": {
        "warmup_seconds": {"type": "integer", "minimum": 1},
        "measurement_seconds": {"type": "integer", "minimum": 1},
        "repetitions": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "cleanup_timeout_seconds": {"type": "integer", "minimum": 1},
        "artifact_bytes_max": {"type": "integer", "minimum": 1, "maximum": 67108864}
      }
    },
    "topology": {"type": "object", "minProperties": 1},
    "required_capabilities": {"$ref": "#/$defs/uniqueStrings"},
    "required_scenarios": {"$ref": "#/$defs/uniqueStrings"},
    "required_metrics": {"$ref": "#/$defs/uniqueStrings"},
    "required_assertions": {"$ref": "#/$defs/uniqueStrings"},
    "cleanup_requirements": {"type": "object", "minProperties": 1},
    "thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "operator", "value"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "operator": {"enum": ["eq", "gte", "lte"]},
          "value": {"type": "number"}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_paths", "infrastructure_paths", "browser_lock_path", "images", "required_digest_names"],
      "properties": {
        "source_paths": {"$ref": "#/$defs/uniqueStrings"},
        "infrastructure_paths": {"$ref": "#/$defs/uniqueStrings"},
        "browser_lock_path": {"type": "string", "minLength": 1},
        "images": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}},
        "required_digest_names": {"$ref": "#/$defs/uniqueStrings"}
      }
    }
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
