{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/webrtc/capability_advertisement.v1.json",
  "title": "Semantic compute capability advertisement v1",
  "type": "object",
  "required": [
    "schema", "advertisement_id", "session_id", "epoch", "sender_id",
    "algorithms", "roles", "task_types", "resource_profile",
    "measurements_expires_at_ms", "expires_at_ms", "max_delay_ms",
    "max_artifact_bytes", "signature"
  ],
  "properties": {
    "schema": {"const": "ananta.semantic-capability-advertisement.v1"},
    "advertisement_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,191}$"},
    "session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,191}$"},
    "room_id": {"type": ["string", "null"], "maxLength": 192},
    "epoch": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "sender_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,191}$"},
    "algorithms": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"}
    },
    "roles": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["executor", "validator", "standby"]}
    },
    "task_types": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {"enum": ["visual_extract", "visual_validate", "speech_features", "speech_validate"]}
    },
    "resource_profile": {
      "type": "object",
      "required": ["cpu", "memory", "gpu", "codec", "battery", "network"],
      "properties": {
        "cpu": {"enum": ["unknown", "low", "medium", "high"]},
        "memory": {"enum": ["unknown", "low", "medium", "high"]},
        "gpu": {"enum": ["unknown", "none", "integrated", "dedicated"]},
        "codec": {"enum": ["unknown", "software", "hardware"]},
        "battery": {"enum": ["unknown", "critical", "limited", "mains"]},
        "network": {"enum": ["unknown", "constrained", "normal", "fast"]}
      },
      "additionalProperties": false
    },
    "measurements_expires_at_ms": {"type": "integer", "minimum": 1},
    "expires_at_ms": {"type": "integer", "minimum": 1},
    "max_delay_ms": {"type": "integer", "minimum": 2000, "maximum": 20000},
    "max_artifact_bytes": {"type": "integer", "minimum": 1024, "maximum": 4194304},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"enum": ["ed25519", "hmac-sha256"]},
        "key_id": {"type": "string", "maxLength": 128},
        "value": {"type": "string", "minLength": 16, "maxLength": 512}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
