{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/webrtc/browser_media_capability_observation.v1.json",
  "title": "Browser media capability observation v1",
  "description": "A privacy-bounded, room-scoped and non-authoritative browser capability observation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "capability_version",
    "tenant_ref",
    "room_ref",
    "admission_epoch",
    "membership_epoch",
    "browser_instance_pseudonym",
    "sequence",
    "issued_at",
    "ttl_seconds",
    "pseudonym_rotation_seconds",
    "capability_bucket_combinations_max",
    "report_bytes_max",
    "authorization_effect",
    "capability_buckets"
  ],
  "properties": {
    "schema": {
      "const": "ananta.browser-media-capability-observation.v1"
    },
    "schema_version": {
      "const": 1
    },
    "capability_version": {
      "const": "coarse-v1"
    },
    "tenant_ref": {
      "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/tenant_ref"
    },
    "room_ref": {
      "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/room_ref"
    },
    "admission_epoch": {
      "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/monotone_epoch"
    },
    "membership_epoch": {
      "$ref": "https://ananta.local/schemas/webrtc/sfu_broadcast_extension_defs.v1.json#/$defs/membership_epoch"
    },
    "browser_instance_pseudonym": {
      "type": "string",
      "minLength": 31,
      "maxLength": 31,
      "pattern": "^room-bip_[A-Za-z0-9_-]{22}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "issued_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "format": "date-time"
    },
    "ttl_seconds": {
      "const": 300
    },
    "pseudonym_rotation_seconds": {
      "const": 900
    },
    "capability_bucket_combinations_max": {
      "const": 8
    },
    "report_bytes_max": {
      "const": 2048
    },
    "authorization_effect": {
      "const": "none"
    },
    "capability_buckets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability_bucket"
      }
    }
  },
  "$defs": {
    "capability_bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec_bucket",
        "layering_bucket",
        "encoded_transform_bucket",
        "decode_bucket",
        "evidence_bucket"
      ],
      "properties": {
        "codec_bucket": {
          "enum": [
            "unknown",
            "unsupported",
            "audio_opus",
            "video_vp8",
            "video_h264",
            "video_vp9",
            "video_av1"
          ]
        },
        "layering_bucket": {
          "enum": [
            "unknown",
            "unsupported",
            "simulcast",
            "svc"
          ]
        },
        "encoded_transform_bucket": {
          "enum": [
            "unknown",
            "unsupported",
            "available"
          ]
        },
        "decode_bucket": {
          "enum": [
            "unknown",
            "unsupported",
            "audio_realtime",
            "video_baseline",
            "video_enhanced"
          ]
        },
        "evidence_bucket": {
          "enum": [
            "not_observed",
            "static_api_presence",
            "static_capability_query"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_bucket": {
                "const": "not_observed"
              }
            },
            "required": [
              "evidence_bucket"
            ]
          },
          "then": {
            "properties": {
              "codec_bucket": {
                "const": "unknown"
              },
              "layering_bucket": {
                "const": "unknown"
              },
              "encoded_transform_bucket": {
                "const": "unknown"
              },
              "decode_bucket": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "codec_bucket": {
                "const": "audio_opus"
              }
            },
            "required": [
              "codec_bucket"
            ]
          },
          "then": {
            "properties": {
              "layering_bucket": {
                "enum": [
                  "unknown",
                  "unsupported"
                ]
              },
              "decode_bucket": {
                "enum": [
                  "unknown",
                  "unsupported",
                  "audio_realtime"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "codec_bucket": {
                "enum": [
                  "video_vp8",
                  "video_h264",
                  "video_vp9",
                  "video_av1"
                ]
              }
            },
            "required": [
              "codec_bucket"
            ]
          },
          "then": {
            "properties": {
              "decode_bucket": {
                "enum": [
                  "unknown",
                  "unsupported",
                  "video_baseline",
                  "video_enhanced"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
