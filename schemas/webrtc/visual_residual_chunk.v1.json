{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/webrtc/visual_residual_chunk.v1.json",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema", "chunk_id", "session_id", "contract_id", "lease_id", "epoch",
    "sequence", "frame_digest", "index", "total_chunks", "chunk_bytes",
    "total_bytes", "codec", "expires_at_ms", "data"
  ],
  "properties": {
    "schema": {"const": "ananta.visual-residual-chunk.v1"},
    "chunk_id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"},
    "contract_id": {"$ref": "#/$defs/id"}, "lease_id": {"$ref": "#/$defs/id"},
    "epoch": {"type": "integer", "minimum": 1},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "frame_digest": {"$ref": "#/$defs/digest"},
    "index": {"type": "integer", "minimum": 0, "maximum": 255},
    "total_chunks": {"type": "integer", "minimum": 1, "maximum": 256},
    "chunk_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
    "total_bytes": {"type": "integer", "minimum": 1, "maximum": 524288},
    "codec": {"enum": ["image/webp", "image/avif", "video/vp9"]},
    "expires_at_ms": {"type": "integer", "minimum": 1},
    "data": {"type": "string", "maxLength": 87384, "pattern": "^[A-Za-z0-9+/]*={0,2}$"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
