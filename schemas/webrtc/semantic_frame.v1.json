{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/webrtc/semantic_frame.v1.json",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema", "frame_id", "session_id", "contract_id", "contract_digest",
    "lease_id", "lease_digest", "epoch", "sequence", "frame_kind",
    "base_reference_id", "scene_digest", "algorithm", "encoded_digest",
    "total_bytes", "created_at_ms", "expires_at_ms"
  ],
  "properties": {
    "schema": {"const": "ananta.semantic-frame.v1"},
    "frame_id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"},
    "contract_id": {"$ref": "#/$defs/id"}, "contract_digest": {"$ref": "#/$defs/digest"},
    "lease_id": {"$ref": "#/$defs/id"}, "lease_digest": {"$ref": "#/$defs/digest"},
    "epoch": {"type": "integer", "minimum": 1},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "frame_kind": {"enum": ["reference", "delta", "region_repair"]},
    "base_reference_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "scene_digest": {"$ref": "#/$defs/digest"},
    "algorithm": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "codec"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "codec": {"enum": ["image/webp", "image/avif", "video/vp9"]}
      }
    },
    "encoded_digest": {"$ref": "#/$defs/digest"},
    "total_bytes": {"type": "integer", "minimum": 1, "maximum": 524288},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "expires_at_ms": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"frame_kind": {"const": "reference"}}, "required": ["frame_kind"]},
      "then": {"properties": {"base_reference_id": {"type": "null"}}},
      "else": {"properties": {"base_reference_id": {"$ref": "#/$defs/id"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
