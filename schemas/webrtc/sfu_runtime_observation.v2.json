{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.invalid/schemas/webrtc/sfu_runtime_observation.v2.json",
  "title": "Bounded non-authoritative SFU runtime observation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer_mode", "scope", "producer_id", "producer_fencing_token", "boot_id", "sequence", "measured_at_ms", "valid_until_ms", "config_digest", "image_digest", "capability_digest", "capabilities", "health", "capacity", "pressure", "labels", "proof"],
  "properties": {
    "schema_version": {"const": "sfu_runtime_observation.v2"},
    "producer_mode": {"enum": ["livekit_control_api", "authenticated_runtime_extension"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "cluster_id", "region", "observed_node_id", "node_binding_authority"],
      "properties": {
        "tenant_id": {"$ref": "#/$defs/identifier"},
        "cluster_id": {"$ref": "#/$defs/identifier"},
        "region": {"$ref": "#/$defs/identifier"},
        "runtime_id": {"$ref": "#/$defs/identifier"},
        "observed_node_id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "node_binding_authority": {"const": "non_authoritative_observation"}
      }
    },
    "producer_id": {"$ref": "#/$defs/identifier"},
    "producer_fencing_token": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "boot_id": {"$ref": "#/$defs/identifier"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "measured_at_ms": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "valid_until_ms": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "config_digest": {"$ref": "#/$defs/digest"},
    "image_digest": {"$ref": "#/$defs/digest"},
    "capability_digest": {"$ref": "#/$defs/digest"},
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
          "state": {"enum": ["supported", "unsupported", "unknown"]}
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveness", "control_ready", "media_ready", "admission_ready"],
      "properties": {
        "liveness": {"type": ["boolean", "null"]},
        "control_ready": {"type": ["boolean", "null"]},
        "media_ready": {"type": ["boolean", "null"]},
        "admission_ready": {"type": ["boolean", "null"]}
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiver_limit", "room_limit", "egress_bps", "memory_bytes_limit"],
      "properties": {
        "receiver_limit": {"$ref": "#/$defs/nonnegativeOrUnknown"},
        "room_limit": {"$ref": "#/$defs/nonnegativeOrUnknown"},
        "egress_bps": {"$ref": "#/$defs/nonnegativeOrUnknown"},
        "memory_bytes_limit": {"$ref": "#/$defs/nonnegativeOrUnknown"}
      }
    },
    "pressure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_ratio", "memory_ratio", "fd_ratio", "udp_port_ratio", "packet_drop_ratio"],
      "properties": {
        "cpu_ratio": {"$ref": "#/$defs/ratioOrUnknown"},
        "memory_ratio": {"$ref": "#/$defs/ratioOrUnknown"},
        "fd_ratio": {"$ref": "#/$defs/ratioOrUnknown"},
        "udp_port_ratio": {"$ref": "#/$defs/ratioOrUnknown"},
        "packet_drop_ratio": {"$ref": "#/$defs/ratioOrUnknown"}
      }
    },
    "labels": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]{0,31}$"},
      "additionalProperties": {"type": "string", "maxLength": 64}
    },
    "proof": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "key_id", "signature"],
          "properties": {
            "algorithm": {"enum": ["ECDSA-SHA256", "RSA-PSS-SHA256"]},
            "key_id": {"$ref": "#/$defs/identifier"},
            "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,4096}$"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"producer_mode": {"const": "livekit_control_api"}}, "required": ["producer_mode"]},
      "then": {"properties": {"proof": {"type": "null"}}}
    },
    {
      "if": {"properties": {"producer_mode": {"const": "authenticated_runtime_extension"}}, "required": ["producer_mode"]},
      "then": {
        "properties": {
          "scope": {"required": ["runtime_id"]},
          "proof": {"type": "object"}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonnegativeOrUnknown": {"type": ["integer", "null"], "minimum": 0, "maximum": 1125899906842624},
    "ratioOrUnknown": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
  }
}
