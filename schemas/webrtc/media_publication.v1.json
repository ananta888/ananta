{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/webrtc/media_publication.v1.json",
  "title": "Hub-authorized SFU media publication",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "publication_id", "tenant_id", "room_id", "participant_id", "membership_epoch", "revision", "source", "kind", "privacy", "status", "authorized_subscriber_ids", "constraints"],
  "properties": {
    "schema": {"const": "ananta.webrtc.media-publication.v1"},
    "publication_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "room_id": {"type": "string", "pattern": "^sfu-[a-f0-9]{32}$"},
    "participant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "membership_epoch": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "source": {"enum": ["microphone", "camera", "screen"]},
    "kind": {"enum": ["audio", "video"]},
    "privacy": {"enum": ["ordinary", "private_recovery"]},
    "status": {"enum": ["authorized", "active", "muted", "revoked", "ended"]},
    "audience_participant_id": {"type": ["string", "null"], "maxLength": 128},
    "authorized_subscriber_ids": {
      "type": "array", "maxItems": 8, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_bitrate_bps", "max_width", "max_height", "max_fps"],
      "properties": {
        "max_bitrate_bps": {"type": "integer", "minimum": 6000, "maximum": 8000000},
        "max_width": {"type": "integer", "minimum": 0, "maximum": 3840},
        "max_height": {"type": "integer", "minimum": 0, "maximum": 2160},
        "max_fps": {"type": "integer", "minimum": 0, "maximum": 60}
      }
    }
  }
}
