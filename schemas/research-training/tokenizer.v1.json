{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/research-training/tokenizer.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tokenizer_id", "algorithm", "artifact_digest", "dataset_manifest_digest", "vocab_size", "special_tokens", "normalizer"],
  "properties": {
    "schema": {"const": "ananta.research-training-tokenizer.v1"},
    "tokenizer_id": {"$ref": "#/$defs/id"},
    "algorithm": {"const": "byte_bpe_v1"},
    "artifact_digest": {"$ref": "#/$defs/digest"},
    "dataset_manifest_digest": {"$ref": "#/$defs/digest"},
    "vocab_size": {"type": "integer", "minimum": 256, "maximum": 1048576},
    "special_tokens": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "normalizer": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
