{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/research-training/run.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "spec_id", "tenant_id", "mode", "dataset_manifest_digest", "source_revision_digest", "recipe", "pipeline", "budget"],
  "properties": {
    "schema": {"const": "ananta.research-training-run.v1"},
    "spec_id": {"$ref": "#/$defs/id"},
    "tenant_id": {"$ref": "#/$defs/id"},
    "mode": {"enum": ["dry_run", "live"]},
    "dataset_manifest_digest": {"$ref": "#/$defs/digest"},
    "source_revision_digest": {"$ref": "#/$defs/digest"},
    "recipe": {"type": "object"},
    "pipeline": {"type": "object"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_hours", "storage_bytes", "estimated_cost_microunits"],
      "properties": {
        "gpu_hours": {"type": "number", "minimum": 0, "maximum": 100000},
        "storage_bytes": {"type": "integer", "minimum": 1, "maximum": 1125899906842624},
        "estimated_cost_microunits": {"type": "integer", "minimum": 0, "maximum": 1000000000000000}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
