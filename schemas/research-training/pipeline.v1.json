{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/research-training/pipeline.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pipeline_id", "pipeline_version", "stages", "automatic_release"],
  "properties": {
    "schema": {"const": "ananta.research-training-pipeline.v1"},
    "pipeline_id": {"$ref": "#/$defs/id"},
    "pipeline_version": {"$ref": "#/$defs/id"},
    "automatic_release": {"type": "boolean"},
    "stages": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/stage"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "kind", "dependencies", "required_capability", "max_attempts", "timeout_seconds"],
      "properties": {
        "stage_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["tokenizer_train", "tokenizer_eval", "pretrain", "base_eval", "sft", "chat_eval", "rl", "rl_eval", "inference_benchmark", "export"]},
        "dependencies": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "required_capability": {"$ref": "#/$defs/id"},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 604800}
      }
    }
  }
}
