{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/knowledge/knowledge_expert_runtime_capability.v1.json",
  "title": "Knowledge Expert Runtime Capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider_id", "provider_version", "base_model_digest", "tokenizer_digest", "architecture", "final_layer_name", "supported_target_modules", "dynamic_adapter_composition", "token_entropy", "kv_cache_safe_final_ffn", "atomic_expert_switch", "max_active_experts"],
  "properties": {
    "schema": {"const": "ananta.knowledge-expert-runtime-capability.v1"},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 192},
    "provider_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "base_model_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tokenizer_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "architecture": {"type": "string", "minLength": 1, "maxLength": 192},
    "final_layer_name": {"type": "string", "minLength": 1, "maxLength": 512},
    "supported_target_modules": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 192}},
    "dynamic_adapter_composition": {"type": "boolean"},
    "token_entropy": {"type": "boolean"},
    "kv_cache_safe_final_ffn": {"type": "boolean"},
    "atomic_expert_switch": {"type": "boolean"},
    "max_active_experts": {"type": "integer", "minimum": 1, "maximum": 64}
  }
}
