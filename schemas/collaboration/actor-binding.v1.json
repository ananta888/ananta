{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/collaboration/actor-binding.v1.json",
  "title": "WorkspaceActorBindingV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "actor_binding_id", "actor_kind", "authority_kind", "authority_subject", "display_name", "capabilities"],
  "properties": {
    "schema": {"const": "ananta.collaboration-actor-binding.v1"},
    "actor_binding_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "actor_kind": {"enum": ["human", "agent", "worker", "resource", "service", "external_actor"]},
    "authority_kind": {"enum": ["oidc", "hub_agent", "registered_worker", "resource_registry", "service", "bridge"]},
    "authority_subject": {"type": "string", "minLength": 1, "maxLength": 256},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "capabilities": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}}
  }
}
