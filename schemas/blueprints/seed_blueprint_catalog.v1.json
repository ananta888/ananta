{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/blueprints/seed_blueprint_catalog.v1.json",
  "title": "Seed Blueprint Catalog v1",
  "description": "Ananta blueprint catalog. A blueprint defines a team type, its roles, and the artifacts the team owns. Optionally a blueprint carries a deterministic workflow graph (workflow.steps) that the planner materializes into tasks. A blueprint without a workflow is treated as 'task-list' only and is fully supported for backward compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "blueprints"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "seed_blueprint_catalog.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "blueprints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/blueprint"
      }
    }
  },
  "$defs": {
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "roles", "artifacts"],
      "dependentRequired": {
        "key": [
          "version",
          "team_kind",
          "role_slots",
          "artifact_contracts",
          "workflow_ref",
          "policies",
          "capacity_defaults"
        ]
      },
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "base_team_type_name": {
          "type": ["string", "null"]
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "team_kind": {
          "type": "string",
          "enum": ["delivery", "research", "poc", "shared_service", "governance", "coordination"]
        },
        "role_slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/role_slot"
          }
        },
        "artifact_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact_contract"
          }
        },
        "workflow_ref": {
          "$ref": "#/$defs/versioned_ref"
        },
        "policies": {
          "type": "array",
          "items": { "$ref": "#/$defs/versioned_ref" },
          "uniqueItems": true
        },
        "capacity_defaults": {
          "$ref": "#/$defs/capacity_defaults"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "workflow": {
          "description": "Optional deterministic workflow graph. When present, the planner materializes steps as tasks in topological order; gates block downstream steps until approved.",
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "steps"],
          "properties": {
            "mode": {
              "description": "Workflow enforcement mode. 'off' skips materialization (artifacts-only). 'direct' materializes steps without gate enforcement. 'gated' (default for new blueprints) enforces gates. 'strict_gated' additionally blocks goal completion while any gate is pending.",
              "type": "string",
              "enum": ["off", "direct", "gated", "strict_gated"]
            },
            "default_failure_policy": {
              "description": "What to do when a gate check fails. 'block' (default) halts downstream steps; 'skip' marks downstream as skipped; 'manual' returns to operator for a human decision.",
              "type": "string",
              "enum": ["block", "skip", "manual"]
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/workflow_step"
              }
            }
          }
        }
      }
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "versioned_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*@[1-9][0-9]*$",
      "maxLength": 160
    },
    "role_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "role_template_ref",
        "required",
        "min_count",
        "default_count",
        "max_count",
        "assignment_policy",
        "separation_of_duties",
        "overlays"
      ],
      "properties": {
        "slot_id": { "$ref": "#/$defs/key" },
        "role_template_ref": { "$ref": "#/$defs/versioned_ref" },
        "required": { "type": "boolean" },
        "min_count": { "type": "integer", "minimum": 0 },
        "default_count": { "type": "integer", "minimum": 0 },
        "max_count": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "assignment_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal_kinds",
            "required_capabilities",
            "forbidden_capabilities",
            "write_access_required"
          ],
          "properties": {
            "principal_kinds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "enum": ["agent", "human"] },
              "uniqueItems": true
            },
            "required_capabilities": {
              "type": "array",
              "items": { "$ref": "#/$defs/key" },
              "uniqueItems": true
            },
            "forbidden_capabilities": {
              "type": "array",
              "items": { "$ref": "#/$defs/key" },
              "uniqueItems": true
            },
            "write_access_required": { "type": "boolean" }
          }
        },
        "separation_of_duties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enforcement", "independent_from_slot_ids"],
          "properties": {
            "enforcement": { "type": "string", "enum": ["none", "warn", "strict"] },
            "independent_from_slot_ids": {
              "type": "array",
              "items": { "$ref": "#/$defs/key" },
              "uniqueItems": true
            },
            "independent_from_external_duties": {
              "type": "array",
              "items": { "$ref": "#/$defs/key" },
              "uniqueItems": true
            }
          }
        },
        "overlays": {
          "type": "array",
          "items": { "$ref": "#/$defs/versioned_ref" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "required": { "const": true } }, "required": ["required"] },
          "then": { "properties": { "min_count": { "minimum": 1 } } }
        }
      ]
    },
    "capacity_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_agents", "default_agents", "max_agents"],
      "properties": {
        "min_agents": { "type": "integer", "minimum": 1 },
        "default_agents": { "type": "integer", "minimum": 1 },
        "max_agents": { "type": "integer", "minimum": 1 }
      }
    },
    "artifact_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "required", "portable"],
      "properties": {
        "kind": { "$ref": "#/$defs/key" },
        "required": { "type": "boolean" },
        "portable": { "type": "boolean" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "template_name", "sort_order", "is_required", "config"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "template_name": {
          "type": "string",
          "minLength": 1
        },
        "sort_order": {
          "type": "integer"
        },
        "is_required": {
          "type": "boolean"
        },
        "config": {
          "type": "object"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "description", "sort_order", "payload"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["task", "policy"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sort_order": {
          "type": "integer"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "workflow_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "task_kind"],
      "dependencies": {
        "gate": {
          "oneOf": [
            {
              "properties": {
                "gate": { "const": false }
              }
            },
            {
              "properties": {
                "gate": { "const": true },
                "checks": { "type": "object" }
              },
              "required": ["checks"]
            }
          ]
        }
      },
      "properties": {
        "id": {
          "description": "Local step id within the blueprint. Must be unique within a blueprint, lowercase, [a-z0-9_-]+.",
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "role": {
          "description": "Must match the name of a role in the same blueprint's roles array. Validated at reconciliation time.",
          "type": "string",
          "minLength": 1
        },
        "task_kind": {
          "description": "Maps to TaskDB.task_kind. 'gate_review' marks the step as a blocking gate.",
          "type": "string",
          "enum": ["planning", "coding", "review", "testing", "documentation", "gate_review", "handoff"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "produces": {
          "description": "Artifact titles this step is expected to produce. Used by WFG-016 artifact-flow enforcement.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "consumes": {
          "description": "Artifact titles this step requires. Used by WFG-016 artifact-flow enforcement.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "depends_on": {
          "description": "Step ids within the same blueprint that must complete before this step can start. Forms the DAG.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "uniqueItems": true
        },
        "gate": {
          "description": "Marks this step as a gate. Gates block downstream steps until their checks pass.",
          "type": "boolean",
          "default": false
        },
        "checks": {
          "description": "Required when gate=true. Defines deterministic checks the gate performs. Each check is evaluated against the step's produced artifacts and the blueprint's role/role-tasks.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_artifacts": {
              "type": "array",
              "description": "Artifact titles that MUST be present before the gate can pass.",
              "items": { "type": "string", "minLength": 1 }
            },
            "approval_role": {
              "type": "string",
              "description": "Role name whose assignment must approve the gate (e.g. 'scrum_master')."
            },
            "verification_required": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "failure_policy": {
          "description": "Per-step override of workflow.default_failure_policy.",
          "type": "string",
          "enum": ["block", "skip", "manual"]
        },
        "required_capabilities": {
          "description": "Additional capabilities the worker must have to execute this step. Merged with the role's defaults.",
          "type": "array",
          "items": { "type": "string" }
        },
        "sort_order": {
          "type": "integer",
          "default": 0
        }
      }
    }
  }
}
