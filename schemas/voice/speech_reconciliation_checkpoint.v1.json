{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/voice/speech_reconciliation_checkpoint.v1.json",
  "title": "Speech reconciliation checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "job_id", "attempt_id", "fencing_token_digest", "fencing_epoch", "consent_id", "consent_version", "revocation_epoch", "input_manifest_digest", "policy_digest", "ledger_sequence", "key_epoch", "checkpoint_digest", "checkpoint_ref", "checkpoint_sequence", "stage", "state_digest"],
  "properties": {
    "contract_version": {"const": "ananta.speech-reconciliation.v1"},
    "job_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"},
    "fencing_token_digest": {"$ref": "#/$defs/digest"},
    "fencing_epoch": {"$ref": "#/$defs/positive"},
    "consent_id": {"$ref": "#/$defs/id"}, "consent_version": {"$ref": "#/$defs/positive"},
    "revocation_epoch": {"$ref": "#/$defs/count"}, "input_manifest_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"}, "ledger_sequence": {"$ref": "#/$defs/count"},
    "key_epoch": {"$ref": "#/$defs/positive"}, "checkpoint_digest": {"$ref": "#/$defs/digest"},
    "checkpoint_ref": {"type": "string", "pattern": "^artifact://speech-reconciliation-checkpoints/[A-Za-z0-9_./:-]+$", "maxLength": 512},
    "checkpoint_sequence": {"$ref": "#/$defs/positive"}, "stage": {"$ref": "#/$defs/id"},
    "state_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
  }
}
