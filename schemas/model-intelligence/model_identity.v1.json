{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/model-intelligence/model_identity.v1.json",
  "title": "Ananta model-intelligence ModelIdentity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_id",
    "source",
    "locator",
    "revision",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "ananta.model-intelligence.model-identity.v1"
    },
    "model_id": {
      "type": "string",
      "pattern": "^model_[0-9a-f]{64}$"
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+@:/-]{0,511}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+@:/-]{0,127}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^x-[a-z0-9]+(?:[._-][a-z0-9]+){0,7}$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    }
  }
}
