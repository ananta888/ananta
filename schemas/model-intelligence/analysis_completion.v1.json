{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/model-intelligence/analysis_completion.v1.json",
  "title": "Ananta model-intelligence AnalysisCompletion v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "job_id",
    "lease_id",
    "lease_generation",
    "completion_key",
    "outcome",
    "artifacts",
    "error"
  ],
  "properties": {
    "schema": {"const": "ananta.model-intelligence.analysis-completion.v1"},
    "job_id": {"$ref": "#/$defs/identifier"},
    "lease_id": {"$ref": "#/$defs/identifier"},
    "lease_generation": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "completion_key": {"type": "string", "pattern": "^completion_[0-9a-f]{64}$"},
    "outcome": {"enum": ["succeeded", "failed", "cancelled"]},
    "artifacts": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "https://ananta.local/schemas/model-intelligence/artifact_ref.v1.json"
      }
    },
    "error": {
      "oneOf": [
        {"$ref": "https://ananta.local/schemas/model-intelligence/error_envelope.v1.json"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    }
  }
}
