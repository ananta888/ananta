{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/codecompass.sira-provenance.v1.json",
  "title": "CodeCompass SIRA corpus binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "scope",
    "repository_revision",
    "source_manifest_hash",
    "index_digest",
    "statistics_digest",
    "profile_version",
    "base_layer_id",
    "delta_layer_ids"
  ],
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "scope": {"type": "string", "minLength": 1, "maxLength": 256},
    "repository_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_manifest_hash": {"type": "string", "minLength": 1, "maxLength": 256},
    "index_digest": {"type": "string", "minLength": 1, "maxLength": 256},
    "statistics_digest": {"type": "string", "minLength": 1, "maxLength": 256},
    "profile_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "base_layer_id": {"type": "string", "maxLength": 256},
    "delta_layer_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}}
  }
}
