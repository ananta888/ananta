{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/planning/category_todo_quality_profile.v1.json",
  "title": "Planning Category Todo Quality Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_catalog_id",
    "source_catalog_hash",
    "allowed_source_refs",
    "allowed_run_refs",
    "claims",
    "grounding_status",
    "grounding_reason"
  ],
  "properties": {
    "schema": {
      "const": "category_todo_quality_profile.v1"
    },
    "source_catalog_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191
    },
    "source_catalog_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "allowed_source_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SRC_[0-9]{4}$"
      }
    },
    "allowed_run_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^RUN_[0-9]{4}$"
      }
    },
    "research_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "claim_type",
          "citation_refs",
          "confidence"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^CLM_[0-9]{4}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "type": "string",
            "enum": ["source_fact", "tool_result", "inference", "uncertain"]
          },
          "citation_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:SRC|RUN)_[0-9]{4}$"
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["verified", "partially_verified", "unverified"]
          },
          "expected_evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nonce": {"type": "integer"},
              "hash": {"type": "string"}
            }
          }
        }
      }
    },
    "unsupported_notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "grounding_status": {
      "type": "string",
      "enum": ["verified", "unverified", "failed"]
    },
    "grounding_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
