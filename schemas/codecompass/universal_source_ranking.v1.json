{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codecompass.universal-source-ranking.v1",
  "type": "object",
  "required": ["ranking_version", "profile_id", "profile_digest", "repository_revision", "index_digest", "partial_signals", "ranked"],
  "properties": {
    "ranking_version": {"const": "universal-source-ranking.v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repository_revision": {"type": "string"},
    "index_digest": {"type": "string"},
    "model_digest": {"type": ["string", "null"]},
    "partial_signals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "ranked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate", "score", "confidence", "file_role", "contributions", "tie_breaker"],
        "properties": {
          "score": {"type": "number"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "file_role": {"enum": ["production", "test", "fixture", "generated", "vendored", "documentation", "build_output", "unknown"]},
          "tie_breaker": {"type": "string"},
          "contributions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["signal", "raw_value", "normalized_value", "weight", "contribution", "evidence"],
              "properties": {
                "signal": {"type": "string"},
                "raw_value": {"type": "number"},
                "normalized_value": {"type": "number", "minimum": 0, "maximum": 1},
                "weight": {"type": "number"},
                "contribution": {"type": "number"},
                "evidence": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}
