{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/release/semantic_media_program_evidence.v1.json",
  "title": "Ananta Semantic Media Program Release Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision", "rollout_stage", "ordinary_call_action", "source_sha256", "config_sha256", "gates", "milestones", "tasks", "reason_codes"],
  "properties": {
    "schema": { "const": "ananta.semantic-media-program-release-evidence.v1" },
    "decision": { "enum": ["go", "no_go"] },
    "rollout_stage": { "enum": ["observe_only", "single_pair_opt_in", "trusted_small_group", "bounded_pilot", "general_opt_in"] },
    "ordinary_call_action": { "const": "preserve" },
    "source_sha256": { "$ref": "#/$defs/digest" },
    "config_sha256": { "$ref": "#/$defs/digest" },
    "reason_codes": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "gates": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/result" } },
    "milestones": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/result" } },
    "tasks": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/result" } }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reason_codes", "evidence_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["passed", "failed", "unverified"] },
        "reason_codes": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "evidence_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
