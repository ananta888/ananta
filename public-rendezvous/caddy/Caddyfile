keycloak.ananta.de {
	reverse_proxy keycloak:8080
}

webrtc.ananta.de {
	# Preserve Ananta's rendezvous/polling contract while the standalone
	# WebRTC room application owns the remaining paths, including /signal.
	@ananta_rendezvous {
		path /health /info /rendezvous /rendezvous/* /webrtc /webrtc/* /signaling /signaling/*
	}
	handle @ananta_rendezvous {
		reverse_proxy rendezvous:5000
	}
	handle {
		reverse_proxy https://minipc.ananta.de {
			header_up Host webrtc.ananta.de
		}
	}
}
