        "description": "Return the current Studio state.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {},
          "type": "object"
        },
        "name": "studio_status"
      },
      {
        "description": "Return the active training status.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {},
          "type": "object"
        },
        "name": "get_training_status"
      },
      {
        "description": "List bounded training runs.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            }
          },
          "type": "object"
        },
        "name": "list_training_runs"
      },
      {
        "description": "Stop the current training run.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "save": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "name": "stop_training"
      },
      {
