          },
          "required": [
            "job_id"
          ],
          "type": "object"
        },
        "name": "get_recipe_job_status"
      },
      {
        "description": "Return a bounded Data Recipe dataset page.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "job_id": {
              "type": "string"
            },
            "limit": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            }
          },
          "required": [
            "job_id"
          ],
          "type": "object"
        },
        "name": "get_recipe_job_dataset"
      }
