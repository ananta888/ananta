{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/generative-corrector-model-catalog.v1.json",
  "title": "Ananta generative transcript-corrector model catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": {
      "const": "ananta.generative-corrector-model-catalog.v1"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "revision", "family"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "revision": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$"
          },
          "family": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$"
          }
        }
      }
    }
  }
}
