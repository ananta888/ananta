{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/restricted-inference-manifest.v1.json",
  "title": "Ananta restricted inference model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "model_id",
    "engine",
    "format",
    "revision",
    "source_type",
    "license_id",
    "operations",
    "files",
    "trust_remote_code"
  ],
  "properties": {
    "schema_version": {"const": "restricted_model_manifest.v1"},
    "manifest_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,191}$"},
    "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,191}$"},
    "engine": {"enum": ["huggingface-transformers", "sentence-transformers", "onnxruntime", "pytorch"]},
    "format": {"enum": ["safetensors", "onnx"]},
    "revision": {"type": "string", "minLength": 7, "maxLength": 200},
    "source_type": {"enum": ["local_snapshot", "huggingface_snapshot"]},
    "license_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["embed", "classify", "rerank", "score_choices", "extract_features", "risk_score"]}
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "role": {"enum": ["weights", "tokenizer", "config", "labels", "external_data"]}
        }
      }
    },
    "trust_remote_code": {"const": false},
    "tokenizer": {"type": "string"},
    "device": {"type": "string", "pattern": "^(cpu|mps|cuda(:[0-9]{1,3})?)$"},
    "dtype": {"enum": ["float32", "float16", "bfloat16", "int8", "int4"]},
    "quantization": {"enum": ["none", "dynamic_int8", "bitsandbytes_int8", "bitsandbytes_int4"]},
    "ram_bytes": {"type": "integer", "minimum": 0},
    "vram_bytes": {"type": "integer", "minimum": 0},
    "max_batch_size": {"type": "integer", "minimum": 1, "maximum": 1024},
    "max_sequence_length": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "allow_cpu_fallback": {"type": "boolean"},
    "metadata": {"type": "object"}
  }
}
