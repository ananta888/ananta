{
  "vector_store": {
    "provider": "json",
    "availability": {
      "on_unavailable": "fail_fast",
      "fallback_provider": null
    },
    "json": {
      "index_path": ".rag/codecompass/vector_index.json"
    },
    "qdrant": {
      "endpoint": {
        "rest_url": "https://qdrant.example.test:6333",
        "grpc_url": "grpcs://qdrant-grpc.example.test:6334",
        "api_key_ref": "env://ANANTA_QDRANT_API_KEY",
        "allowed_origins": [
          "https://qdrant.example.test:6333",
          "grpcs://qdrant-grpc.example.test:6334"
        ],
        "external_calls_allowed": true,
        "connect_timeout_seconds": 3,
        "request_timeout_seconds": 10,
        "prefer_grpc": true,
        "tls_verify": true
      },
      "collection_prefix": "ananta",
      "collection_strategy": "workspace_repository_profile",
      "distance": "cosine",
      "rebuild_strategy": "versioned_collection_alias_swap",
      "schema_version": "qdrant_vector_store.v1",
      "retention_collections": 2,
      "store_embedding_text": false
    }
  },
  "_note": "Safe remote template: JSON remains active. Enabling Qdrant requires an authorized Hub override that changes provider after endpoint and secret policy validation."
}
