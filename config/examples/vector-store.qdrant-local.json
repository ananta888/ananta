{
  "vector_store": {
    "provider": "qdrant",
    "availability": {
      "on_unavailable": "degraded_empty",
      "fallback_provider": null
    },
    "json": {
      "index_path": ".rag/codecompass/vector_index.json"
    },
    "qdrant": {
      "endpoint": {
        "rest_url": "https://localhost:6333",
        "api_key_ref": "env://ANANTA_QDRANT_API_KEY",
        "tls_ca_cert_ref": "secretfile:///run/secrets/qdrant-tls-ca.pem",
        "allowed_origins": [
          "https://localhost:6333"
        ],
        "external_calls_allowed": false,
        "connect_timeout_seconds": 3,
        "request_timeout_seconds": 10,
        "prefer_grpc": false,
        "tls_verify": true
      },
      "collection_prefix": "ananta",
      "collection_strategy": "workspace_repository_profile",
      "distance": "cosine",
      "rebuild_strategy": "versioned_collection_alias_swap",
      "schema_version": "qdrant_vector_store.v1",
      "retention_collections": 2,
      "store_embedding_text": false
    }
  },
  "_note": "Local Qdrant remains opt-in, TLS-verified and REST-only by default. Host gRPC requires the explicit Compose gRPC overlay plus an explicitly allowlisted grpcs_url."
}
