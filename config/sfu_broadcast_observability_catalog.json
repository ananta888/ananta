{
  "$schema": "../schemas/webrtc/sfu_broadcast_observability_catalog.v1.json",
  "catalog_id": "ananta.sfu-broadcast-observability-catalog.v1",
  "version": "1.0",
  "decision_policy": {
    "unknown_metric_decision": "reject",
    "unknown_metric_reason_code": "sfu_observability_metric_not_registered",
    "unknown_label_decision": "reject",
    "unknown_label_reason_code": "sfu_observability_label_not_allowed",
    "forbidden_label_reason_code": "sfu_observability_forbidden_label",
    "invalid_label_value_reason_code": "sfu_observability_label_value_not_allowed",
    "missing_label_reason_code": "sfu_observability_required_label_missing",
    "small_cohort_decision": "suppress",
    "small_cohort_reason_code": "sfu_observability_small_cohort_suppressed"
  },
  "forbidden_data": [
    "media_payload",
    "semantic_payload",
    "transcript",
    "embedding",
    "encryption_key",
    "access_token",
    "credential",
    "full_sdp",
    "ice_candidate",
    "private_ip_address",
    "device_label",
    "original_identifier"
  ],
  "statistics_policy": {
    "required_statistics": [
      "p50",
      "p95",
      "p99",
      "peak"
    ],
    "percentile_method": "nearest_rank",
    "peak_definition": "maximum_observation_in_complete_window",
    "empty_window_decision": "suppress"
  },
  "pseudonymization": {
    "algorithm": "hmac-sha256",
    "scope": "metric_scope_and_rotation_window",
    "output_prefix": "sfb1",
    "truncation_bits": 96,
    "minimum_secret_bytes": 32
  },
