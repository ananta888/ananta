{
  "schema": "organization_policy_catalog.v1",
  "version": 1,
  "policies": [
    {"key": "assignment_grounding", "version": 1, "policy_type": "grounding", "accepted_ref_pattern": "^(SRC|RUN)_[0-9]{4}$", "origin": "hub_provided_assignment_manifest", "exact_allowlist_membership_required": true, "workers_may_create_identifiers": false, "missing_or_unknown_result": "unverified_or_failed"},
    {"key": "organization_limits", "version": 1, "policy_type": "limit_profile", "limit_profile_ref": "organization_limits@1", "revalidate_before_write": true},
    {"key": "organization_budget_defaults", "version": 1, "policy_type": "budget", "reservation_owner": "hub", "scope": ["organization", "team", "task", "provider"], "exhaustion_behavior": "block_and_review"},
    {"key": "test_only_small_organization", "version": 1, "policy_type": "admission", "test_only": true, "minimum_team_count": 2, "maximum_team_count": 3, "production_seed_allowed": false, "grant_binding_fields": ["payload_digest", "principal_id", "tenant_id", "project_id", "organization_id", "composition_digest", "policy_revision", "expires_at"], "single_use": true, "harness_mints_grant": true},
    {"key": "strict_delivery_separation", "version": 1, "policy_type": "separation_of_duties", "mode": "strict", "rules": [{"rule_id": "implementer_quality_reviewer", "left_duty": "implementer", "right_duty": "independent_reviewer", "strict": true}, {"rule_id": "security_author_security_approver", "left_duty": "security_change_author", "right_duty": "security_approver", "strict": true}]},
    {"key": "strict_research_separation", "version": 1, "policy_type": "separation_of_duties", "mode": "strict", "rules": [{"rule_id": "research_author_reviewer", "left_duty": "research_author", "right_duty": "independent_reviewer", "strict": true}]},
    {"key": "strict_poc_separation", "version": 1, "policy_type": "separation_of_duties", "mode": "strict", "rules": [{"rule_id": "prototype_author_evidence_reviewer", "left_duty": "prototype_author", "right_duty": "independent_reviewer", "strict": true}, {"rule_id": "prototype_author_security_approver", "left_duty": "prototype_author", "right_duty": "security_approver", "strict": true}]},
    {"key": "strict_platform_separation", "version": 1, "policy_type": "separation_of_duties", "mode": "strict", "rules": [{"rule_id": "change_author_release_executor", "left_duty": "implementer", "right_duty": "release_executor", "strict": true}, {"rule_id": "security_author_security_approver", "left_duty": "security_change_author", "right_duty": "security_approver", "strict": true}]},
    {"key": "strict_architecture_separation", "version": 1, "policy_type": "separation_of_duties", "mode": "strict", "rules": [{"rule_id": "adr_author_decision_reviewer", "left_duty": "decision_author", "right_duty": "independent_reviewer", "strict": true}]},
    {"key": "strict_release_separation", "version": 1, "policy_type": "separation_of_duties", "mode": "strict", "rules": [{"rule_id": "implementer_release_approver", "left_duty": "implementer", "right_duty": "go_no_go_approver", "strict": true}, {"rule_id": "release_executor_release_approver", "left_duty": "release_executor", "right_duty": "go_no_go_approver", "strict": true}]},
    {"key": "poc_non_production", "version": 1, "policy_type": "operation_approval", "operations": ["production_credentials", "production_connection", "production_deployment"], "default_decision": "deny", "hub_policy_required": true, "exact_approval_binding_required": true, "prompt_may_authorize": false},
    {"key": "platform_production_approval", "version": 1, "policy_type": "operation_approval", "operations": ["production_write", "production_admin", "deployment", "rollback"], "default_decision": "deny", "hub_policy_required": true, "exact_approval_binding_required": true, "prompt_may_authorize": false},
    {"key": "portfolio_decision_boundaries", "version": 1, "policy_type": "role_boundary", "allowed_decisions": ["product_goal", "portfolio_ordering", "allocation_proposal", "dependency_proposal", "release_outlook"], "forbidden_decisions": ["team_backlog_micromanagement", "worker_routing", "queue_write", "policy_mutation", "self_approval"], "orchestration_owner": "hub"},
    {"key": "evidence_verified", "version": 1, "policy_type": "acceptance_gate", "required_artifact_kinds": ["research_report", "source_manifest"], "allowed_decisions": ["accepted", "rejected", "needs_changes"], "self_approval_allowed": false},
    {"key": "poc_exit", "version": 1, "policy_type": "acceptance_gate", "required_artifact_kinds": ["poc_report", "benchmark_result", "decision_record"], "allowed_decisions": ["accepted", "rejected", "needs_changes"], "self_approval_allowed": false},
    {"key": "architecture_review", "version": 1, "policy_type": "acceptance_gate", "required_artifact_kinds": ["architecture_decision_record"], "allowed_decisions": ["accepted", "rejected", "needs_changes"], "self_approval_allowed": false},
    {"key": "operational_readiness", "version": 1, "policy_type": "acceptance_gate", "required_artifact_kinds": ["deployment_plan", "rollback_plan", "observability_plan"], "allowed_decisions": ["pass", "conditional_pass", "rejected", "needs_human_approval"], "self_approval_allowed": false},
    {"key": "release_approval", "version": 1, "policy_type": "acceptance_gate", "required_artifact_kinds": ["quality_report", "security_report", "release_evidence"], "allowed_decisions": ["pass", "conditional_pass", "rejected", "needs_human_approval"], "self_approval_allowed": false},
    {"key": "lean_direction_goal_accepted", "version": 1, "policy_type": "acceptance_gate", "required_artifact_kinds": ["company_goal", "priority_decision", "accepted_requirements"], "allowed_decisions": ["accepted", "rejected", "needs_changes"], "self_approval_allowed": false},
    {"key": "lean_delivery_need_accepted", "version": 1, "policy_type": "acceptance_gate", "required_artifact_kinds": ["delivery_need"], "allowed_decisions": ["accepted", "rejected", "needs_changes"], "self_approval_allowed": false},
    {"key": "lean_discovery_evidence_accepted", "version": 1, "policy_type": "acceptance_gate", "required_artifact_kinds": ["evidence_review", "accepted_requirements"], "allowed_decisions": ["accepted", "rejected", "needs_changes"], "self_approval_allowed": false},
    {"key": "lean_enablement_readiness_accepted", "version": 1, "policy_type": "acceptance_gate", "required_artifact_kinds": ["operational_readiness", "security_evidence"], "allowed_decisions": ["accepted", "pass", "conditional_pass", "rejected", "needs_changes"], "self_approval_allowed": false}
  ]
}
