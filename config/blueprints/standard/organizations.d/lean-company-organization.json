      "parameter_overrides": {"composition_mode": "standard", "team_count": 5},
      "expected_team_blueprint_counts": {"lean_company_direction": 1, "lean_delivery_cell": 2, "lean_discovery": 1, "lean_enablement": 1},
      "expected_total_team_count": 5,
