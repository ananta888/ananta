{
  "schema": "organization_blueprint_fragment.v1",
  "organization_blueprints": [
    {
      "key": "lean_company_organization",
      "version": 1,
      "description": "Small-company organization family with five to twenty explicit role slots across two to six Hub-routed teams.",
      "profile": {
        "family": "lean_company",
        "label": "Lean Company",
        "sizes": [
          {"team_count": 2, "label": "Mikro · 5 Rollenplätze"},
          {"team_count": 3, "label": "Klein · 8 Rollenplätze"},
          {"team_count": 4, "label": "Kompakt · 12 Rollenplätze"},
          {"team_count": 5, "label": "Wachsend · 16 Rollenplätze"},
          {"team_count": 6, "label": "Ausgebaut · 20 Rollenplätze"}
        ]
      },
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "discriminator": "composition_mode",
        "oneOf": [
          {
            "properties": {
              "composition_mode": {"const": "standard"},
              "team_count": {"type": "integer", "minimum": 2, "maximum": 6}
            },
            "required": ["composition_mode", "team_count"],
            "not": {
              "anyOf": [
                {"required": ["custom_composition"]},
                {"required": ["admission_exception_ref"]}
              ]
            }
          },
          {
            "properties": {
              "composition_mode": {"const": "custom"},
              "custom_composition": {
                "type": "object",
                "additionalProperties": false,
                "required": ["team_blueprint_counts"],
                "properties": {
                  "team_blueprint_counts": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {"type": "integer", "minimum": 1}
                  }
                }
              },
              "admission_exception_ref": {"type": "string", "minLength": 1}
            },
            "required": ["composition_mode", "custom_composition", "admission_exception_ref"],
            "not": {"required": ["team_count"]}
          }
        ]
      },
      "standard_composition": {
        "team_count_range": {"minimum": 2, "default": 4, "maximum": 6},
        "baseline_singleton_team_refs": ["lean_direction"],
        "baseline_group_counts": {"delivery_cell": 1},
        "activation_order": ["lean_discovery", "lean_enablement"],
        "scale_out_group": "delivery_cell"
      },
      "unit_groups": [
        {
          "group_id": "delivery_cell",
          "team_blueprint_ref": "lean_delivery_cell@1",
          "parent_unit_ref": "product_delivery",
          "min_count": 1,
          "default_count": 1,
          "max_count": null,
          "capacity_rule": {"formula": "effective_max_team_instances_minus_active_singleton_teams", "minimum_remaining": 1},
          "limit_policy_ref": "organization_limits@1",
          "naming_policy": "stable_group_ordinal",
          "overrides": {}
        }
      ],
      "units": [
        {"unit_key": "lean_company", "unit_kind": "coordination_unit", "materialization_kind": "structural_unit", "parent_unit_ref": null, "activation_policy": "always"},
        {"unit_key": "company_direction", "unit_kind": "value_stream", "materialization_kind": "structural_unit", "parent_unit_ref": "lean_company", "activation_policy": "always"},
        {"unit_key": "product_delivery", "unit_kind": "value_stream", "materialization_kind": "structural_unit", "parent_unit_ref": "lean_company", "activation_policy": "always"},
        {"unit_key": "company_enablement", "unit_kind": "value_stream", "materialization_kind": "structural_unit", "parent_unit_ref": "lean_company", "activation_policy": "always"},
        {"unit_key": "lean_direction", "unit_kind": "team", "materialization_kind": "team_instance", "team_blueprint_ref": "lean_company_direction@1", "parent_unit_ref": "company_direction", "activation_policy": "baseline"},
        {"unit_key": "lean_discovery", "unit_kind": "team", "materialization_kind": "team_instance", "team_blueprint_ref": "lean_discovery@1", "parent_unit_ref": "company_direction", "activation_policy": "ordered_optional"},
        {"unit_key": "lean_enablement", "unit_kind": "team", "materialization_kind": "team_instance", "team_blueprint_ref": "lean_enablement@1", "parent_unit_ref": "company_enablement", "activation_policy": "ordered_optional"}
      ],
      "relations": [
        {"relation_id": "direction_governs_delivery", "namespace": "organization", "source_unit_ref": "lean_direction", "target_unit_ref": "product_delivery", "kind": "governs", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": "lean_direction_goal_handoff@1", "dependency_policy": "declared", "escalation_policy": "hub"},
        {"relation_id": "direction_governs_discovery", "namespace": "organization", "source_unit_ref": "lean_direction", "target_unit_ref": "lean_discovery", "kind": "governs", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": "lean_direction_goal_handoff@1", "dependency_policy": "declared", "escalation_policy": "hub"},
        {"relation_id": "direction_governs_enablement", "namespace": "organization", "source_unit_ref": "lean_direction", "target_unit_ref": "lean_enablement", "kind": "governs", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": "lean_direction_goal_handoff@1", "dependency_policy": "declared", "escalation_policy": "hub"},
        {"relation_id": "delivery_requests_enablement", "namespace": "organization", "source_unit_ref": "product_delivery", "target_unit_ref": "lean_enablement", "kind": "declared_dependency", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": "lean_delivery_need_handoff@1", "dependency_policy": "declared", "escalation_policy": "hub"},
        {"relation_id": "discovery_supplies_delivery", "namespace": "organization", "source_unit_ref": "lean_discovery", "target_unit_ref": "product_delivery", "kind": "supplies_research_to", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": "lean_discovery_evidence_handoff@1", "dependency_policy": "declared", "escalation_policy": "hub"},
        {"relation_id": "enablement_supports_delivery", "namespace": "organization", "source_unit_ref": "lean_enablement", "target_unit_ref": "product_delivery", "kind": "enables", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": "lean_enablement_readiness_handoff@1", "dependency_policy": "advisory", "escalation_policy": "hub"}
      ],
      "shared_product_model": {"goal_scope": "organization", "team_backlogs": "derived"},
      "orchestration": {"owner": "hub", "workers_may_orchestrate": false},
      "governance": {"admission_policy": "standard_or_explicit_custom", "separation_of_duties": "strict"},
      "budgets": {"policy_ref": "organization_budget_defaults@1"},
      "limit_policy_ref": "organization_limits@1"
    }
  ],
  "handoff_definitions": [
    {
      "key": "lean_direction_goal_handoff",
      "version": 1,
      "required_artifact_kinds": ["company_goal", "priority_decision", "accepted_requirements"],
      "acceptance_gate_ref": "lean_direction_goal_accepted@1",
      "artifact_source": "workflow_step_outputs"
    },
    {
      "key": "lean_delivery_need_handoff",
      "version": 1,
      "required_artifact_kinds": ["delivery_need"],
      "acceptance_gate_ref": "lean_delivery_need_accepted@1",
      "artifact_source": "workflow_step_outputs"
    },
    {
      "key": "lean_discovery_evidence_handoff",
      "version": 1,
      "required_artifact_kinds": ["evidence_review", "accepted_requirements"],
      "acceptance_gate_ref": "lean_discovery_evidence_accepted@1",
      "artifact_source": "workflow_step_outputs"
    },
    {
      "key": "lean_enablement_readiness_handoff",
      "version": 1,
      "required_artifact_kinds": ["operational_readiness", "security_evidence"],
      "acceptance_gate_ref": "lean_enablement_readiness_accepted@1",
      "artifact_source": "workflow_step_outputs"
    }
  ],
  "acceptance_fixtures": [
