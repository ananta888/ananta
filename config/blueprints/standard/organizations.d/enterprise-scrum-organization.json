{
  "schema": "organization_blueprint_fragment.v1",
  "metadata": {
    "catalog_key": "enterprise_scrum_organization_catalog",
    "catalog_version": 1,
    "description": "Standard organization fragment for five to ten teams, one full eight-team acceptance reference and bounded test-only two/three-team compositions.",
    "orchestration_owner": "hub",
    "portable_references": true
  },
  "organization_blueprints": [
    {
      "key": "enterprise_scrum_organization",
      "version": 1,
      "description": "Data-driven Scrum organization with a five-to-ten standard band and an admitted custom N-team composition.",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "discriminator": "composition_mode",
        "oneOf": [
          {
            "properties": {
              "composition_mode": {"const": "standard"},
              "team_count": {"type": "integer", "minimum": 5, "maximum": 10}
            },
            "required": ["composition_mode", "team_count"],
            "not": {
              "anyOf": [
                {"required": ["custom_composition"]},
                {"required": ["admission_exception_ref"]}
              ]
            }
          },
          {
            "properties": {
              "composition_mode": {"const": "custom"},
              "custom_composition": {
                "type": "object",
                "additionalProperties": false,
                "required": ["team_blueprint_counts"],
                "properties": {
                  "team_blueprint_counts": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {"type": "integer", "minimum": 1}
                  }
                }
              },
              "admission_exception_ref": {"type": "string", "minLength": 1}
            },
            "required": ["composition_mode", "custom_composition", "admission_exception_ref"],
            "not": {"required": ["team_count"]}
          }
        ]
      },
      "standard_composition": {
        "team_count_range": {"minimum": 5, "default": 8, "maximum": 10},
        "baseline_singleton_team_refs": ["portfolio_product_coordination", "research_and_discovery", "platform_devops_sre"],
        "baseline_group_counts": {"product_delivery": 2},
        "activation_order": ["quality_security_release", "architecture_governance", "proof_of_concept"],
        "scale_out_group": "product_delivery"
      },
      "unit_groups": [
        {
          "group_id": "product_delivery",
          "team_blueprint_ref": "enterprise_product_delivery_scrum@1",
          "parent_unit_ref": "delivery_value_stream",
          "min_count": 1,
          "default_count": 2,
          "max_count": null,
          "capacity_rule": {"formula": "effective_max_team_instances_minus_active_singleton_teams", "minimum_remaining": 1},
          "limit_policy_ref": "organization_limits@1",
          "naming_policy": "stable_group_ordinal",
          "overrides": {}
        }
      ],
      "units": [
        {"unit_key": "enterprise_portfolio", "unit_kind": "coordination_unit", "materialization_kind": "structural_unit", "parent_unit_ref": null, "activation_policy": "always"},
        {"unit_key": "discovery_value_stream", "unit_kind": "value_stream", "materialization_kind": "structural_unit", "parent_unit_ref": "enterprise_portfolio", "activation_policy": "always"},
        {"unit_key": "delivery_value_stream", "unit_kind": "value_stream", "materialization_kind": "structural_unit", "parent_unit_ref": "enterprise_portfolio", "activation_policy": "always"},
        {"unit_key": "enablement_value_stream", "unit_kind": "value_stream", "materialization_kind": "structural_unit", "parent_unit_ref": "enterprise_portfolio", "activation_policy": "always"},
        {"unit_key": "portfolio_product_coordination", "unit_kind": "team", "materialization_kind": "team_instance", "team_blueprint_ref": "portfolio_product_coordination@1", "parent_unit_ref": "enterprise_portfolio", "activation_policy": "baseline"},
        {"unit_key": "research_and_discovery", "unit_kind": "team", "materialization_kind": "team_instance", "team_blueprint_ref": "research_and_discovery@1", "parent_unit_ref": "discovery_value_stream", "activation_policy": "baseline"},
        {"unit_key": "proof_of_concept", "unit_kind": "team", "materialization_kind": "team_instance", "team_blueprint_ref": "proof_of_concept@1", "parent_unit_ref": "discovery_value_stream", "activation_policy": "ordered_optional"},
        {"unit_key": "platform_devops_sre", "unit_kind": "team", "materialization_kind": "team_instance", "team_blueprint_ref": "platform_devops_sre@1", "parent_unit_ref": "enablement_value_stream", "activation_policy": "baseline"},
        {"unit_key": "quality_security_release", "unit_kind": "team", "materialization_kind": "team_instance", "team_blueprint_ref": "quality_security_release@1", "parent_unit_ref": "enablement_value_stream", "activation_policy": "ordered_optional"},
        {"unit_key": "architecture_governance", "unit_kind": "team", "materialization_kind": "team_instance", "team_blueprint_ref": "architecture_governance@1", "parent_unit_ref": "enablement_value_stream", "activation_policy": "ordered_optional"}
      ],
      "relations": [
        {"relation_id": "portfolio_governs_discovery", "namespace": "organization", "source_unit_ref": "portfolio_product_coordination", "target_unit_ref": "discovery_value_stream", "kind": "governs", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": null, "dependency_policy": "advisory", "escalation_policy": "portfolio"},
        {"relation_id": "portfolio_governs_delivery", "namespace": "organization", "source_unit_ref": "portfolio_product_coordination", "target_unit_ref": "delivery_value_stream", "kind": "governs", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": null, "dependency_policy": "advisory", "escalation_policy": "portfolio"},
        {"relation_id": "portfolio_governs_enablement", "namespace": "organization", "source_unit_ref": "portfolio_product_coordination", "target_unit_ref": "enablement_value_stream", "kind": "governs", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": null, "dependency_policy": "advisory", "escalation_policy": "portfolio"},
        {"relation_id": "research_supplies_poc", "namespace": "organization", "source_unit_ref": "research_and_discovery", "target_unit_ref": "proof_of_concept", "kind": "supplies_research_to", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": "research_evidence_handoff@1", "dependency_policy": "declared", "escalation_policy": "portfolio"},
        {"relation_id": "poc_prototypes_for_delivery", "namespace": "organization", "source_unit_ref": "proof_of_concept", "target_unit_ref": "delivery_value_stream", "kind": "prototypes_for", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": "poc_decision_handoff@1", "dependency_policy": "declared", "escalation_policy": "portfolio"},
        {"relation_id": "architecture_reviews_delivery", "namespace": "organization", "source_unit_ref": "architecture_governance", "target_unit_ref": "delivery_value_stream", "kind": "reviews", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": "architecture_decision_handoff@1", "dependency_policy": "gate", "escalation_policy": "architecture"},
        {"relation_id": "platform_enables_delivery", "namespace": "organization", "source_unit_ref": "platform_devops_sre", "target_unit_ref": "delivery_value_stream", "kind": "enables", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": "platform_readiness_handoff@1", "dependency_policy": "declared", "escalation_policy": "operations"},
        {"relation_id": "quality_releases_delivery", "namespace": "organization", "source_unit_ref": "quality_security_release", "target_unit_ref": "delivery_value_stream", "kind": "releases_for", "activation_condition": "both_endpoints_materialized", "handoff_contract_ref": "release_gate_handoff@1", "dependency_policy": "gate", "escalation_policy": "release"}
      ],
      "shared_product_model": {"goal_scope": "organization", "team_backlogs": "derived"},
      "orchestration": {"owner": "hub", "workers_may_orchestrate": false},
      "governance": {"admission_policy": "standard_or_explicit_custom", "separation_of_duties": "strict"},
      "budgets": {"policy_ref": "organization_budget_defaults@1"},
      "limit_policy_ref": "organization_limits@1"
    }
  ],
  "handoff_definitions": [
    {"key": "research_evidence_handoff", "version": 1, "required_artifact_kinds": ["research_report", "source_manifest"], "acceptance_gate_ref": "evidence_verified@1"},
    {"key": "poc_decision_handoff", "version": 1, "required_artifact_kinds": ["poc_report", "benchmark_result", "decision_record"], "acceptance_gate_ref": "poc_exit@1"},
    {"key": "architecture_decision_handoff", "version": 1, "required_artifact_kinds": ["architecture_decision_record"], "acceptance_gate_ref": "architecture_review@1"},
    {"key": "platform_readiness_handoff", "version": 1, "required_artifact_kinds": ["deployment_plan", "rollback_plan", "observability_plan"], "acceptance_gate_ref": "operational_readiness@1"},
    {"key": "release_gate_handoff", "version": 1, "required_artifact_kinds": ["quality_report", "security_report", "release_evidence"], "acceptance_gate_ref": "release_approval@1"}
  ],
