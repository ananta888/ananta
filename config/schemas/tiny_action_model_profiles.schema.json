{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta.local/schemas/tiny_action_model_profiles.v1.json",
  "title": "Ananta tiny action-model profile catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profiles"],
  "properties": {
    "schema": {"const": "ananta.tiny_action_model_profiles.v1"},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id", "model_id", "tier", "adapter", "dialect",
          "license_id", "source_url", "commercial_use_allowed",
          "research_only", "supports_confidence", "supports_parallel_tools",
          "max_tools", "context_window", "min_confidence"
        ],
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "model_id": {"type": "string", "minLength": 1},
          "tier": {"enum": ["tiny", "small"]},
          "adapter": {"enum": ["needle", "openai_compatible"]},
          "dialect": {"enum": ["needle", "openai", "functiongemma", "xlam"]},
          "license_id": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"},
          "commercial_use_allowed": {"type": "boolean"},
          "research_only": {"type": "boolean"},
          "supports_confidence": {"type": "boolean"},
          "supports_parallel_tools": {"type": "boolean"},
          "max_tools": {"type": "integer", "minimum": 1, "maximum": 100},
          "context_window": {"type": "integer", "minimum": 1},
          "min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "local_only": {"type": "boolean"},
          "enabled_by_default": {"const": false},
          "artifact_sha256": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
          "metadata": {"type": "object"}
        }
      }
    }
  }
}
