FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/evolver-bridge

COPY services/evolver_bridge/package.json /opt/evolver-bridge/package.json
COPY services/evolver_bridge/server.js /opt/evolver-bridge/server.js

RUN npm install

RUN git clone https://github.com/EvoMap/evolver.git /opt/evolver-src \
    && cd /opt/evolver-src \
    && npm install

EXPOSE 8080

CMD ["node", "server.js"]
