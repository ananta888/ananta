FROM python:3.11.15-slim-bookworm@sha256:9c6f90801e6b68e772b7c0ca74260cbf7af9f320acec894e26fccdaccfbe3b47 AS base

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/tmp/model-cache \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    GENERATIVE_CORRECTOR_HOST=0.0.0.0 \
    GENERATIVE_CORRECTOR_PORT=8093

RUN groupadd --gid 10004 ananta-corrector \
    && useradd --uid 10004 --gid 10004 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin ananta-corrector

WORKDIR /app

COPY docker/compose-next/requirements.runtime-http.txt /tmp/requirements.runtime-http.txt
RUN pip install --no-cache-dir --requirement /tmp/requirements.runtime-http.txt \
    && rm /tmp/requirements.runtime-http.txt

# This image contains one execution-only worker. It has no Hub, task queue, or
# worker-discovery client and loads models exclusively from the read-only mount.
COPY --chown=10004:10004 ananta_contracts /app/ananta_contracts
COPY --chown=10004:10004 worker/__init__.py /app/worker/__init__.py
COPY --chown=10004:10004 worker/runtime/__init__.py /app/worker/runtime/__init__.py
COPY --chown=10004:10004 worker/runtime/generative_corrector_engine.py /app/worker/runtime/generative_corrector_engine.py
COPY --chown=10004:10004 worker/runtime/generative_corrector_provider_engine.py /app/worker/runtime/generative_corrector_provider_engine.py
COPY --chown=10004:10004 worker/runtime/generative_corrector_app.py /app/worker/runtime/generative_corrector_app.py

USER 10004:10004
EXPOSE 8093

HEALTHCHECK --interval=15s --timeout=4s --start-period=15s --retries=5 \
    CMD ["python", "-c", "import json, urllib.request; payload=json.load(urllib.request.urlopen('http://127.0.0.1:8093/health', timeout=3)); raise SystemExit(0 if payload.get('status') == 'ready' else 1)"]

CMD ["python", "-m", "worker.runtime.generative_corrector_app"]


FROM base AS cpu

USER root
COPY docker/compose-next/requirements.generative-corrector-cpu.txt /tmp/requirements.generative-corrector-cpu.txt
RUN pip install --no-cache-dir --requirement /tmp/requirements.generative-corrector-cpu.txt \
    && rm /tmp/requirements.generative-corrector-cpu.txt
USER 10004:10004
