FROM python:3.11.15-slim-bookworm@sha256:9c6f90801e6b68e772b7c0ca74260cbf7af9f320acec894e26fccdaccfbe3b47

ARG TEMPORALIO_VERSION=1.30.0

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/examples/workflow-runtime

RUN groupadd --gid 10001 ananta \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin ananta

WORKDIR /app

COPY requirements.lock /tmp/requirements.lock
COPY docker/compose-next/requirements.langgraph-worker.lock /tmp/requirements.langgraph-worker.lock
RUN pip install --no-cache-dir -r /tmp/requirements.lock \
    && pip install --no-cache-dir \
        -r /tmp/requirements.langgraph-worker.lock \
        "temporalio==${TEMPORALIO_VERSION}" \
    && python -c "from importlib.metadata import version; assert version('langgraph') == '0.2.76'; assert version('langchain-core') == '0.3.86'; assert version('packaging') == '25.0'; assert version('temporalio') == '${TEMPORALIO_VERSION}'" \
    && pip check

COPY --chown=10001:10001 . /app
RUN mkdir -p /evidence && chown 10001:10001 /evidence

USER 10001:10001

ENTRYPOINT ["python", "/app/examples/workflow-runtime/run_example.py"]
CMD ["--mode", "prepare"]
