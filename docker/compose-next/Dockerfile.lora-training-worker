FROM python:3.11.15-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba AS base

ENV HF_DATASETS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HUB_OFFLINE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=600 \
    PIP_NO_CACHE_DIR=1 \
    PIP_RETRIES=8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TRANSFORMERS_OFFLINE=1 \
    ANANTA_LORA_TRAINING_HOST=0.0.0.0 \
    ANANTA_LORA_TRAINING_PORT=8095

RUN groupadd --gid 10005 ananta-training \
    && useradd --uid 10005 --gid 10005 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin ananta-training \
    && install -d -o 10005 -g 10005 -m 0750 /var/lib/ananta-lora \
    && install -d -o 10005 -g 10005 -m 0750 /models/base /project-workspaces

WORKDIR /app

COPY docker/compose-next/requirements.runtime-http.txt /tmp/requirements.runtime-http.txt
COPY docker/compose-next/requirements.lora-training-runtime.txt /tmp/requirements.lora-training-runtime.txt
RUN pip install --no-cache-dir --requirement /tmp/requirements.lora-training-runtime.txt \
    && rm /tmp/requirements.lora-training-runtime.txt /tmp/requirements.runtime-http.txt

# This image intentionally contains no Hub package, database repository,
# routing code, task queue, frontend, or provider credentials.
COPY --chown=10005:10005 ananta_contracts /app/ananta_contracts
COPY --chown=10005:10005 worker/__init__.py /app/worker/__init__.py
COPY --chown=10005:10005 worker/runtime/__init__.py /app/worker/runtime/__init__.py
COPY --chown=10005:10005 worker/runtime/lora_training_app.py /app/worker/runtime/lora_training_app.py
COPY --chown=10005:10005 worker/training /app/worker/training

USER 10005:10005
EXPOSE 8095

HEALTHCHECK --interval=15s --timeout=4s --start-period=20s --retries=5 \
    CMD ["python", "-c", "import json,os,urllib.request; r=urllib.request.Request('http://127.0.0.1:8095/health',headers={'Authorization':'Bearer '+os.environ['ANANTA_LORA_TRAINING_TOKEN']}); p=json.load(urllib.request.urlopen(r,timeout=3)); raise SystemExit(0 if p.get('status')=='ready' and p.get('auth_configured') is True and p.get('runtime_configured') is True else 1)"]

CMD ["python", "-m", "worker.runtime.lora_training_app"]


# Dependency-light smoke/CI worker. It exercises the complete async protocol,
# persistence, cancellation and artifact flow without loading an ML framework.
FROM base AS minimal


FROM base AS cpu

USER root
COPY docker/compose-next/requirements.lora-training-cpu.txt /tmp/requirements.lora-training-cpu.txt
RUN pip install --no-cache-dir --requirement /tmp/requirements.lora-training-cpu.txt \
    && rm /tmp/requirements.lora-training-cpu.txt
USER 10005:10005


# GGUF export is deliberately assembled at image-build time. Runtime workers
# have no network and a read-only root, so allowing Unsloth to clone/build a
# mutable llama.cpp checkout during a training assignment would be both
# non-reproducible and impossible under the worker security profile.
FROM python:3.11.15-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba AS llama-cpp-builder

RUN apt-get update \
    && apt-get install --yes --no-install-recommends build-essential ca-certificates cmake \
    && rm -rf /var/lib/apt/lists/*

ADD --checksum=sha256:9c2948aa9c79c92dd0e4c98e11ff5cf76dfdcaebdeb18e3e93409e9a98aefdab \
    https://codeload.github.com/ggml-org/llama.cpp/tar.gz/refs/tags/v0.4.0 \
    /tmp/llama-cpp.tar.gz

RUN mkdir /tmp/llama-cpp-source \
    && tar --extract --gzip --file /tmp/llama-cpp.tar.gz --directory /tmp/llama-cpp-source --strip-components=1 \
    && cmake -S /tmp/llama-cpp-source -B /tmp/llama-cpp-build \
        -DBUILD_SHARED_LIBS=OFF \
        -DGGML_NATIVE=OFF \
        -DLLAMA_BUILD_EXAMPLES=OFF \
        -DLLAMA_BUILD_SERVER=OFF \
        -DLLAMA_BUILD_TESTS=OFF \
        -DLLAMA_BUILD_TOOLS=ON \
    && cmake --build /tmp/llama-cpp-build --target llama-quantize --parallel 8 \
    && install -d -m 0755 /opt/llama.cpp \
    && install -m 0755 /tmp/llama-cpp-build/bin/llama-quantize /opt/llama.cpp/llama-quantize \
    && install -m 0755 /tmp/llama-cpp-source/convert_hf_to_gguf.py /opt/llama.cpp/convert_hf_to_gguf.py \
    && cp -a /tmp/llama-cpp-source/conversion /tmp/llama-cpp-source/gguf-py /opt/llama.cpp/ \
    && printf '%s\n' '{"repository":"ggml-org/llama.cpp","tag":"v0.4.0","source_sha256":"9c2948aa9c79c92dd0e4c98e11ff5cf76dfdcaebdeb18e3e93409e9a98aefdab"}' \
        > /opt/llama.cpp/UNSLOTH_PREBUILT_INFO.json


# NVIDIA is a sibling of the CPU target, preventing CPU torch wheel leakage.
FROM base AS nvidia

USER root
COPY docker/compose-next/requirements.lora-training-nvidia.txt /tmp/requirements.lora-training-nvidia.txt
RUN apt-get update \
    && apt-get install --yes --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --requirement /tmp/requirements.lora-training-nvidia.txt \
    && rm /tmp/requirements.lora-training-nvidia.txt
COPY --from=llama-cpp-builder --chown=10005:10005 /opt/llama.cpp /opt/llama.cpp
COPY --chmod=0555 docker/compose-next/lora-training-worker-entrypoint.sh /usr/local/bin/lora-training-worker-entrypoint
ENV NVIDIA_REQUIRE_CUDA="cuda>=12.4" \
    ANANTA_UNSLOTH_LLAMA_CPP_SOURCE=/opt/llama.cpp \
    UNSLOTH_LLAMA_CPP_PATH=/tmp/ananta-unsloth/llama.cpp
ARG SOURCE_REVISION=unbound
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}"
USER 10005:10005
ENTRYPOINT ["/usr/local/bin/lora-training-worker-entrypoint"]
