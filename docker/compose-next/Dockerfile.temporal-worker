FROM python:3.11.15-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba

ARG TEMPORALIO_VERSION=1.30.0
ARG CRYPTOGRAPHY_VERSION=46.0.7
ARG JSONSCHEMA_VERSION=4.26.0
ARG PYDANTIC_VERSION=2.13.2

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

RUN groupadd --gid 10001 ananta \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin ananta

WORKDIR /app

RUN pip install --no-cache-dir \
    "temporalio==${TEMPORALIO_VERSION}" \
    "cryptography==${CRYPTOGRAPHY_VERSION}" \
    "jsonschema==${JSONSCHEMA_VERSION}" \
    "pydantic==${PYDANTIC_VERSION}"

COPY ananta_contracts/ /app/ananta_contracts/
COPY worker/__init__.py /app/worker/__init__.py
COPY worker/temporal/ /app/worker/temporal/

USER 10001:10001

EXPOSE 8088

ENTRYPOINT ["python", "-m", "worker.temporal"]
