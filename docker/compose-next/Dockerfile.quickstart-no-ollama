FROM docker:29.4.3-cli@sha256:51e23845f5caff1e688a2fae003b0c69d635c9200ad544731db1593731df1d3a AS docker_cli
FROM node:24.18.0-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS node_runtime
FROM python:3.11.15-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba

# Aktives Compose-next-Runtime-Image. Build-Kontext ist das Repository-Root:
# docker build -f docker/compose-next/Dockerfile.quickstart-no-ollama \
#   -t ananta-quickstart-no-ollama:local .

ARG DEBIAN_SNAPSHOT=20260715T000000Z
ARG INSTALL_LANGGRAPH_RUNTIME=0
ARG INSTALL_QDRANT_RUNTIME=0
ARG ANANTA_RUNTIME_UID=1000
ARG ANANTA_RUNTIME_GID=1000

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    OPENCODE_AI_VERSION=1.14.18

# Installiere System-Abhaengigkeiten aus einem festen Debian-Snapshot.
RUN printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99snapshot \
    && printf '%s\n' \
        'Types: deb' \
        "URIs: http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}" \
        'Suites: bookworm bookworm-updates' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        '' \
        'Types: deb' \
        "URIs: http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}" \
        'Suites: bookworm-security' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        > /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    curl \
    net-tools \
    iputils-ping \
    traceroute \
    tmux \
    git \
    && rm -rf /var/lib/apt/lists/*

# The development stack runs Python processes as the WSL owner. Keep a real
# passwd/group identity in the image so subprocesses and third-party CLIs can
# resolve that numeric identity instead of failing on getpwuid()/whoami.
RUN case "${ANANTA_RUNTIME_UID}" in \
        ""|*[!0-9]*) echo "ANANTA_RUNTIME_UID must be a positive integer" >&2; exit 64 ;; \
    esac \
    && case "${ANANTA_RUNTIME_GID}" in \
        ""|*[!0-9]*) echo "ANANTA_RUNTIME_GID must be a positive integer" >&2; exit 64 ;; \
    esac \
    && test "${ANANTA_RUNTIME_UID}" -gt 0 \
    && test "${ANANTA_RUNTIME_GID}" -gt 0 \
    && groupadd --gid "${ANANTA_RUNTIME_GID}" ananta \
    && useradd --uid "${ANANTA_RUNTIME_UID}" \
        --gid "${ANANTA_RUNTIME_GID}" \
        --home-dir /app/data/home \
        --no-create-home \
        --shell /bin/bash \
        ananta

# Docker/Compose client only. Host access remains disabled unless the explicit
# compose.ops-control.yml boundary overlay is selected by an operator.
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
RUN docker --version | grep -F "29.4.3" \
    && docker compose version | grep -F "v5.1.3"

# Node 24.18.0 LTS aus dem offiziellen Frontend-Runtime-Image uebernehmen.
COPY --from=node_runtime /usr/local/bin/ /usr/local/bin/
COPY --from=node_runtime /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
RUN node --version | grep -F "v24.18.0" \
    && npm --version >/dev/null

# Install OpenCode CLI once in the image so opencode backend is available after restarts.
RUN npm i -g "opencode-ai@${OPENCODE_AI_VERSION}" \
    && opencode --version | grep -F "${OPENCODE_AI_VERSION}" \
    && npm cache clean --force

WORKDIR /app

# Allow both root bootstrap commands and the runtime identity to read /app.
RUN git config --system --add safe.directory /app

# Kopiere Release-Lockdatei und installiere Python-Runtime-Pakete (Caching nutzen)
COPY requirements.lock .
COPY requirements-dev.lock .
COPY docker/compose-next/requirements.langgraph-worker.lock /tmp/requirements.langgraph-worker.lock
COPY docker/compose-next/requirements.qdrant-worker.lock /tmp/requirements.qdrant-worker.lock
RUN pip install --no-cache-dir -r requirements.lock \
    && pip install --no-cache-dir -c requirements-dev.lock "pytest==9.0.3" \
    && case "${INSTALL_LANGGRAPH_RUNTIME}" in \
        0) ;; \
        1) pip install --no-cache-dir -r /tmp/requirements.langgraph-worker.lock \
            && python -c "from importlib.metadata import version; import langgraph; assert version('langgraph') == '0.2.76'; assert version('langchain-core') == '0.3.86'" \
            && pip check ;; \
        *) echo "INSTALL_LANGGRAPH_RUNTIME must be 0 or 1" >&2; exit 64 ;; \
    esac \
    && case "${INSTALL_QDRANT_RUNTIME}" in \
        0) ;; \
        1) pip install --no-cache-dir -r /tmp/requirements.qdrant-worker.lock \
            && python -c "from importlib.metadata import version; import qdrant_client; assert version('qdrant-client') == '1.18.0'" \
            && pip check ;; \
        *) echo "INSTALL_QDRANT_RUNTIME must be 0 or 1" >&2; exit 64 ;; \
    esac

# Frontend-Abhaengigkeiten im selben Image vorinstallieren.
COPY frontend-angular/package*.json frontend-angular/
RUN cd frontend-angular && npm ci --no-audit --no-fund

# Evolver-Bridge-Abhaengigkeiten ebenfalls im selben Image vorinstallieren.
COPY services/evolver_bridge/package*.json services/evolver_bridge/
RUN cd services/evolver_bridge && npm ci --no-audit --no-fund

# Den Rest des Codes kopieren
COPY . .

# Runtime artifact projections are written by the unprivileged application
# user. Keep the directory present even when artifacts are excluded from the
# Docker build context.
RUN mkdir -p /app/artifacts \
    && chown -R "${ANANTA_RUNTIME_UID}:${ANANTA_RUNTIME_GID}" /app/artifacts \
    && chmod 0700 /app/artifacts
RUN chmod +x /app/scripts/quickstart-single-image-entrypoint.sh

EXPOSE 5000 5001 4200 8080

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    FLASK_DEBUG=0 \
    ANANTA_CLI_BACKENDS_DIR=/app/data/home/.local/share/ananta/cli-backends \
    ANANTA_QUICKSTART_MODE=role \
    ANANTA_QUICKSTART_ROLE=hub \
    DEFAULT_PROVIDER=lmstudio \
    DEFAULT_MODEL=auto \
    LMSTUDIO_URL=http://host.docker.internal:1234/v1 \
    OPENAI_URL=https://api.openai.com/v1/chat/completions \
    ANANTA_QUICKSTART_VARIANT=no-ollama

ENTRYPOINT ["/app/scripts/quickstart-single-image-entrypoint.sh"]
CMD ["sh", "-c", "alembic upgrade head && exec python -m agent.ai_agent"]
