# Evaluation-only profile. Copy values into an operator-managed secret/config store.
ORNITH_MODEL=ornith-1.5:9b
ORNITH_CONTEXT_TOKENS=8192
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_HOST=127.0.0.1:11434
# No automatic pull occurs during model startup. Import is a separate Hub job.
ANANTA_MODEL_IMPORT_NETWORK=disabled
ANANTA_ORNITH_RELEASE_STATE=experimental
