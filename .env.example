VOICE_WHISPER_CPP_GPU_ENABLED=
VOICE_WHISPER_CPP_BEAM_SIZE=5
VOICE_WHISPER_CPP_TEMPERATURE=0.0
VOICE_WHISPER_CPP_PROMPT_MAX_CHARS=512
VOICE_FASTER_WHISPER_MODEL_PATH=
VOICE_FASTER_WHISPER_COMPUTE_TYPE=default
VOICE_FASTER_WHISPER_BEAM_SIZE=5
VOICE_FASTER_WHISPER_VAD_FILTER=false
VOICE_FASTER_WHISPER_VAD_MIN_SILENCE_MS=500
# Runtime hard envelope for Hub-owned profile/session policy
VOICE_POLICY_ALLOWED_BACKENDS=vosk,whisper_cpp,faster_whisper,voxtral
VOICE_MAX_PARALLEL_BACKENDS=2
VOICE_MAX_CANDIDATE_COUNT=8
VOICE_CANDIDATE_DEADLINE_SEC=120
VOICE_RESOURCE_MAX_RAM_MB=16384
VOICE_RESOURCE_MAX_VRAM_MB=24576
VOICE_RESOURCE_MAX_CONCURRENT_BACKENDS=8
VOICE_RESOURCE_MAX_AUDIO_SECONDS=3600
VOICE_RESOURCE_MAX_QUEUE_DEPTH=16
VOICE_AUDIO_ENHANCEMENT_ENABLED=false
VOICE_ENHANCEMENT_VARIANTS=original
VOICE_ADAPTIVE_ROUTING_ENABLED=true
VOICE_ADAPTIVE_MAX_TOTAL_LATENCY_MS=120000
VOICE_ADAPTIVE_MAX_REGIONAL_RERUN_MS=30000
VOICE_PYANNOTE_MANIFEST_PATH=
VOICE_DIARIZATION_MODEL_ROOT=

# Auth Security Tuning (optional; secure defaults are built-in)
AUTH_RATE_LIMIT_WINDOW_SHORT_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS_SHORT=10
AUTH_RATE_LIMIT_WINDOW_LONG_SECONDS=3600
AUTH_RATE_LIMIT_MAX_ATTEMPTS_LONG=50
AUTH_IP_BAN_DURATION_SECONDS=86400
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_USER_LOCKOUT_THRESHOLD=5
AUTH_USER_LOCKOUT_DURATION_SECONDS=900
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_HISTORY_LIMIT=3
AUTH_MFA_BACKUP_CODE_COUNT=10

# Optional LAN HTTPS overlay (docker/compose-next/compose.lan-https.yml).
# Use the Windows/LAN IPv4 address visible to client devices.
# Add the exact HTTPS frontend origin to CORS_ORIGINS.
# ANANTA_LAN_HOST=192.168.178.103
# ANANTA_LAN_FRONTEND_TLS_TARGET_PORT=8443
# ANANTA_LAN_HUB_TLS_TARGET_PORT=5443
# CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://192.168.178.103:4200

# OIDC / Keycloak (optional)
TERMINAL_OIDC_ENABLED=false
TERMINAL_OIDC_ISSUER=http://localhost:8081/realms/ananta
TERMINAL_OIDC_BROWSER_ISSUER=http://localhost:8081/realms/ananta
TERMINAL_OIDC_AUDIENCE=ananta-hub
TERMINAL_OIDC_CLIENT_ID=ananta-hub

# Optional Hub↔OIDC account linking (see docs/identity-architecture.md).
# The Hub always validates its own JWTs. When enabled, a user may explicitly
# link an existing Hub account to a Keycloak subject; later Keycloak logins
# can then exchange for a normal Hub session.
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_JWKS_CACHE_SECONDS=3600
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_REGISTRATION_ALLOWED=false

# Hub self-registration always requires e-mail verification. Admin approval is an optional second gate.
HUB_SELF_REGISTRATION_ENABLED=false
HUB_SELF_REGISTRATION_REQUIRE_ADMIN_APPROVAL=false
HUB_REGISTRATION_PUBLIC_BASE_URL=https://ananta.example.com
HUB_REGISTRATION_VERIFICATION_TTL_SECONDS=86400
HUB_REGISTRATION_SMTP_HOST=
HUB_REGISTRATION_SMTP_PORT=587
HUB_REGISTRATION_SMTP_USERNAME=
HUB_REGISTRATION_SMTP_PASSWORD=
HUB_REGISTRATION_SMTP_FROM=
HUB_REGISTRATION_SMTP_STARTTLS=true

# Native SSH (optional)
NATIVE_SSH_ENABLED=false
SSH_CA_BACKEND=none
SSH_CA_STEP_CA_URL=
SSH_CA_STEP_CA_PROVISIONER=ananta-oidc
SSH_CA_STEP_CA_CA_FINGERPRINT=
SSH_CERTIFICATE_VALIDITY_SECONDS_WORKER=3600
SSH_CERTIFICATE_VALIDITY_SECONDS_HUB=900
SSH_BROAD_PRINCIPALS_ALLOWED=false
SSH_TERMINAL_WRAPPER_REQUIRED=true
SSH_AUDIT_ENABLED=true

# Local Keycloak compose overlay (docker/old_way/docker-compose.oidc-keycloak.yml)
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_change_me
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_change_me

# Ananta Network Profile (public-ananta | local | offline | custom)
# Default: local (eigene Infrastruktur)
ANANTA_NETWORK_PROFILE=local

# Public Ananta Rendezvous (nur wenn ANANTA_NETWORK_PROFILE=public-ananta)
# WARNUNG: Routing-Metadaten sind für öffentliche Ananta-Server sichtbar.
# Inhalte werden E2E-verschlüsselt. Nicht für vertrauliche Deployments.
ANANTA_PUBLIC_RENDEZVOUS_ENABLED=false
ANANTA_OIDC_ISSUER=https://keycloak.ananta.de/realms/ananta
ANANTA_OIDC_CLIENT_ID=ananta-tui
ANANTA_RENDEZVOUS_URL=https://webrtc.ananta.de
ANANTA_SIGNALING_URL=wss://webrtc.ananta.de/signaling
ANANTA_TURN_URL=turns:webrtc.ananta.de:5349
ANANTA_REQUIRE_E2E_PAYLOAD_ENCRYPTION=true

# TUI E2E (dedizierter Keycloak/Realm Account für Live-Share-Casts)
# Aktiviert Public-OIDC Login für scripts/e2e/record_tui_demo.py (share-session-live-e2e)
# ANANTA_TUI_E2E_USE_PUBLIC_OIDC=true
# ANANTA_TUI_E2E_OIDC_ISSUER=https://keycloak.ananta.de/realms/ananta-e2e
# ANANTA_TUI_E2E_OIDC_CLIENT_ID=ananta-tui
# ANANTA_TUI_E2E_OIDC_CLIENT_SECRET=
# ANANTA_TUI_E2E_OIDC_USERNAME=e2e
# ANANTA_TUI_E2E_OIDC_PASSWORD=<required-secret>
# ANANTA_TUI_E2E_RENDEZVOUS_URL=https://webrtc.ananta.de
# ANANTA_TUI_E2E_SIGNALING_URL=wss://webrtc.ananta.de/signaling
# Optional: bereits erzeugtes Token direkt setzen (ohne Passwort-Grant)
# ANANTA_TUI_E2E_OIDC_TOKEN=

# Device Key Directory (default: ~/.config/ananta/device-keys)
# ANANTA_DEVICE_KEY_DIR=

# Public Rendezvous Service (docker/old_way/docker-compose.public-rendezvous.yml)
# TURN_SHARED_SECRET muss identisch zu coturn --static-auth-secret sein.
# Mit `openssl rand -hex 32` generieren.
TURN_SHARED_SECRET=replace_with_32_random_hex_bytes
TURN_URLS=turn:webrtc.ananta.de:3478
TURN_TTL_SECONDS=3600
SESSION_MAX_DURATION_SECONDS=3600
RENDEZVOUS_DB_PATH=/var/lib/ananta/rendezvous.db
RENDEZVOUS_DB_TIMEOUT_SECONDS=5.0
RENDEZVOUS_LOG_LEVEL=INFO
# Public VM: externe IP / interne IP für Oracle-Cloud-NAT
PUBLIC_TURN_EXTERNAL_IP=79.76.105.53/10.0.1.233
PUBLIC_KEYCLOAK_HOSTNAME=keycloak.ananta.de
PUBLIC_WEBRTC_HOSTNAME=webrtc.ananta.de

# ─── Operator TUI — AI-Chat / AI-Snake ─────────────────────────────────────
# Most chat settings are also exposed in the TUI under "AI-Snake Config"
# (Ctrl+A). Values set here serve as defaults; values persisted by the TUI
# into user.json take precedence and are mirrored to os.environ on TUI start.
# Use the .env for multi-line strings (e.g. system prompt) that the TUI
# single-line input cannot carry.

# Chat system prompt — must contain "{context}" (falls back to default).
# Multi-line is allowed here. The TUI exposes a single-line editor for
# shorter prompts.
# ANANTA_TUI_CHAT_SYSTEM_PROMPT="Du bist ein hilfreicher Assistent für {project_name}. Kontext:\n{context}\n{depth_instruction}"

# Chat streaming on/off (default: 1)
# ANANTA_TUI_CHAT_STREAMING=1

# Chat RAG/embedding API toggle and model.
# When AN, the chat pipeline calls a dedicated embeddings endpoint
# (LMStudio /v1/embeddings or your OpenAI-compatible server) instead of
# falling back to CodeCompass heuristics. Required for large codebases
# where TF-IDF chunking misses semantically related files.
# ANANTA_TUI_CHAT_USE_EMBEDDING_API=0
# ANANTA_TUI_CHAT_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# ANANTA_TUI_CHAT_EMBEDDING_API_MAX_RECORDS=64

# Existing ANANTA_TUI_SNAKE_AI_* knobs (unchanged — full list):
# ANANTA_TUI_SNAKE_AI_TIMEOUT, ANANTA_TUI_SNAKE_AI_REFRESH,
# ANANTA_TUI_SNAKE_AI_BACKEND, ANANTA_TUI_SNAKE_AI_PROMPT_TEMPLATE,
# ANANTA_TUI_SNAKE_AI_ASYNC, ANANTA_TUI_SNAKE_AI_TRAINING,
# ANANTA_TUI_SNAKE_AI_WORKER_*, ANANTA_TUI_SNAKE_TUTORIAL_AI,
# ANANTA_TUI_SNAKE_RAG_TOP_K, ANANTA_TUI_SNAKE_RAG_MAX_RECORDS_PER_FILE
# See docs/operator-tui.md for the full reference.

# ─── Workflow Layer (WFG-003) ─────────────────────────────────────────────
# WFG-001 introduced an optional 'workflow' block in seed_blueprint_catalog.v1
# that describes a deterministic DAG of steps and gate reviews. The env
# variables below are the deployment-wide overrides documented in
# docs/decisions/ADR-workflow-gates-blueprint-contract.md.
#
# ANANTA_WORKFLOW_MODE: off | auto | enforce (default: auto)
#   off     - workflow block is ignored even if a blueprint declares it
#             (operator-level kill switch; WFG-021 backward-compat path)
#   auto    - workflow block is respected when validated
#   enforce - workflow block is respected AND the planner rejects malformed
#             workflows at materialization time (belt-and-braces with the
#             catalog normalizer)
# ANANTA_WORKFLOW_DEFAULT_GATE: block | skip | manual (default: block)
#   block  - default gate failure halts downstream steps
#   skip   - downstream steps are marked skipped
#   manual - human approval is raised via the operator TUI
# ANANTA_WORKFLOW_GATE_TIMEOUT (default: 86400 = 24h)
#   How long a gate can stay pending before the queue surfaces it as 'stale'
#   (WFG-013). 0 disables the stale check.
# ANANTA_WORKFLOW_AUDIT_ENABLED: 0|1 (default: 1)
#   Persist workflow-handoff events (WFG-015).
# ANANTA_WORKFLOW_ARTIFACT_FLOW: 0|1 (default: 1)
#   Enforce the produces/consumes DAG between steps (WFG-016).
#ANANTA_WORKFLOW_MODE=auto
#ANANTA_WORKFLOW_DEFAULT_GATE=block
#ANANTA_WORKFLOW_GATE_TIMEOUT=86400
#ANANTA_WORKFLOW_AUDIT_ENABLED=1
#ANANTA_WORKFLOW_ARTIFACT_FLOW=1

# ─── Semantic media/speech programme (default deny) ─────────────────────
# All capabilities are Hub-authoritative and disabled unless the exact value
# true/1 is configured. The background switch drains/disables sync,
# reconciliation, training and adapter routing without terminating ordinary
# Pair or Voice sessions.
ANANTA_ORDINARY_MEDIA_PUBLICATION_ENABLED=false
ANANTA_SEMANTIC_VISUAL_CAPTURE_ENABLED=false
ANANTA_SEMANTIC_SPEECH_RUNTIME_ENABLED=false
# Peer scheduling stays unavailable until operators confirm the current
# deployment's security boundary. The signing key must be a distinct random
# secret of at least 32 bytes and is never sent to browsers or workers.
ANANTA_SEMANTIC_COMPUTE_SECURITY_CONFIRMED=false
ANANTA_SEMANTIC_COMPUTE_FALLBACK_HEALTHY=true
ANANTA_SEMANTIC_COMPUTE_MAX_PEER_CAPACITY=1
ANANTA_SEMANTIC_COMPUTE_SIGNING_KEY=
# Worker opt-in also requires the registration keyring to allow
# semantic_compute and semantic_compute.<task_type> capabilities.
ANANTA_SEMANTIC_COMPUTE_WORKER_ENABLED=false
ANANTA_SEMANTIC_MEDIA_SFU_ENABLED=false
ANANTA_SEMANTIC_MEDIA_BACKGROUND_OPERATIONS_ENABLED=false
ANANTA_PEER_EVIDENCE_SYNC_ENABLED=false
ANANTA_PEER_OVERLAY_DATA_ENABLED=false
# Optional JSON matrix for independently gated feature canaries. Every feature
# and release-gate binding defaults false; unsupported features remain hard no-go.
#ANANTA_PEER_OVERLAY_ROLLOUT={"enabled":{"data_overlay":true},"gate_bindings":{"data_overlay":true},"allowlists":{"tenant":["tenant-canary"]}}
# Versioned hard TURN/peer-relay quotas. The default profile denies metered edges
# until tenant-specific, production-scoped evidence is configured.
ANANTA_PEER_OVERLAY_COST_BUDGETS_PATH=config/peer_overlay_cost_budgets.default.json
ANANTA_DSPY_OPTIMIZATION_ENABLED=false
ANANTA_DSPY_OPTIMIZATION_MODE=disabled
ANANTA_DENDRITIC_MEMORY_ENABLED=false
ANANTA_DENDRITIC_MEMORY_MODE=disabled
ANANTA_DENDRITIC_MEMORY_RUNTIME_ENABLED=false
ANANTA_DENDRITIC_MEMORY_AUTOMATIC_ACTIVATION_ENABLED=false
ANANTA_RESEARCH_TRAINING_ENABLED=false
ANANTA_RESEARCH_TRAINING_MODE=disabled
ANANTA_RESEARCH_TRAINING_AUTOMATIC_RELEASE_ENABLED=false
ANANTA_RESEARCH_TRAINING_POLICY_PATH=config/research-training/policy.v1.json
ANANTA_RESEARCH_TRAINING_ROLLOUT_PATH=config/research-training/rollout.v1.json
ANANTA_RESEARCH_TRAINING_SAFETY_PATH=config/research-training/safety.v1.json
ANANTA_RESEARCH_TRAINING_STATE=data/research-training.sqlite3
ANANTA_RESEARCH_TRAINING_ARTIFACT_ROOT=data/research-training-artifacts
ANANTA_RESEARCH_TRAINING_DATASET_ROOT=data/research-training-datasets
ANANTA_RESEARCH_TRAINING_RESULT_ROOT=data/research-training-results
ANANTA_RESEARCH_TRAINING_ALLOWED_LICENSES=MIT,Apache-2.0,CC-BY-4.0,proprietary-approved,synthetic-test
# Scheduler-bound identity used by the isolated Research Training Worker.
ANANTA_RESEARCH_REPOSITORY_REVISION=
ANANTA_RESEARCH_IMAGE_DIGEST=
ANANTA_RESEARCH_HARDWARE_PROFILE_DIGEST=
ANANTA_COLLABORATION_WORKSPACE_ENABLED=false
ANANTA_COLLABORATION_WORKSPACE_STATE=data/collaboration-workspace.sqlite3
ANANTA_SPREADSHEET_STUDIO_ENABLED=false
ANANTA_SPREADSHEET_STUDIO_MODE=disabled
ANANTA_SPREADSHEET_STUDIO_AUTOMATIC_PROMOTION_ENABLED=false
# Required only for MODE=worker. The endpoint must be repeated in the exact
# allowlist and resolve exclusively to a private container address.
ANANTA_SPREADSHEET_WORKER_URL=
ANANTA_SPREADSHEET_ALLOWED_ENDPOINTS=
ANANTA_SPREADSHEET_WORKER_TOKEN=
ANANTA_SPREADSHEET_WORKER_TOKEN_FILE=
ANANTA_SPREADSHEET_WORKER_TIMEOUT_SECONDS=120
ANANTA_SPEECH_RECONCILIATION_ENABLED=false
# Hub recovery cadence; bounded to 0.25-300 seconds when reconciliation is enabled.
ANANTA_SPEECH_RECONCILIATION_RECONCILE_INTERVAL_SECONDS=5
# Queue and DB-backed worker-result collector cadences.
ANANTA_SPEECH_RECONCILIATION_QUEUE_INTERVAL_SECONDS=2
ANANTA_SPEECH_RECONCILIATION_COLLECT_INTERVAL_SECONDS=2
# Immutable model IDs and worker-supported deterministic audio variants. The
# Hub verifies the same read-only model catalog before it delegates a pass.
ANANTA_SPEECH_RECONCILIATION_ALLOWED_MODELS=whisper-cpp-v1.8.6-ggml-small
ANANTA_SPEECH_RECONCILIATION_ALLOWED_VARIANTS=original
# Host paths are mounted read-only into Hub and worker by the compose overlay.
# ANANTA_SPEECH_RECONCILIATION_MODEL_DIR=/absolute/path/to/models/voice
# ANANTA_SPEECH_RECONCILIATION_KEYRING_FILE=/absolute/path/to/reconciliation-keyring.json
# Required for the isolated Hub↔worker control plane; generate a random value >=24 chars.
# ANANTA_SPEECH_RECONCILIATION_INTERNAL_TOKEN=<required-random-secret-at-least-24-chars>
ANANTA_SPEECH_ADAPTATION_TRAINING_ENABLED=false
ANANTA_SEMANTIC_MEDIA_BROADCAST_ENABLED=false
ANANTA_SEMANTIC_MEDIA_RECEIVER_GROUPS_ENABLED=false
ANANTA_SEMANTIC_MEDIA_FLEET_ADMISSION_ENABLED=false
ANANTA_SEMANTIC_MEDIA_TURN_COST_CONTROLS_ENABLED=false
# Der Mock-Profil-Container bleibt explizit und beweist nur Lifecycle, nicht
# Modellqualitaet. Zwei getrennte Zufallstokens schuetzen Hub→Worker und
# Worker→Hub; beide duerfen nie gleich oder eingecheckt sein.
# ANANTA_SPEECH_TRAINING_INTERNAL_TOKEN=<required-random-secret-at-least-24-chars>
# ANANTA_SPEECH_TRAINING_CALLBACK_TOKEN=<required-distinct-random-secret-at-least-32-chars>
ANANTA_SPEECH_TRAINER_LOCATION=ananta-local-speech-training-worker
ANANTA_SPEECH_TRAINING_CAPACITY=1
ANANTA_SPEECH_TRAINING_LEASE_SECONDS=300
ANANTA_SPEECH_TRAINING_MAX_DISPATCH_ATTEMPTS=8
ANANTA_SPEECH_TRAINING_DISPATCH_INTERVAL_SECONDS=1
ANANTA_SPEECH_ADAPTER_ROUTING_ENABLED=false
# Required only when adapter routing/export is enabled. The absolute file must
# contain exactly 32 random bytes (or their hex/base64 representation), be
# mounted Hub-only and have no group/other permissions.
# ANANTA_SPEECH_ADAPTER_EXPORT_KEY_FILE=/run/secrets/speech-adapter-export-key

# ─── Isoliertes lokales LoRA-/QLoRA-Training ──────────────────────────────
# Aktivierung erfolgt über docker/compose-next/compose.lora-training.yml.
# Token mit `openssl rand -hex 32` erzeugen; nie ein Beispieltoken übernehmen.
# ANANTA_LORA_TRAINING_INTERNAL_TOKEN=<required-random-secret-at-least-24-chars>
# Exakt ein lokaler Worker-Backend-Default: mock | peft_trl | unsloth
# ANANTA_LORA_TRAINING_DEFAULT_BACKEND=mock
# Sicherer UI-/API-Default: dry_run | live
# ANANTA_LORA_TRAINING_MODE=dry_run
# Hub und Worker werden profilgebunden über scripts/run-lora-training-stack.sh
# gesetzt; direkte Compose-Starts müssen alle folgenden Werte explizit setzen.
# ANANTA_LORA_TRAINING_WORKER_BACKENDS=mock
# ANANTA_LORA_TRAINING_RESOURCE_PROFILE=mock
# ANANTA_LORA_TRAINING_GPU_PROFILE=none
# Katalogpfade sind relativ zum read-only Worker-Mount /models/base.
# snapshot_hash ist der SHA-256-Tree-Hash gemäß docs/ml-intern-lora-finetuning.md.
# ANANTA_LORA_TRAINING_MODEL_CATALOG_JSON={"local/model":{"relative_path":"model","snapshot_hash":"<64-lowercase-hex>"}}
# Hostverzeichnis mit ausschließlich lokalen Modell-Snapshots.
# ANANTA_LORA_TRAINING_MODEL_DIR=/absolute/path/to/models/training
# NVIDIA-Worker: PyTorch-Caching-Allocator-Anteil je sichtbarem CUDA-Device,
# strikt >0 und <=1 (Default im Compose-Overlay: 0.90). Dies ist keine harte
# Docker-/VRAM-Quota und begrenzt keine Allokationen außerhalb des Allocators.
# ANANTA_LORA_TRAINING_CUDA_MEMORY_FRACTION=0.90
# Optionale Worker-Inferenzlimits des Compose-Overlays.
# ANANTA_LORA_INFERENCE_MAX_LOADED_ADAPTERS=1
# ANANTA_LORA_INFERENCE_MAX_PROMPT_CHARS=1048576
# ANANTA_LORA_INFERENCE_MAX_RESPONSE_CHARS=4194304
# ANANTA_LORA_INFERENCE_MAX_ADAPTER_BYTES=2147483648
# Visual Process Assistant rollout (all fail closed by default)
VISUAL_PROCESS_REGISTRY_INSPECTOR_ENABLED=false
VISUAL_PROCESS_HOVER_HELP_ENABLED=false
VISUAL_PROCESS_ASSISTANT_CHAT_ENABLED=false
VISUAL_PROCESS_AI_PATCHES_ENABLED=false
VISUAL_PROCESS_AI_PATCH_AUTO_APPROVAL_ENABLED=false
VISUAL_PROCESS_ASSISTANT_RETRIEVAL_TIMEOUT_MS=5000
VISUAL_PROCESS_ASSISTANT_MODEL_TIMEOUT_MS=120000

# Per-identity mutation limits. All values must be positive integers.
ANANTA_KANBAN_WRITE_RATE_LIMIT=120
ANANTA_KANBAN_WRITE_RATE_LIMIT_WINDOW_SECONDS=60
ANANTA_KANBAN_EVENT_BUFFER_SIZE=512
ANANTA_MODEL_CATALOG_REFRESH_RATE_LIMIT=6
ANANTA_MODEL_CATALOG_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
ANANTA_MODEL_DEFAULT_SELECTION_RATE_LIMIT=12
ANANTA_MODEL_DEFAULT_SELECTION_RATE_LIMIT_WINDOW_SECONDS=60

# Optional vector-store backend. JSON remains the offline/test default.
ANANTA_VECTOR_STORE_PROVIDER=json
ANANTA_QDRANT_REST_URL=https://localhost:6333
# Leave empty unless compose.qdrant-grpc-host.yml is explicitly enabled.
ANANTA_QDRANT_GRPC_URL=
ANANTA_QDRANT_ALLOWED_ORIGINS=https://localhost:6333
# Exact HTTPS/gRPCS origins only for non-loopback container-network endpoints.
# trusted_private_origins may waive external-call approval, never TLS.
ANANTA_QDRANT_TRUSTED_PRIVATE_ORIGINS=
ANANTA_QDRANT_EXTERNAL_CALLS_ALLOWED=false
ANANTA_QDRANT_CONNECT_TIMEOUT_SECONDS=3
ANANTA_QDRANT_REQUEST_TIMEOUT_SECONDS=10
ANANTA_QDRANT_PREFER_GRPC=false
# Secret reference only; plaintext API keys are rejected.
# Supported forms: env://ANANTA_QDRANT_API_KEY or secretfile:///run/secrets/qdrant-api-key
ANANTA_QDRANT_API_KEY_REF=
# Optional private-CA trust anchor. File refs only; verification stays enabled.
# Compose uses secretfile:///run/secrets/qdrant-tls-ca.pem.
ANANTA_QDRANT_TLS_CA_CERT_REF=
# Compose uses its ../../config/secrets defaults when these stay empty. If
# overriding them, use absolute host paths to avoid Compose-relative ambiguity.
ANANTA_QDRANT_TLS_CA_FILE=
ANANTA_QDRANT_TLS_CERT_FILE=
ANANTA_QDRANT_TLS_KEY_FILE=
# Optional trusted CodeCompass rollout scope. Both IDs are required together.
# The Hub binds these values to authoritative tasks before retrieval; clients
# cannot provide worker_execution_context.retrieval_vector_scope themselves.
ANANTA_CODECOMPASS_VECTOR_WORKSPACE_ID=
ANANTA_CODECOMPASS_VECTOR_REPOSITORY_ID=
ANANTA_CODECOMPASS_VECTOR_PROFILE_NAME=default
# Hub-as-worker read capability. Keep false unless the Hub is explicitly given
# the Qdrant network and secret boundary; index mutations remain worker tasks.
ANANTA_CODECOMPASS_VECTOR_HUB_QDRANT_READ_ENABLED=false
# Explicit content-addressed Hub->Worker input-artifact boundary. The Qdrant
# worker overlay sets the container paths and mounts Worker access read-only.
ANANTA_VECTOR_INDEX_INPUT_PUBLISH_ROOT=
ANANTA_VECTOR_INDEX_INPUT_ROOTS=
# Hub-only private Ed25519 signing keyring and Worker-only public verification
# keyring. Compose mounts these host files under /run/secrets; never give the
# signing keyring to a Worker.
ANANTA_VECTOR_INDEX_TASK_SIGNING_KEYRING_SECRET_FILE=
ANANTA_VECTOR_INDEX_TASK_VERIFICATION_KEYRING_SECRET_FILE=
# Direct non-Compose process paths (leave unset when the Compose overlay sets
# the in-container paths).
ANANTA_VECTOR_INDEX_TASK_SIGNING_KEYRING_FILE=
ANANTA_VECTOR_INDEX_TASK_VERIFICATION_KEYRING_FILE=
ANANTA_VECTOR_INDEX_TASK_DISPATCH_TTL_SECONDS=300
ANANTA_VECTOR_INDEX_TASK_AUDIENCE=
ANANTA_VECTOR_INDEX_TASK_REPLAY_LEDGER_FILE=/app/data/vector-index-task-replay.sqlite3
# Delegated embedding egress is independent from Qdrant egress and default
# denies every external provider. The Hub value is a JSON object of exact
# policy profiles; Workers receive only an immutable JSON base-URL allowlist.
# See docs/worker/qdrant-vector-index-taskflow.md before enabling either.
ANANTA_VECTOR_INDEX_EMBEDDING_PROFILES_JSON={}
ANANTA_VECTOR_INDEX_EMBEDDING_EGRESS_ALLOWLIST_JSON=[]
# Wiki is a separate rollout and collection domain.
ANANTA_WIKI_VECTOR_WORKSPACE_ID=
ANANTA_WIKI_VECTOR_SOURCE_ID=
ANANTA_WIKI_VECTOR_PROFILE_NAME=default
ANANTA_WIKI_VECTOR_RETRIEVAL_CACHE_STATE=
ANANTA_WIKI_VECTOR_MANIFEST_HASH=
ANANTA_WIKI_VECTOR_HUB_QDRANT_READ_ENABLED=false
ANANTA_KNOWLEDGE_HYGIENE_ENABLED=false
ANANTA_KNOWLEDGE_HYGIENE_MODE=disabled
ANANTA_KNOWLEDGE_HYGIENE_AUTO_RUN_ENABLED=false
ANANTA_KNOWLEDGE_HYGIENE_SOURCE_WRITEBACK_ENABLED=false
ANANTA_KNOWLEDGE_HYGIENE_ALLOWED_OBSIDIAN_ROOTS=[]
# Parametric knowledge experts remain default-off until all rollout gates pass.
# Disabling this never disables the existing RAG path.
ANANTA_KNOWLEDGE_EXPERTS_ENABLED=false
ANANTA_KNOWLEDGE_EXPERTS_ROLLOUT=off
ANANTA_KNOWLEDGE_EXPERTS_ROLLOUT_STATE=data/knowledge-expert-rollout.sqlite3
ANANTA_KNOWLEDGE_EXPERTS_POLICY_PROFILE=rag-default

# Hub-owned, headless Scrum sprint/architecture/retrospective revision store.
ANANTA_SCRUM_IMPROVEMENT_STATE=data/scrum-continuous-improvement.sqlite3

# Optional advisory-only Composite Risk Review. Explicit API/CLI invocation is
# still required; no interactive review is needed for headless operation.
COMPOSITE_RISK_REVIEW_ENABLED=false
COMPOSITE_RISK_REVIEW_EXPLICIT_ONLY=true

# Hub-owned local Needle/LFM adapter serving activation. Conversion is offline;
# the runtime reads only the 0600 hash-bound projection below.
ANANTA_LOCAL_ADAPTER_ACTIVATION_FILE=data/local-model-runtime/active-adapters.v1.json
ANANTA_LOCAL_ADAPTER_SERVING_ROOT=data/local-model-runtime/candidates
ANANTA_NEEDLE_TRAINING_BIN=/path/to/pinned/needle
ANANTA_NEEDLE_BASE_CHECKPOINT=/path/to/pinned/needle2.pkl
ANANTA_LFM_TRAINING_PYTHON=/path/to/pinned/training/python
ANANTA_LFM_LORA_CONVERTER=/path/to/pinned/llama.cpp/convert_lora_to_gguf.py
ANANTA_LFM_TRAINING_MODEL_DIR=/path/to/pinned/LFM2.5-2.6B-snapshot
