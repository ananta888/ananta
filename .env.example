# Docker Compose environment variables
# Copy this file to .env and adjust as needed

# Cross-platform path resolution for Git Bash / MSYS on Windows
# Set to 1 if you encounter 'invalid volume specification' errors in Git Bash
COMPOSE_CONVERT_WINDOWS_PATHS=0

# Port Configuration
HUB_PORT=5000
ALPHA_PORT=5001
BETA_PORT=5002
GAMMA_PORT=5003
DELTA_PORT=5004
LMSTUDIO_PROXY_PORT=12340
FRONTEND_PORT=4200
# Explicit local browser origins are required while strict Worker
# authentication is enabled. Override this list when FRONTEND_PORT changes.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Datastores are local-only by default. Windows 11 can still reach WSL2
# loopback through its localhost forwarding when enabled.
POSTGRES_PORT=127.0.0.1:5432
REDIS_PORT=127.0.0.1:6379
HTTP_PORT=80
HTTPS_PORT=443
LOKI_PORT=3100
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Database Configuration
# GENERATE NEW PASSWORDS FOR PRODUCTION!
POSTGRES_USER=ananta
POSTGRES_PASSWORD=replace_this_with_a_secure_password_123!
POSTGRES_DB=ananta
# Hub file descriptor limits (helps under heavy E2E/login load)
HUB_NOFILE_SOFT=8192
HUB_NOFILE_HARD=65535

# Grafana Configuration
GRAFANA_PASSWORD=replace_this_with_a_secure_password_456!

# Service URLs
LMSTUDIO_URL=http://192.168.56.1:1234/v1
OLLAMA_URL=http://host.docker.internal:11434/api/generate
LMSTUDIO_API_MODE=chat
E2E_OLLAMA_URL=http://host.docker.internal:11434/api/generate
E2E_LMSTUDIO_URL=http://host.docker.internal:1234/v1
OLLAMA_VULKAN=1
OLLAMA_WSL_LD_LIBRARY_PATH=/usr/lib/wsl/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64
OLLAMA_WSL_VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/dzn_icd.json
COMPOSE_OLLAMA_URL=http://ollama:11434/api/generate
COMPOSE_LMSTUDIO_URL=http://192.168.56.1:1234/v1
COMPOSE_DEFAULT_PROVIDER=ollama
COMPOSE_DEFAULT_MODEL=qwen2.5-coder:7b
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=WARNING
AUTH_TEST_ENDPOINTS_ENABLED=0
HUB_CAN_BE_WORKER=0
# Snake control endpoints require a real user/service bearer by default.
# A local development bypass is intentionally opt-in and accepts true
# loopback only; Docker bridge and RFC1918 callers never qualify.
ANANTA_SNAKE_LOCAL_DEV_AUTH_BYPASS=0
# Hub-owned boundary for Worker Context inputs and generated workspaces.
ANANTA_WORKSPACE_ROOT=/project-workspaces
# Optional GitHub App adapter for private repository authorization.
# Leave unset to keep the fail-closed unavailable provider. The private
# key must already live behind an opaque secret reference.
# HUB_GIT_GITHUB_APP_ID=
# HUB_GIT_GITHUB_APP_PRIVATE_KEY_REF=secret://github-app/private-key

# Docker Ops is disabled unless compose.ops-control.yml is explicitly added.
# The overlay mounts /var/run/docker.sock into the hub and therefore grants
# host-level container administration. Never enable it for untrusted hubs.
# ANANTA_DOCKER_OPS_BOUNDARY=hub_cli
# Optional host path when the managed stack uses a different Compose env file.
# ANANTA_DOCKER_OPS_ENV_FILE_HOST=../../.env
# Agent Safety containment remains unavailable unless this separate, explicit
# runtime boundary is enabled. Targets are exact IDs/names; wildcards are
# rejected. The Hub then performs pause/kill/network disconnect, bounded
# forensic snapshots and TTL cleanup without an interactive approval.
# ANANTA_AGENT_SAFETY_RUNTIME_ADAPTER=docker
# ANANTA_AGENT_SAFETY_MANAGED_SANDBOXES=ananta-worker-alpha,ananta-worker-beta
# ANANTA_AGENT_SAFETY_SNAPSHOT_ROOT=/data/agent-safety-snapshots
# ANANTA_AGENT_SAFETY_RETENTION_INTERVAL_SECONDS=60

# AI Agent Configuration
# IMPORTANT: Change these tokens for production use!
# They are used for inter-agent communication security.
AGENT_TOKEN_HUB=generate_a_random_token_for_hub
AGENT_TOKEN_ALPHA=generate_a_random_token_for_alpha
AGENT_TOKEN_BETA=generate_a_random_token_for_beta
AGENT_TOKEN_GAMMA=generate_a_random_token_for_gamma
AGENT_TOKEN_DELTA=generate_a_random_token_for_delta
# Shared JWT signing key for all agents (required for cross-agent user JWT validation)
SECRET_KEY=replace_this_with_a_shared_secret_key_min_32_chars
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=ananta-phi4-mini-32k
# Optional server-side credential for Hub-owned AI-Snake OpenAI chat.
# Never expose this credential to Angular or unscoped worker containers.
OPENAI_API_KEY=
# Trusted endpoint bound to OPENAI_API_KEY. Session overrides must match it.
OPENAI_URL=https://api.openai.com/v1/chat/completions
# Optional model profile routing. If set, this takes precedence over
# DEFAULT_PROVIDER/DEFAULT_MODEL and keeps those values as legacy fallback.
MODEL_PROFILES_PATH=config/models/local-ollama-phi-gemma-rtx3080.model_profiles.yaml
MODEL_ROUTING_PATH=config/models/local-ollama-phi-gemma-rtx3080.model_routing.json
OLLAMA_MODEL=ananta-phi4-mini-32k
# Optional absolute WSL2 host path. This is a bind mount and can be backed up
# independently from Docker volumes, for example /home/<user>/ananta-data/ollama.
# OLLAMA_DATA_DIR=/home/<user>/ananta-data/ollama
# One 32k request at a time keeps KV-cache pressure predictable on 10 GB VRAM.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m
# Set to 1 only after both base models exist in OLLAMA_DATA_DIR.
OLLAMA_BOOTSTRAP_OFFLINE=0
# Optional WSL2 host directory for auto-generated local workflow keyrings.
# The Hub-private and Worker-public keyrings remain separated below this root.
# Never reuse these development credentials in a production deployment.
# ANANTA_DEV_WORKFLOW_SECRET_DIR=/home/<user>/ananta-data/workflow-runtime-dev
# Numeric owner for keyring files created by the root-running bootstrap
# container. Set these to `id -u` and `id -g` for a non-default WSL account.
ANANTA_HOST_UID=1000
ANANTA_HOST_GID=1000

# CLI-backend-specific defaults below are independent from the local Ollama
# provider and routing defaults above.
SGPT_DEFAULT_MODEL=lfm2.5-1.2b-glm-4.7-flash-thinking-i1
CODEX_DEFAULT_MODEL=gpt-5-codex
OPENCODE_DEFAULT_MODEL=opencode/glm-5-free
CODECOMPASS_FTS_ENABLED=0
# Optional SIRA-inspired corpus-discriminative profile. It remains off until a
# bound enrichment index, query model and rollout decision are available.
CODECOMPASS_SIRA_MODE=off
CODECOMPASS_SIRA_ENRICHMENT_MODEL=
CODECOMPASS_SIRA_QUERY_MODEL=
CODECOMPASS_SIRA_RERANK_MODEL=
CODECOMPASS_SIRA_RERANKER_ENABLED=0
CODECOMPASS_SIRA_LOCAL_MODELS_ONLY=1
CODECOMPASS_SIRA_SNAPSHOT_ROOT=
CODECOMPASS_SIRA_LAYER_ROOT=
CODECOMPASS_SIRA_ROLLOUT_STATE=data/sira-rollout.sqlite3
CODECOMPASS_SIRA_ONLINE_EXPANSION_ENABLED=true
CODECOMPASS_SIRA_OFFLINE_ENRICHMENT_ENABLED=true
CODECOMPASS_VECTOR_ENABLED=0
CODECOMPASS_GRAPH_ENABLED=0
CODECOMPASS_RELATION_EXPANSION_ENABLED=0
# File-type rollout and bounded parser defaults (shared explicitly per container).
ANANTA_CODECOMPASS_FILE_TYPE_PRIORITIES=P0,P1,P2
ANANTA_CODECOMPASS_ENABLED_FORMATS=
ANANTA_CODECOMPASS_DISABLED_FORMATS=
ANANTA_CODECOMPASS_MAX_FILE_BYTES=1048576
ANANTA_CODECOMPASS_MAX_LINES=50000
ANANTA_CODECOMPASS_PARSER_TIMEOUT_MS=2000
ANANTA_CODECOMPASS_MAX_OUTPUT_RECORDS=5000
ANANTA_CODECOMPASS_MAX_XML_NODES=20000
ANANTA_CODECOMPASS_MAX_XML_DEPTH=64
ANANTA_CODECOMPASS_MAX_YAML_ALIASES=50
ANANTA_CODECOMPASS_MAX_NOTEBOOK_CELLS=2000
ANANTA_CODECOMPASS_MAX_NOTEBOOK_CELL_CHARS=100000
ANANTA_CODECOMPASS_MAX_NOTEBOOK_OUTPUT_BYTES=0
ANANTA_CODECOMPASS_MAX_CSV_ROWS=10000
ANANTA_CODECOMPASS_MAX_CSV_COLUMNS=256
ANANTA_CODECOMPASS_DOMAIN_SUPPLEMENT_SOURCE_MAX_BYTES=2147483648

# CodeCompass runtime domain scope (CCRDS)
# When enabled, a `domain:<id>` value in chat_retrieval_domain_hint is
# resolved against domains.detected.json / domains/<id>/domain.json and
# hard-limits retrieval (and write validation) to the domain's paths.
CODECOMPASS_DOMAIN_SCOPE_ENABLED=0
CODECOMPASS_DOMAIN_ARTIFACT_PATH=artifacts/codecompass/domains.detected.json
CODECOMPASS_DOMAIN_DESCRIPTOR_ROOT=domains
CODECOMPASS_SCOPE_STRICT_MODE=1
CODECOMPASS_SCOPE_ALLOW_RELATION_EXPANSION=0
CODECOMPASS_SCOPE_MAX_EXTERNAL_REFERENCE_CHUNKS=2

# CodeCompass VectorEncoding (TQ-018 / VEC-DELTA-004)
# Mode: off | float32 | float16 | int8 | symmetric4bit | turboquant_mse_experimental
# Start with off or float32 (lossless). Activate int8 only after benchmark gate passes.
CODECOMPASS_VECTOR_ENCODING_MODE=off
CODECOMPASS_VECTOR_ENCODING_TARGET_BITS=32.0
CODECOMPASS_VECTOR_ENCODING_SEED=888
CODECOMPASS_VECTOR_ENCODING_BLOCK_SIZE=0
CODECOMPASS_VECTOR_ENCODING_STORE_ORIGINAL=0
# Fallback policy when quantized decode fails: block | fallback_float32 | warn_only
CODECOMPASS_VECTOR_ENCODING_FALLBACK_POLICY=fallback_float32

# CodeCompass TransformerFeatureProvider (TQ-015)
# Mode: disabled | observe_only | context_first
# NEVER enable with local_only=0 in production without explicit approval.
CODECOMPASS_TRANSFORMER_FEATURE_MODE=disabled
CODECOMPASS_TRANSFORMER_FEATURE_MODEL=
CODECOMPASS_TRANSFORMER_FEATURE_LOCAL_ONLY=1
CODECOMPASS_TRANSFORMER_FEATURE_MAX_INPUT_TOKENS=512

# CodeCompass AgentFeatureProvider policy gates (AGENT-FEATURE-004)
# Hard default-deny — external AI agent calls are off until explicitly enabled.
CODECOMPASS_AGENT_FEATURE_ENABLED=0
CODECOMPASS_AGENT_FEATURE_EXTERNAL_CALLS_ALLOWED=0
CODECOMPASS_AGENT_FEATURE_ALLOWED_PROVIDER_IDS=

# Hermes-inspired Kanban/model dashboard rollout (default deny)
FEATURE_ANGULAR_KANBAN_ENABLED=0
FEATURE_ANGULAR_MODEL_DASHBOARD_ENABLED=0
FEATURE_MODEL_CATALOG_V2_ENABLED=0
FEATURE_MODEL_ROUTING_EDITOR_ENABLED=0
FEATURE_LEGACY_MODEL_PICKER_DEPRECATION_ENABLED=0
# Source-bound Contract/Security/UI/E2E/Performance evidence required before
# enabling the routing editor. The default is shown explicitly for operators.
MODEL_ROUTING_RELEASE_EVIDENCE_PATH=artifacts/test-gates/model-routing-release-gate.json
ANANTA_KANBAN_API_ENABLED=0
ANANTA_KANBAN_WRITE_ENABLED=0
FEATURE_TUI_KANBAN_ENABLED=0
FEATURE_TUI_MODEL_MENU_ENABLED=0

# Experimental HRM reasoning workbench Hub API (default deny)
HRM_EXPERIMENTS_ENABLED=0

# Context Compression Adapter (HCCA-002)
# Phase 1: set ENABLED=1 + MODE=passthrough_with_metrics to collect metrics without changing output.
# Phase 2: MODE=compress to activate SmartCompressor (int8-4bit for JSON/logs/search results).
# NEVER compress current_user_message, active_patch, credentials or approval prompts.
CONTEXT_COMPRESSION_ENABLED=0
CONTEXT_COMPRESSION_MODE=passthrough_with_metrics
CONTEXT_COMPRESSION_ADAPTER=ananta_context_compression
CONTEXT_COMPRESSION_TARGET_REDUCTION_PERCENT=35.0
CONTEXT_COMPRESSION_MAX_INPUT_TOKENS=1200
CONTEXT_COMPRESSION_MIN_QUALITY_SCORE=0.7
CONTEXT_COMPRESSION_FALLBACK_ON_QUALITY_RISK=1

# CCR Store — local content-addressable reference store for originals
CONTEXT_COMPRESSION_CCR_ENABLED=1
CONTEXT_COMPRESSION_CCR_PATH=.ananta/context-compression/ccr
CONTEXT_COMPRESSION_CCR_TTL_HOURS=72

# External Headroom adapter (disabled by default — needs headroom CLI installed)
CONTEXT_COMPRESSION_EXTERNAL_HEADROOM_ENABLED=0
CONTEXT_COMPRESSION_EXTERNAL_HEADROOM_TRANSPORT=cli

# Observability
CONTEXT_COMPRESSION_EMIT_EVENTS=1

# CodeCompass / Worker handoff defaults
# Keep vector retrieval disabled unless an embedding provider is explicitly
# configured through AGENT_CONFIG. The built-in default is offline local_hash.
CODECOMPASS_WORKER_HANDOFF_POLICY_VERSION=v3.0

# Ananta worker architecture full scan
# Explicit full-scan mode is used for architecture diagrams and whole-system
# explanations. Normal short chat/RAG questions continue to use the fast path.
ANANTA_WORKER_FULL_SCAN_ENABLED=1
ANANTA_WORKER_FULL_SCAN_MAX_BATCHES=8
ANANTA_WORKER_FULL_SCAN_FILES_PER_BATCH=3
ANANTA_WORKER_FULL_SCAN_MAX_REF_CHARS=4000
ANANTA_WORKER_FULL_SCAN_SUMMARY_CHARS=12000
ANANTA_WORKER_FULL_SCAN_MAX_TOTAL_REF_COUNT=120

# RAG Route Quotas — max results per retrieval engine per query type
# Reduce on weak hardware (e.g. RAG_ROUTE_QUOTA_CODE_REPO=6)
RAG_ROUTE_QUOTA_CODE_REPO=12
RAG_ROUTE_QUOTA_CODE_SEMANTIC=2
RAG_ROUTE_QUOTA_DOCS_SEMANTIC=4
RAG_ROUTE_QUOTA_DOCS_REPO=2
RAG_ROUTE_QUOTA_FS_AGENTIC=3
RAG_ROUTE_QUOTA_FS_REPO=2
RAG_ROUTE_QUOTA_DEFAULT_REPO=6
RAG_ROUTE_QUOTA_DEFAULT_SEMANTIC=4

# RAG Scan Exclusions — comma-separated directory names to skip during repo scan
# node_modules, .venv, .git and project-workspaces are excluded to avoid
# indexing large dependency trees and internal Claude Code workspace state.
RAG_SCAN_EXCLUDE_DIRS=.git,.venv,venv,myvenv,site-packages,node_modules,__pycache__,.mypy_cache,.claude,project-workspaces,.tox,dist,build,.eggs

# RAG Query Normalization — expands queries for better multilingual retrieval
# RAG_QUERY_NORMALIZE_MODE: off | keyword | llm
#   off     — no expansion, fastest, use when queries are always in English
#   keyword — offline DE↔EN keyword mapping (default, no LLM required)
#   llm     — optional LLM-based translation (reserved, falls back to keyword)
# RAG_QUERY_NORMALIZE_LANG: comma-separated language hints (de,en)
# RAG_QUERY_TRANSLATION_DIRECTIONS: de_to_en | en_to_de | mixed_code_query (comma-separated)
#   de_to_en         — German queries find English code symbols (most useful default)
#   en_to_de         — English queries find German docs/comments/todos
#   mixed_code_query — queries mixing German text with code tokens
RAG_QUERY_NORMALIZE_MODE=keyword
RAG_QUERY_NORMALIZE_LANG=de,en
RAG_QUERY_TRANSLATION_DIRECTIONS=de_to_en,mixed_code_query

# Initial Admin User/Password (used on first start)
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=test123
E2E_ADMIN_PASSWORD=test123

# Live test tuning (optional)
RUN_LIVE_LLM_TESTS=0
LIVE_LLM_PROVIDER=ollama
LIVE_LLM_MODEL=ananta-smoke
LIVE_LLM_TIMEOUT_SEC=60
LIVE_LLM_RETRY_ATTEMPTS=1
LIVE_LLM_RETRY_BACKOFF_SEC=0.5
RUN_LIVE_VOXTRAL_TESTS=0
LIVE_VOXTRAL_RUNTIME_URL=http://localhost:8090
RUN_VOICE_DOCKER_SMOKE=0

# Optional ordinary-media SFU. Disabled by default; enabling the Compose
# profile alone does not enable Hub admission.
ANANTA_SEMANTIC_MEDIA_SFU_ENABLED=false
ANANTA_SEMANTIC_MEDIA_SFU_URL=http://127.0.0.1:7880
ANANTA_SEMANTIC_MEDIA_SFU_PUBLIC_WS_URL=ws://127.0.0.1:7880
ANANTA_SEMANTIC_MEDIA_SFU_API_KEY=
ANANTA_SEMANTIC_MEDIA_SFU_API_SECRET=
ANANTA_SEMANTIC_MEDIA_SFU_HTTP_PORT=7880
ANANTA_SEMANTIC_MEDIA_SFU_TCP_PORT=7881
ANANTA_SEMANTIC_MEDIA_SFU_UDP_PORT=7882
ANANTA_SEMANTIC_MEDIA_SFU_TURN_UDP_PORT=3478
ANANTA_SEMANTIC_MEDIA_SFU_CPU_LIMIT=2.0
ANANTA_SEMANTIC_MEDIA_SFU_MEMORY_LIMIT=1G
ANANTA_SEMANTIC_MEDIA_SFU_TOKEN_TTL_SECONDS=45
# Hub-only SFU projection signing. Production requires exactly one private-key
# source (base64url secret, mode-0600 file, or the KMS extension port) and a
# separately pinned public keyset. Never place either private-key value in a
# frontend asset or in __ANANTA_SFU_PROJECTION_TRUSTED_KEYS__.
ANANTA_SFU_PROJECTION_SIGNING_MODE=ed25519
ANANTA_SFU_PROJECTION_SIGNING_KEY_ID=
ANANTA_SFU_PROJECTION_SIGNING_KEY_VERSION=
ANANTA_SFU_PROJECTION_ED25519_PRIVATE_KEY_B64URL=
ANANTA_SFU_PROJECTION_ED25519_PRIVATE_KEY_FILE=
ANANTA_SFU_PROJECTION_TRUSTED_KEYSET_JSON=
ANANTA_SFU_PROJECTION_TRUSTED_KEYSET_FILE=
ANANTA_SFU_PROJECTION_ALLOW_LEGACY_HMAC=false
# Distributed broadcast runtime remains fail-closed until operator-owned
# credentials, certificates and source-grounded runtime evidence are present.
ANANTA_SFU_BACKGROUND_CONFIG=config/sfu_broadcast_background.default.json
ANANTA_SFU_LIVEKIT_API_KEY=
ANANTA_SFU_LIVEKIT_API_SECRET=
ANANTA_SFU_LIVEKIT_NATIVE_CONFIG_FILE=./config/livekit.sfu-broadcast-native.yaml
ANANTA_SFU_REDIS_TLS_DIR=./config/redis/sfu-broadcast-tls
ANANTA_SFU_TPM_DEVICE_A=/dev/tpmrm0
ANANTA_SFU_TPM_DEVICE_B=/dev/tpmrm0
ANANTA_SFU_TPM2_KEY_HANDLE_A=0x81000001
ANANTA_SFU_TPM2_KEY_HANDLE_B=0x81000002
ANANTA_SFU_RUNTIME_A_SERVER_CERT_FILE=./config/sfu-runtime-agent/a/server.crt
ANANTA_SFU_RUNTIME_A_SERVER_KEY_FILE=./config/sfu-runtime-agent/a/server.key
ANANTA_SFU_RUNTIME_B_SERVER_CERT_FILE=./config/sfu-runtime-agent/b/server.crt
ANANTA_SFU_RUNTIME_B_SERVER_KEY_FILE=./config/sfu-runtime-agent/b/server.key
# Local release-gate relay only; not a production credential surface.
ANANTA_SEMANTIC_MEDIA_TURN_GATE_PORT=3479
ANANTA_SEMANTIC_MEDIA_TURN_GATE_USER=ananta-turn-gate
ANANTA_SEMANTIC_MEDIA_TURN_GATE_PASSWORD=ananta-turn-gate-fixture-32-bytes

# Voice runtime defaults
VOICE_PROVIDER=voice-runtime
VOICE_RUNTIME_URL=http://voice-runtime:8090
VOICE_RUNTIME_ALLOWED_ORIGINS=http://voice-runtime:8090
VOICE_RUNTIME_MAX_RESPONSE_BYTES=16777216
ANANTA_RESTRICTED_INFERENCE_URL=http://restricted-inference-worker:8091/internal/v1/restricted-inference
ANANTA_RESTRICTED_INFERENCE_ALLOWED_ENDPOINTS=http://restricted-inference-worker:8091/internal/v1/restricted-inference
# Required by the restricted Compose profiles: distinct random secret, >=24 characters.
RESTRICTED_INFERENCE_INTERNAL_TOKEN=
VOICE_MODEL=voxtral
VOICE_FALLBACK_MODEL=whisper-small
VOICE_MAX_AUDIO_MB=25
VOICE_MAX_AUDIO_DURATION_SEC=3600
VOICE_HUB_MAX_CONCURRENT_REQUESTS=2
VOICE_HUB_MAX_INFLIGHT_AUDIO_SECONDS=7200
VOICE_MAX_QUEUE_DEPTH=16
VOICE_TIMEOUT_SEC=120
# Total cap for a live stream, including capture and finalization/correction.
# Keep this at least as high as the Hub's maximum live-stream deadline (300s by default).
VOICE_STREAM_TIMEOUT_SEC=300
VOICE_DIRECT_CLIENT_ACCESS=false
# Hub-only Fernet key for encrypted Voice reviews/personalization/results.
# Generate out of band; never reuse SECRET_KEY or either runtime service token.
VOICE_PERSONALIZATION_ENCRYPTION_KEY=replace_with_a_urlsafe_base64_fernet_key
# Append-only pseudonymous deletion ledger. Keep this file outside database
# restore snapshots and back it up as a separate privacy-control artifact.
VOICE_DELETION_LEDGER_PATH=/app/data/voice-deletion-ledger.v1.jsonl
# Each immutable segment is bounded; exhaustion rejects new deletion claims
# fail-closed instead of accepting an unrecorded privacy operation.
VOICE_DELETION_LEDGER_SEGMENT_RECORDS=10000
VOICE_DELETION_LEDGER_MAX_RECORDS=1000000
VOICE_RUNTIME_DEVICE=auto
VOICE_RUNTIME_MODEL_PATH=
VOICE_BACKEND_FALLBACK_ORDER=voxtral,mock
# CPU Compose profile defaults. Override them as shown in
# docs/voice-quickstart.md to run the lightweight Vosk-only path.
VOICE_CPU_BACKEND_FALLBACK_ORDER=vosk,whisper_cpp
VOICE_CPU_CALIBRATION_PATH=/models/voice/calibration/calibration.json
# Optional CPU-local adapters. Artifacts must already exist below VOICE_MODEL_DIR
# and be covered by the immutable Voice model catalog; no runtime downloads occur.
VOICE_CPU_FASTER_WHISPER_MODEL_PATH=/models/voice/faster-whisper
VOICE_CPU_FASTER_WHISPER_COMPUTE_TYPE=int8
VOICE_CPU_VOXTRAL_MODEL_PATH=
VOICE_CPU_VOXTRAL_RUNNER_PATH=
VOICE_CPU_VOXTRAL_RUNNER_STYLE=realtime
VOICE_CPU_FUSION_ENABLED=true
VOICE_CPU_POLICY_ALLOWED_BACKENDS=vosk,whisper_cpp
VOICE_CPU_POLICY_ALLOWED_RECOGNITION_STRATEGIES=single,parallel_compare,classic_then_correct
VOICE_CPU_RECOGNITION_STRATEGY=parallel_fusion
VOICE_CPU_SECONDARY_BACKENDS=whisper_cpp
VOICE_CPU_RERUN_BACKEND=whisper_cpp
VOICE_ENABLE_STREAMING=false
VOICE_STORE_AUDIO=false
VOICE_IDEMPOTENCY_TTL_SECONDS=86400
# Optional isolated generative-judge worker. The token must be supplied through
# deployment secrets; leaving it empty keeps the capability unavailable.
VOICE_GENERATIVE_JUDGE_WORKER_URL=http://generative-judge-worker:8092/internal/v1/generative-judge
VOICE_GENERATIVE_JUDGE_WORKER_ALLOWED_ENDPOINTS=http://generative-judge-worker:8092/internal/v1/generative-judge
VOICE_GENERATIVE_JUDGE_WORKER_TOKEN=
VOICE_GENERATIVE_JUDGE_HUB_ORIGIN=http://ai-agent-hub:5000
VOICE_GENERATIVE_JUDGE_TIMEOUT_MS=2000
VOICE_GENERATIVE_JUDGE_MAX_RESPONSE_BYTES=65536
GENERATIVE_JUDGE_ENGINE=transformers
GENERATIVE_JUDGE_MODEL_DIR=../../models/generative-judge
# Optional isolated generative transcript-corrector worker. Keep its token
# distinct from Voice Runtime, restricted-inference, and judge credentials.
# Leaving the token empty makes every advertised correction model unavailable.
VOICE_GENERATIVE_CORRECTOR_WORKER_URL=http://generative-corrector-worker:8093/internal/v1/voice-corrector
VOICE_GENERATIVE_CORRECTOR_WORKER_ALLOWED_ENDPOINTS=http://generative-corrector-worker:8093/internal/v1/voice-corrector
VOICE_GENERATIVE_CORRECTOR_WORKER_TOKEN=
VOICE_GENERATIVE_CORRECTOR_HUB_ORIGIN=http://ai-agent-hub:5000
VOICE_GENERATIVE_CORRECTOR_TIMEOUT_MS=30000
VOICE_GENERATIVE_CORRECTOR_MAX_RESPONSE_BYTES=262144
# These IDs must also exist in the worker's read-only model catalog.
VOICE_GENERATIVE_CORRECTOR_MODELS=gemma-2b-it,phi-3-mini-instruct
# Provider IDs are centrally allowlisted. The worker reuses the static
# OLLAMA_URL / LMSTUDIO_URL settings above; Voice clients never receive them.
VOICE_GENERATIVE_CORRECTOR_PROVIDERS=embedded,lmstudio,ollama
GENERATIVE_CORRECTOR_ENGINE=hybrid
GENERATIVE_CORRECTOR_PROVIDER_DISCOVERY_TIMEOUT_MS=200
GENERATIVE_CORRECTOR_PROVIDER_MAX_RESPONSE_BYTES=1048576
GENERATIVE_CORRECTOR_MODEL_DIR=../../models/generative-corrector
GENERATIVE_CORRECTOR_MAX_IN_FLIGHT=1
GENERATIVE_CORRECTOR_MAX_INPUT_CHARS=32000
GENERATIVE_CORRECTOR_MAX_INPUT_TOKENS=4096
GENERATIVE_CORRECTOR_MAX_NEW_TOKENS=1024
VOICE_TRANSCRIPTION_PIPELINE=simple
VOICE_VAD_BACKEND=mock
VOICE_SILERO_VAD_MODEL_PATH=
VOICE_SILERO_VAD_THRESHOLD=0.5
VOICE_ASR_BACKEND=mock
VOICE_POSTPROCESS_BACKEND=none
VOICE_CONFIDENCE_RERUN_ENABLED=false
VOICE_CONFIDENCE_THRESHOLD=0.7
VOICE_RERUN_BACKEND=mock
VOICE_RERUN_MAX_SEGMENTS=3
VOICE_RERUN_MAX_AUDIO_MS=30000
VOICE_DIARIZATION_BACKEND=none
VOICE_GLOSSARY_PATH=
VOICE_VOSK_MODEL_PATH=
VOICE_WHISPER_CPP_BIN=
VOICE_WHISPER_CPP_MODEL_PATH=
VOICE_WHISPER_CPP_EXTRA_ARGS=
# Typed local backend tuning (arbitrary extra args stay forbidden in production)
VOICE_WHISPER_CPP_THREADS=4
VOICE_WHISPER_CPP_GPU_LAYERS=0
# whisper.cpp v1.8 uses an explicit GPU switch. GPU_LAYERS remains a
# deprecated compatibility alias where any positive value means enabled when
