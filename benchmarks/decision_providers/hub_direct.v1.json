    "instructions": "Decide whether the hub can answer this task prompt directly with exactly one read-only tool without starting a worker LLM, and which tool.",
    "options": {
      "git.status": "Show the git status of the workspace.",
      "git.diff_readonly": "Show the git diff, optionally restricted to one file path.",
      "workspace.diff": "Show the workspace diff (explicitly the workspace, not a git diff of a file).",
      "test.discover": "List or discover which tests exist in the workspace.",
      "repo.list_files": "List the files in the workspace/repository, optionally within a directory or glob.",
      "repo.read_file_range": "Read or show the content of one named file path, optionally a line range.",
      "repo.grep": "Search the repository text for a single literal pattern, optionally within a path glob.",
      "not_eligible": "Anything else: write or mutating actions, multi-step requests, analysis or explanation that needs an LLM, ambiguous requests, unsafe input (shell metacharacters), or prompts over 240 characters; the worker/LLM path handles it."
    }
